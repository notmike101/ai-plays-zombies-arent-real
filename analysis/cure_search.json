SCII","termination":"present_or_not_required","byte_length":33}},{"address":"0x14052aa7f","value":"cure_tick","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":13}},{"address":"0x14052cd56","value":"hud.cure_cast_one","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":18}},{"address":"0x14052cd78","value":"hud.cure_cast","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":16}},{"address":"0x14052ea30","value":"# The order the battle abilities are listed in when a BATTLE card on the loadout screen is\r\n# opened (src/battleorder.odin; *Loadout* in docs/gameplay.md). The unlocked ones are listed\r\n# first in this order, then the locked ones in this order.\r\n#\r\n# One ability per line, by the name the game knows it by: Police (paratroopers), Bomber\r\n# (airstrike), Heli, Stungas (gas bomb), Firebomb, CallArms, APC, Rally, Bus, Missile,\r\n# Medevac, Dozer, Tank, Cure, Nuke, Demolition, SeekDestroy, Cluster (cluster bomb).\r\n# Reorder freely: it changes only the list, never a save. Abilities not listed here follow,\r\n# in the game's own order; each build appends them to the end of this file\r\n# (tools/order-fill.sh), to be moved. Read again each time a card's list is opened.\r\nPolice\r\nBomber\r\nHeli\r\nStungas\r\nFirebomb\r\nCallArms\r\nAPC\r\nDemolition\r\nRally\r\nSeekDestroy\r\nBus\r\nMissile\r\nMedevac\r\nDozer\r\nCluster\r\nTank\r\nAC130\r\nCure\r\nNuke\r\n","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":919}},{"address":"0x14053cc48","value":"lod_mark_cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":16}},{"address":"0x14053fb48","value":"cure_unit","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":12}},{"address":"0x1405410b0","value":"loadout.item.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":18}},{"address":"0x14054a290","value":"loadout.desc.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":18}},{"address":"0x14054b8d8","value":"cure_update","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":12}},{"address":"0x140550128","value":"replay.name.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":17}},{"address":"0x1405547a8","value":"endscreen.item.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":20}},{"address":"0x140555ce0","value":"# Zombies Aren't Real -- the unlock order (src/unlock.odin; *Unlocks* in docs/gameplay.md).\r\n#\r\n# A new player starts with only what [start] lists. Every scenario won for the first time,\r\n# and every [rules] breach_restarts_per_unlock RETRYs of a battle in which a safe-zone wall\r\n# broke, unlocks the next entry of [order] the player doesn't have yet -- with a popup that\r\n# names it. Reorder, add or remove lines freely: the player's save lists what they have by\r\n# name, so a change here never takes an unlock away, it only changes what comes next.\r\n#\r\n# One entry per line: a kind, then the name the game knows it by.\r\n#   unit <Tool>       a planning placement. Garrison, Sniper, Mortar, Nest (the Turret),\r\n#                     Mine, C4, Battleship, GasMortar, FireMortar, Railgun,\r\n#                     Howitzer, MLRS, ChemMine, Spikes, Oil, Napalm\r\n#   ability <Item>    a battle deployable bought with SP. Police (paratroopers), Bomber\r\n#                     (airstrike), Heli, Stungas (gas bomb), Firebomb, CallArms, APC, Rally,\r\n#                     Bus, Missile, Medevac, Dozer, Tank, Cure, Nuke, Demolition, SeekDestroy,\r\n#                     Cluster (cluster bomb), AC130 (the AC-130 gunship)\r\n#   upgrade <Upgrade> a tower's own SP upgrade (Garrison_Rate, Sniper_Range, Ship_Blast ...)\r\n#\r\n# A tower's upgrade waits until its unit is unlocked (Sniper_Range comes after Sniper,\r\n# wherever it is listed). Anything this build leaves out (the playtest's cut units) is\r\n# skipped. Anything listed in neither section still unlocks: after everything listed here,\r\n# in the game's own order (units, then abilities, then upgrades) -- and each build appends\r\n# such entries to the end of this file in that order (tools/order-fill.sh), to be moved.\r\n\r\n[rules]\r\nbreach_restarts_per_unlock = 2 # RETRYs after a breached wall that earn one unlock\r\n\r\n[start]\r\nunit Garrison\r\nability Police\r\n\r\n[order]\r\nunit Mortar\r\nability Bomber\r\nunit Sniper\r\nupgrade Garrison_Rate\r\nability Heli\r\nunit Nest\r\nability Stungas\r\nunit Mine\r\nupgrade Sniper_Range\r\nability Firebomb\r\nupgrade Mortar_Blast\r\nupgrade Turret_Rate\r\nunit C4\r\nability CallArms\r\nupgrade Garrison_Magazine\r\nunit GasMortar\r\nupgrade Sniper_Rate\r\nability APC\r\nunit Battleship\r\nupgrade Turret_Range\r\nunit FireMortar\r\nability Rally\r\nupgrade Garrison_Reload\r\nunit ChemMine\r\nability SeekDestroy\r\nability Demolition\r\nability Missile\r\nability Cluster\r\nability AC130\r\nupgrade Sniper_Magazine\r\nunit Spikes\r\nupgrade Mortar_Rate\r\nability Bus\r\nunit Howitzer\r\nability Dozer\r\nupgrade Turret_Magazine\r\nunit Oil\r\nupgrade Garrison_Reach\r\nunit Railgun\r\nupgrade Sniper_Reload\r\nunit Napalm\r\nability Tank\r\nupgrade Turret_Reload\r\nunit MLRS\r\nupgrade Ship_Reload\r\nupgrade Ship_Blast\r\nability Cure\r\nability Medevac\r\nability Nuke\r\n","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":2759}},{"address":"0x140559d10","value":"hud.stats.unit.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":20}},{"address":"0x14055d618","value":"bar.btn.cure","string":{"encoding":"US-ASCII","termination":"present_or_not_required","byte_length":13}},{"address":"0x140564f40","value":"bar.tool.cure","string":{"encoding":"US-ASCII","term