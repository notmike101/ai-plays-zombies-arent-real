# Zombies Aren't Real configuration -- every tunable in the game lives here.
# Edit while the game is running: changes are picked up within ~0.5s, no restart.
# Colors are "R G B" or "R G B A", each component 0-255.
# balance.ini, beside this file, is read right after it: any key it lists WINS over the
# value here. It holds the balance levers for playtesting (wall cost, the money rate, the badge lines, the garrison's price and reach, the garrison's and Turret's fire rate and reload); each of those
# keys below is marked "balance.ini overrides this". Delete a line there to use this one.
# A player's mods (SETTINGS > MODS, src/mods.odin) are read after both, and after a stage's
# own settings, and win over all of them. Any key here with a number, colour or true / false
# value is moddable unless src/modkeys/modkeys.odin denies it; its LIMITS hold some to a
# range. A new mod's starting file copies each key's comment from here, so keep the
# comments readable for players too.
#
# The blocks are grouped by what they are about: the rules of a stage, the safe zones, each
# planning placement and battle deployable (one block per unit, holding its price or SP
# cost, its stats and its upgrades), the people, the world, the map data, then how things
# are drawn and heard, and last the engine and developer switches.

# ======================================================================================
# RULES OF A STAGE -- the money, the badges, the outbreak, how a battle ends, the upgrade rules
# ======================================================================================

[economy]
# There is NO money during the battle. The money a stage grants buys placements while
# planning (each placement's price is the `cost` key in its own block, the walls' per cell
# in [walls]; a unit's `cost_increase` makes each one of it already on the board add that
# much to the next one's price -- at 5, mortars cost 75, 80, 85 ... -- and deleting one gives
# back the dearest of those steps, so the next costs that again); READY (Space) begins the outbreak, which deploys only what the loadout's
# skill points bought (each battle deployable's `sp_cost` / `max`), which have no money
# price: the end-of-scenario stats value them in the SP spent on them. Unspent money is never
# lost: RETRY returns to planning with the money at READY, and a won campaign stage adds
# that same money on top of the next stage's grant, plus unspent_bonus_percent of it as a
# savings bonus (paid once, when the next stage is entered).
# THE GRANT FOLLOWS THE CROWD AND LEVELS OFF: a stage's money follows its CIVILIANS -- the
# crowd its buildings seed, counted when the stage installs, up to civilian.max_count -- so
# any boundary drawn on any map is funded with no per-stage tuning. Every stage, first or
# later, is paid money_base + money_grant_max x C / (C + money_half_civilians). A small
# stage is a PLACEMENT game: each civilian adds about money_grant_max / money_half_civilians
# (0.40 at 6000 / 15000), enough for a few safe zones and the guns that hold them. A big one
# is a COMMANDER's game, won with the battle abilities the skill points buy ([skill_points]):
# past the half crowd each civilian adds less and less, and the grant levels off at
# money_base + money_grant_max -- enough to widen a carried zone or add a section, never to
# wall and gun a giant one. A campaign's stages nest, so no stage pays less than the one
# before it, and the rise from one to the next shrinks until it is flat. (New York's
# campaign: $1,894 on stage 1, $2,694 / $5,250 / $6,292 on stages 2-4, then $6,434 rising
# to $6,825 a stage; $63,104 in all by stage 11. tools/balancedump prints every campaign's.)
# All hot-reload. An edit to any money key reaches the money a stage already granted at
# once (planning's balance, and the balance a RETRY restores); a campaign picked back up
# from the menu keeps the money it was saved with.
money_base          = 1000.0   # STAGE BUDGET FLOOR: the flat part of every stage's grant, whatever its crowd -- balance.ini overrides this
money_grant_max     = 6000.0   # STAGE BUDGET FROM THE CROWD: the most the crowd adds on top of money_base; a stage of C civilians gets money_grant_max x C / (C + money_half_civilians) -- balance.ini overrides this
money_half_civilians = 15000   # the crowd at which a stage gets half of money_grant_max on top of money_base (a smaller number levels the grant off on smaller stages) -- balance.ini overrides this
shift_start_civilians = 20000  # THE SHIFT starts: the crowd where a stage starts turning from the placement game (money) to the commander's (skill points); where [skill_points] per_root_10k_commander takes over
shift_end_civilians = 80000    # THE SHIFT ends: the crowd from which a stage counts as wholly the commander's game (the admin console's "stage size" share)
money_bonus_percent   = 0.0   # % more money every stage grants (money_base plus the crowd's share; 10 = 1.1x; negative = less, -100 = none); 0 = none. A mutator's lever (mutators/)
unspent_bonus_percent = 0.0   # SAVINGS BONUS: a won campaign stage's unspent money carries into the next stage with this % of it added on top ($1,000 unspent -> $1,300 carried; 0 = no bonus) -- balance.ini overrides this

[skill_points]
# SKILL POINTS (SP) buy the battle abilities on the LOADOUT screen (each ability's sp_cost:
# the first level puts it on the battle bar, each after makes it recharge faster). They grow
# with the stage's crowd the other way round from its money: few while the stage is a
# placement game, many once it is a commander's ([economy] shift_start_civilians). A stage
# whose buildings seed P civilians (before civilian.max_count thins them, so the biggest maps
# keep gaining) has base + per_root_10k x sqrt(min(P, shift start) / 10,000) +
# per_root_10k_commander x (sqrt(P / 10,000) - sqrt(shift start / 10,000)) SP, rounded, at
# least 1. The square root keeps a map of 90x the crowd from needing 90x the clicks. A
# campaign's later stage is a bigger crowd, so it never has fewer. (New York: 2, 2, 7, 20,
# 24 ... 76 SP over its 11 scenarios; Paris' first, 52,981 civilians: 10.) All hot-reload.
base                    = 1      # the flat part of every stage's SP
per_root_10k            = 1      # SP per square root of the crowd (in 10,000s) up to [economy] shift_start_civilians
per_root_10k_commander  = 9      # SP per square root of the crowd (in 10,000s) past [economy] shift_start_civilians
bonus_percent           = 0.0    # % more SP every stage grants, applied before rounding (25 = 1.25x; negative = fewer, at least 1); 0 = none. A mutator's lever (mutators/)
level_recharge_percent  = 25     # each loadout level of a battle ability that recharges (cooldown_seconds above 0) past the first makes it recharge this % of its level-1 rate faster (level 3: 1.5x as fast, its cooldown_seconds / 1.5); not the paratroopers, whose levels add a squad each instead

[badges]
# A cleared stage (every zombie dead) earns a BADGE for the % of the starting civilians
# still alive: bronze_percent / silver_percent / gold_percent / diamond_percent /
# sapphire_percent / emerald_percent / ruby_percent are each tier's line (each 0..100, meant
# to rise in that order; a tier needs its own line and every line below it). Sapphire,
# emerald and ruby are secret: the end screen's SAVED meter shows their lines only once the
# player has earned that tier on that scenario. Bronze or better is a win: a horde
# wiped out with fewer alive than the bronze line is a loss, and while fewer are alive the
# run can no longer be won (the RESTART button pulses red); it is lost outright once every
# civilian is dead. READY warns while the safe zones hold less than its share. (At 0, ANY
# horde wiped out is a win.) Badges are remembered per scenario in progress/<campaign>.progress.
# EVERY LINE BUT BRONZE RISES ON LATER CAMPAIGN STAGES (<tier>_percent_per_stage, up to
# <tier>_percent_max): a later stage is a bigger crowd, and a bigger safe zone there
# leaves so few zombies outside it that it shelters far more than 25%. tools/unitbench, a
# stage's whole money spent on a round zone and Turrets: stage 1 reaches 29-31% alive at
# best, stage 2 26-27%, stage 3 about 45% (64% on a lucky outbreak), stage 4 about 38% --
# so New York's diamond lines 25 / 29 / 33 / 37 / 41 / 45% sit at or just past what that
# plain plan reaches, for a player to beat with skill points, carried placements and
# better-shaped zones. Silver, gold, sapphire, emerald and ruby keep the ratio they have to
# diamond on stage 1 (about 0.33x, 0.67x, 1.2x, 1.4x and 1.6x). A risen line is rounded to the nearest whole percent, the number the
# screens show, so 17% alive meets a "17%" line: silver 8 / 9 / 11 / 12 / 13 / 15%, gold
# 17 / 20 / 22 / 25 / 28 / 30%, sapphire 30 / 35 / 40 / 44 / 49 / 54%, emerald 35 / 41 / 46 /
# 52 / 57 / 63%, ruby 40 / 46 / 53 / 59 / 66 / 72%.
# Bronze, the win line, stays put on every stage. A standalone map or scenario is stage 1.
# All hot-reload.
bronze_percent      = 4.0     # % of starting civilians alive at the end for a BRONZE badge: the win line (a horde cleared with fewer alive is a loss), and the share READY warns about when the safe zones shelter less -- balance.ini overrides this
silver_percent      = 8.0     # % alive for a SILVER badge -- balance.ini overrides this
gold_percent        = 17.0     # % alive for a GOLD badge -- balance.ini overrides this
diamond_percent     = 25.0     # % alive for a DIAMOND badge -- balance.ini overrides this
sapphire_percent    = 30.0     # % alive for a SAPPHIRE badge -- balance.ini overrides this
emerald_percent     = 35.0     # % alive for an EMERALD badge -- balance.ini overrides this
ruby_percent        = 40.0     # % alive for a RUBY badge, the top tier (its sub-ranks count up from here) -- balance.ini overrides this
silver_percent_per_stage = 1.3 # percentage points the SILVER line rises with each campaign stage after the first (stage k: silver_percent + this x (k - 1), up to silver_percent_max); 0 = the same line on every stage -- balance.ini overrides this
silver_percent_max  = 15.0     # the highest the SILVER line rises to on a later campaign stage (% alive) -- balance.ini overrides this
gold_percent_per_stage = 2.7   # percentage points the GOLD line rises with each campaign stage after the first (stage k: gold_percent + this x (k - 1), up to gold_percent_max); 0 = the same line on every stage -- balance.ini overrides this
gold_percent_max    = 30.0     # the highest the GOLD line rises to on a later campaign stage (% alive) -- balance.ini overrides this
diamond_percent_per_stage = 4.0 # percentage points the DIAMOND line rises with each campaign stage after the first (stage k: diamond_percent + this x (k - 1), up to diamond_percent_max; a standalone map is stage 1); 0 = the same line on every stage -- balance.ini overrides this
diamond_percent_max = 45.0     # the highest the DIAMOND line rises to on a later campaign stage (% alive) -- balance.ini overrides this
sapphire_percent_per_stage = 4.8 # percentage points the SAPPHIRE line rises with each campaign stage after the first (stage k: sapphire_percent + this x (k - 1), up to sapphire_percent_max); 0 = the same line on every stage -- balance.ini overrides this
sapphire_percent_max = 54.0     # the highest the SAPPHIRE line rises to on a later campaign stage (% alive) -- balance.ini overrides this
emerald_percent_per_stage = 5.6 # percentage points the EMERALD line rises with each campaign stage after the first (stage k: emerald_percent + this x (k - 1), up to emerald_percent_max); 0 = the same line on every stage -- balance.ini overrides this
emerald_percent_max = 63.0     # the highest the EMERALD line rises to on a later campaign stage (% alive) -- balance.ini overrides this
ruby_percent_per_stage = 6.4   # percentage points the RUBY line rises with each campaign stage after the first (stage k: ruby_percent + this x (k - 1), up to ruby_percent_max); 0 = the same line on every stage -- balance.ini overrides this
ruby_percent_max    = 72.0     # the highest the RUBY line rises to on a later campaign stage (% alive) -- balance.ini overrides this
ruby_substep_percent = 5.0     # percentage points of saved civilians per ruby sub-rank: 40 = RUBY, 45 = RUBY II, 50 = RUBY III, ...
secret_tier_civilians = 8000   # the tiers past diamond (sapphire, emerald, ruby) are only for big scenarios: awarded and shown on the SAVED meter only when the scenario starts with MORE civilians than this (before NORMAL's thinner crowd); at or under it diamond is the top tier. 0 = every scenario

[adaptive]
# The ADAPTIVE difficulty's hidden assist (src/assist.odin; FIXED never uses it). Its level,
# from -3 up to the level that reaches crowd_floor_percent, rises while the player is losing and falls while they win well. Above 0 the planning
# phase opens with a thinner crowd (crowd_step_percent) of the stage's seeded civilians (level 0
# keeps them all, the FIXED game); below 0 the outbreak starts bigger (outbreak_percent_<n>). Every building is thinned by the same share, so a
# safe zone holds the same share of the crowd and the badge lines mean the same; fewer
# civilians means fewer bites, so a smaller, slower horde. The level moves only between
# battles and the thinned crowd lands on the next board (a RETRY, the next stage), so a
# battle stays deterministic. All hot-reload (an edit applies from the next board).
# Measured with tools/unitbench --crowd on NYC stage 1 (a 10%-share zone and Turrets): at 100%
# about $650 of Turrets holds it, at 80% $600; the help levels off below that (at 40% $500
# still falls), and a held zone saves a larger share the thinner the crowd (~12% -> ~15%).
crowd_step_percent  = 25   # how much easier each help level makes the board, as a % of the full crowd's ease: level n keeps 100 / (1 + n x this / 100) % of the civilians (25: 80, 67, 57, 50, 44, 40 ... %), so every step helps by the same amount (1..1000)
crowd_floor_percent = 20   # % of the civilians the top help level keeps: the levels climb until the crowd reaches this, and it sets how many there are (25 and 20: up to level 16) (1..100)
losses          = 2      # losses in a row that raise the assist level one step (the streak then starts over; a win ends it)
ease_percent    = 15.0   # above level 0: a win saving at least this % of the starting civilians lowers the assist level one step (a win below it leaves the level alone)
# Doing really well makes it harder, the mirror of the above: at level 0 or below, `wins` wins
# in a row each saving at least harden_percent % lower the level one step (to -1, -2, -3), and
# one loss raises it one step back. At level -n every outbreak site READY lays starts with
# outbreak_percent_<n> % of its zombies (outbreak.zombies_per_spawn, or a scenario's own
# count): the horde gets a head start on the same crowd and the same money.
outbreak_percent_1 = 130  # % of each outbreak site's zombies at assist level -1 (100..1000)
outbreak_percent_2 = 165  # % at assist level -2
outbreak_percent_3 = 200  # % at assist level -3, the hardest
wins            = 2      # wins in a row at harden_percent that lower the assist level one step from 0 or below (a loss, or a win under the line, ends the streak)
harden_percent  = 20.0   # % of the starting civilians a win must save to count toward `wins`

[outbreak]
# The outbreak: no zombie exists during planning (the game opens paused; fence in safe
# zones and set up defenses, then press Space), and where it starts is hidden. READY
# rolls `spawns` outbreak sites -- each on a random civilian standing OUTSIDE every
# safe zone, so it always starts in the unprotected crowd -- and lays zombies_per_spawn
# zombies over each. Total starting zombies = sites * zombies_per_spawn. The sites are
# picked at READY, after the safe zones are drawn, and every READY -- a RETRY's included --
# rolls a new outbreak. All read at READY. (How the zombies themselves behave: [zombie].)
# spawns = 0 (the default) sizes the outbreak from the stage's LAND -- every square
# kilometer inside the play-area boundary that is not water -- so a stage needs nothing but its
# boundary: sites = spawns_at_1km2 x the fourth root of the land in km^2, rounded, at least
# 1 (16x the land = 2x the sites). The default fits the old hand-tuned New York campaign:
# 2 sites on its 1.2 km^2 first stage, 8 on its 159 km^2 tenth. A scenario / campaign stage
# can still pin a count with an [override] block (outbreak.spawns = 6).
spawns            = 0
spawns_at_1km2    = 2.15   # with spawns = 0: outbreak sites on a stage with 1 km^2 of land (a stage gets this x land_km2^(1/4))
zombies_per_spawn = 200
zombies_per_spawn_per_level = 40  # zombies each campaign level after the first adds to every outbreak site 
spawn_radius            = 0      # world units: the circle an outbreak site scatters its zombies over (never inside a safe zone); 0 = sized from the stage's land, like spawns (spawn_radius_at_1km2). A dev scenario's hand-written [spawns] radius overrides it
spawn_radius_at_1km2    = 105    # with spawn_radius = 0: the spawn radius (m) on a stage with 1 km^2 of land; a stage gets this x land_km2^(1/4) (109 m on New York's first stage, 373 m on its tenth)
spawn_separation        = 400.0  # world units: rolled outbreak sites are kept at least this far apart (relaxed when a stage is too small to fit them)
spawn_zone_gap          = 150.0  # world units: a rolled outbreak site is kept at least this far from every safe zone's edge (relaxed when the zones leave no room)
# Islands: no piece of the board the outbreak can't walk to is left without a site, so a
# RETRY on a changed plan can't roll an island clean. Land the bridges cut apart (a bridge
# can be sunk) is a landmass; land a wall cuts off (a zone's edge, a standalone wall, a gate)
# is a piece of it. A site no such need meets gives its place to one; when there are more
# needs than sites, sites are added and the same zombies shared out over them all.
island_min_percent      = 5      # percent of the stage's crowd (inside the zones too): a landmass the bridges cut off holding at least this many always gets an outbreak site; 0 = off
split_min_percent       = 1      # percent of the stage's crowd: a piece of land the walls cut off holding at least this many outside the zones always gets an outbreak site; 0 = off
# Each site's zombies are spread over its whole spawn circle rather than piled on one
# point, but denser in the middle: spawn_core_share of them land inside the inner core (a
# disc spawn_core_radius times the spawn radius), the rest in the ring outside it, evenly
# by area within each.
spawn_core_share        = 0.7    # share (0..1) of a spawn's zombies inside the inner core of its spawn circle
spawn_core_radius       = 0.5    # the core's radius as a fraction (0..1) of the spawn radius
# Edge spawning: with edge_spawn = true the outbreak never erupts inside the map -- no site
# above is rolled, and a dev scenario's [spawns] points are skipped too. The horde walks in
# from the edge instead (the stage's play-area boundary, or the whole map's on a stage
# without one), in edge_spawn_waves waves edge_spawn_interval in-game seconds apart, the
# first at READY. Each wave's zombies come in at edge_spawn_points random spots ON the edge
# (the cells beside the out of bounds, bridges included), on open ground outside the safe zones. The battle is won only once every wave has
# come and the horde is wiped. All hot-reload (a change to the interval applies to the next wave).
edge_spawn              = false  # true = zombies come only from the map's edges, in waves (no outbreak inside the map)
edge_spawn_zombies      = 250    # with edge_spawn: zombies each wave lays, shared over its spots (Adaptive's level scales it like a site's count)
edge_spawn_interval     = 20     # with edge_spawn: in-game seconds between waves
edge_spawn_waves        = 10     # with edge_spawn: how many waves come in a battle
edge_spawn_points       = 5      # with edge_spawn: spots along the edge each wave comes in at (1..64)
edge_spawn_radius       = 30     # with edge_spawn: world units along the edge each spot spreads its zombies over (they all stand on the edge)

[battle]
# Stalled-horde cleanup: ends a run whose horde is stuck somewhere it can't reach anyone.
# From READY on, the game counts the in-game seconds since a civilian was last bitten, a
# zombie last wore down a wall (chewing a wall is the horde still getting somewhere) or a
# zombie last died (your defenses are still fighting it). Once that reaches
# cleanup_quiet_seconds, a cleanup_seconds countdown starts, shown big at the top of the
# screen. A bite, a chewed wall or a zombie death cancels it and the quiet count starts
# over; if it runs out, every remaining zombie dies at once -- which clears the board and
# wins the stage (with at least the bronze share alive). Once the horde is down to
# stray_horde_percent (below) of its peak, a chewed wall no longer counts: a few strays
# chewing a wall far from any gun are a stalled horde too. Both hot-reload.
cleanup_quiet_seconds   = 10     # in-game seconds with no bite, no chewed wall and no zombie death before the countdown starts (0 = off)
cleanup_seconds         = 30     # the countdown's length in in-game seconds
# Stray horde: zombies treat a safe zone's walls as ground they can chew through to the
# civilians behind, so a few strays left late in a battle can spend minutes chewing on the
# walls of a zone nobody is left in -- or, stuck inside one the horde overran, on a whole
# wall instead of walking out through the breach. Once the zombies alive are down to
# stray_horde_percent of the most that were alive at once this battle, the walls of every
# safe zone with no civilian left inside (breached or not) go solid to the horde: it walks
# round them, or out through the breach, and never chews them; a zone that empties later
# goes solid when it does. A wall between such a zone and one still holding civilians stays
# a wall the horde chews. From then on a chewed wall also stops holding off the stalled-horde
# countdown (above). Hot-reloads.
stray_horde_percent     = 10     # % of the battle's peak zombie count at or under which empty zones' walls go solid (0 = off)

[tips]
# Restart tips (src/tips.odin): a RETRY after a run in which a wall broke opens planning with
# a DEBRIEF card of up to three tips on what let the first breach happen; a RETRY with no
# breach can still show one general tip. A battle left at 1x (real time) or 1/2x shows one line naming the
# faster speeds' keys. The player turns all of it off with Settings > GAMEPLAY > Restart tips. These
# are the thresholds the tips test; all hot-reload.
crowd_radius             = 40.0   # world meters around the first breach the zombies are counted in (the "try a mortar" tip reads it)
crowd_min                = 30     # zombies within crowd_radius of the first breach that make the "try a mortar" tip fit
wall_share_percent       = 40.0   # % of the money (the board's value plus what is left) the zone outlines and fortifying take before "zone too big" fires
shelter_margin_percent   = 10.0   # points over the bronze line the zones must have sheltered at READY for "zone too big" (bronze 10% -> 20% or more)
unspent_money_min        = 100.0  # money left at READY that counts as unspent after a loss ...
unspent_money_percent    = 10.0   # ... or this % of the stage's money, whichever is more
sniper_roof_min          = 20.0   # meters: the shortest roof inside a zone the "try a sniper" tip suggests
garrison_width_min       = 20.0   # meters: the narrowest building inside a zone the "try a garrison" tip suggests
small_zone_percent       = 20.0   # % of the civilians the zones sheltered at READY below which a breach run gets the "save more civilians" tip (and "add a gate" when the board has none)
horde_percent            = 50.0   # zombies still alive when the first wall broke, as a % of the civilians and zombies on the map at READY, at or above which the "try explosives" tip (mortar, mine, C4) shows
general_max_shows        = 3      # times each general tip (try other units, battle abilities, the speed nudge) and the special buildings tip shows before it stops for good
zone_big_lead_shows      = 3      # times the "zone too big" tip (walls ate the money while the zone holds far more civilians than needed) leads the card -- first, in blue, under a headline -- before it takes its usual place after the cover and wall tips; 0 = never leads
speed_nudge_seconds      = 60.0   # real seconds of a battle at 1x (real time) or 1/2x in a row before the speed nudge shows (never again once 2x or 4x is used)
speed_nudge_show_seconds = 8.0    # real seconds the speed nudge stays on screen
show_glow_seconds        = 2.0    # real seconds the spot a tip is about glows after its SHOW button is clicked
show_glow_radius         = 30.0   # world meters: the radius of that glow (kept between 48 screen pixels and 30% of the screen height, so it shows at any zoom)

[upgrades]
# Skill points (SP) buy LEVELS of upgrades. A tower -- a garrison, sniper, mortar, Turret or
# battleship -- has its OWN levels, bought for that one tower from its stats panel in
# planning (select it, SP UPGRADES): they go with the tower (RETRY, the campaign carry,
# Ctrl+Z) and refunding it frees their SP, so each level is worth far more than a share
# spread over every tower would be. Each upgrade's own keys are in its unit's block:
# upgrade_<stat>_percent and upgrade_<stat>_cost (garrison.upgrade_rate_percent,
# garrison.upgrade_rate_cost ...). A level adds
# its _percent to that unit's own stat (config.ini's value for it): a range, reach,
# blast radius or magazine grows by it, a fire rate or reload speed goes up by it (so the
# time between shots / a reload's seconds is divided by 1 + the total). Levels add up: 3
# levels of 60% is +180%. An upgrade's first level costs its _cost SP and every level after
# costs cost_growth times the one before, rounded (never less than the level before), so at
# 1.5 a 1 SP upgrade's levels cost 1, 2, 2, 3, 5 SP. A tower's levels are kept with the plan
# (per map in plans/<map>.prep, carried through a campaign).
# All hot-reload.
max_level   = 5      # highest level of every upgrade
cost_growth = 1.5    # each level costs this many times the one before (1 = every level the same)
hide_unit_upgrades = true # on for now: the tower upgrades are not ready, set false to bring them back. true: no tower (garrison, sniper, mortar, Turret, battleship) has SP Upgrades -- its stats panel shows no SP UPGRADES button, and the levels a plan already holds add nothing and cost no SP (they come back, and their SP is spent again, when this is false). Level Up (stacking) stays. Hot-reloads.

# ======================================================================================
# SAFE ZONES -- the lasso, its walls, the evac zones
# ======================================================================================

[safe_zone]
# The SAFE ZONE lasso (B during planning): click to drop corners, Enter (or a click on the
# first corner) closes the shape, Backspace takes back the last corner, Esc / right-click
# drops it. A wall goes up along every edge (the [walls] block below), and the zone is
# priced at walls.cost per 2 m of its edges' straight-line length -- walled or not, at
# any angle: the stretches over buildings, water and ground outside the play area are
# charged too, and a stretch another zone's edge already covers is paid once. Each zone
# also pays for its ground (the LAND PRICE, below). The inside
# is a safe zone: no outbreak zombie is laid
# in it, and READY warns before starting while the zones hold less than the bronze badge's
# share of the civilians (badges.bronze_percent). The inside is
# tinted with a soft blue (colors.safe_zone_stripe) under the buildings and the crowd -- laid
# as diagonal stripes, solid while stripe_gap is 0 -- leaving water (bridges included) and
# anything outside the play area bare, and every edge glows (colors.safe_zone_glow, the
# glow_* keys below): a bright line with a glow fading into the zone and a halo out of it.
# Overlapping zones cut the safe area into regions (the overlap is one, each zone's own part
# another); once a wall around a region is breached in the battle, that region's tint and
# the glow along its edges turn red (colors.safe_zone_breached) until the next planning
# phase -- an overlap stays blue while its own walls hold. All hot-reload.
stripe_width            = 40.0   # world units: how thick one stripe of the tint is, measured across it (0 = no tint)
stripe_gap              = 0.0    # world units: the bare gap between two stripes, measured across (0 = a solid tint; 12 with stripe_width 12 = the old yellow-stripe look)
corner_grab_m           = 5.0    # world meters: zoomed in far, a placed zone's corner can be grabbed (dragged / right-click deleted) from this far off its wall post, and its ring is drawn that big -- 5 m = 40 px at camera.zoom_max 8, 20 px at zoom 4. Zoomed out the reach is a fixed 10 px, and it only starts growing once this many meters are more than that (past zoom 2 here)
corner_grab_max_px      = 40.0   # screen pixels: the largest a corner's grab reach and ring ever get, however far zoomed in; 0 = no cap
alt_stripe_opacity      = 0.22   # opacity, 0-1, of every zone's tint (blue and breached red alike) while the CLASSES view is held (Shift+C): with every zone outlined solid and every unit's range shown, the plan's cover reads at a glance
glow_core_width         = 3.0    # world units: the bright line along each zone edge, measured across it (0 = none)
glow_core_opacity       = 1.0    # opacity, 0-1, of that line
glow_inner_width        = 30.0   # world units: how far the glow fades from the edge into the zone (0 = none)
glow_inner_opacity      = 0.6    # opacity, 0-1, of the inner glow at the edge (it fades to nothing at glow_inner_width)
glow_outer_width        = 12.0   # world units: how far the halo fades from the edge out of the zone (0 = none)
glow_outer_opacity      = 0.5    # opacity, 0-1, of the outer halo at the edge (it fades to nothing at glow_outer_width)
# HOW MANY, HOW MUCH LAND, AND THE LAND PRICE (src/zoneland.odin). The board holds at most
# free_zones safe zones on a campaign's first level, free_zones_per_level more on each level
# after it (a standalone wall, K, is not one), plus perks.extra_safe_zones
# under the EXTRA SAFE ZONES perk. Zones that overlap or touch (share a wall, or meet at a
# corner) count as ONE against it, so at the limit a new zone can still be drawn against or
# across a placed one; a lasso that touches none is drawn red and can't be closed.
# On top of its walls, each SAFE AREA -- the zones that overlap, share a wall or come within
# land_merge_gap of each other, taken together -- pays land_cost x the square root of its land
# in square meters (not water, inside the play area or out of it -- the cap below counts only
# the land inside): a flat price, the same on every stage
# (a 200 x 200 m square of land pays 200 x land_cost, its walls 400 x walls.cost). All the zones together may cover at most
# max_land_percent of the stage's land on a stage of at most land_cap_small_km2 of land, down to
# max_land_percent_large on one of at least land_cap_large_km2 (between them the cap slides in a
# straight line on the square root of the land, the stage's width): past it every zone and the lasso turn red -- they can
# still be placed, moved and reshaped -- and READY is refused until they are cut back under it.
# Charged and refunded as the zones change, into debt if need be. All hot-reload.
free_zones              = 4      # safe zones the board may hold on a campaign's first level without the EXTRA SAFE ZONES perk; 0 = safe zones disabled on the map (the perk and free_zones_per_level add none, and the Safe Zone tool says so)
free_zones_per_level    = 1      # safe zones added to free_zones for each campaign level past the first (level 3 holds free_zones + 2; 0 = the same limit on every level)
start_fee               = 100.0  # money every new safe zone costs the moment it is placed, on top of its walls and its land (refunded with it; 0 = none)
land_cost               = 0.5    # money per meter of the square root of a safe area's land in m^2 (0 = the walls only): the smaller share of a zone's price, beside walls.cost
max_land_percent        = 30.0   # % of the stage's land all the safe zones together may cover on a small stage; past it READY is refused
max_land_percent_large  = 12.0   # the same % on a big stage (NYC stage 11, ~159 km^2 of land)
land_cap_small_km2      = 1.0    # km^2 of stage land at or under which the cap is max_land_percent
land_cap_large_km2      = 159.0  # km^2 of stage land at or over which the cap is max_land_percent_large (NYC stage 11's land)
land_merge_gap          = 10.0   # world meters: zones that come this close to each other are one safe area for the land price (0 = only zones that overlap or share a wall)
building_units_inside_only = false # true: a garrison, sniper, mortar (any kind) or Turret (any kind) may only be placed into a building inside a safe zone (its centre point inside a zone's walls, a zone with civilians or not); any other building is drawn red under the armed tool and a click on it is refused with ONLY INSIDE A SAFE ZONE. Units already on the board stay where they are if a zone is later moved or deleted, and a saved or carried-over plan is re-laid whole. false = any building in the play area. Hot-reloads
outside_price_multiplier = 1.2 # x the price of a garrison, sniper, mortar (any kind) or Turret (any kind) placed into a building outside every safe zone (its centre point outside every zone's walls) -- every level of it, and the UPGRADE tool's steps -- so 2 = twice the price (1 = no difference). Only matters where building_units_inside_only lets such a placement through. A unit's refund is its price where it stands now: deleting, moving or drawing a zone in planning that puts a held building outside (or inside) charges (or refunds) the difference at once, into debt if need be. The armed tool shows a building's own price when it differs from the bar's. Hot-reloads (an edit in planning reprices the units already placed without charging the difference)
outside_first_shot_seconds = 12.0 # seconds longer a garrison, sniper, mortar, Turret or battleship standing outside every safe zone (or in an empty one, as for its ammo) waits for its FIRST shot of a battle: READY starts every gun one fire_cooldown from firing, and one outside waits that cooldown plus this many seconds, then its block's first_shot_spread on top. The same wait for every gun, whatever its fire_cooldown. Only the first shot moves. 0 = no difference. Read at READY

[walls]
# Walls are laid by the safe-zone lasso ([safe_zone] above), one along every edge of a zone.
# An edge can run at any angle and has no length cap -- its price is `cost` per grid cell,
# so a bigger zone costs more. An edge that crosses a building (or water, or another wall)
# skips the cells it can't build on and lays a separate wall on each side of it: every
# unbroken stretch is its own wall, with its own health. Walls block movement; zombies pressing on
# them wear them down. Health is PER CELL: a zombie erodes only the cell it leans on, and
# when a cell hits 0 HP a small hole opens around it (breach_radius) while the rest of the
# wall stands -- so a long wall fails locally where the horde presses, not all at once.
# A wall placed during the live outbreak takes build_seconds to construct: it shows as a
# dim outline that blocks nothing, then turns into a solid wall once the timer runs out.
# Walls placed during the planning phase are instant. All hot-reload live.
# Every battle -- a RETRY, the next campaign stage -- starts each wall at its full health: hp
# for a level-1 wall, a fixed multiple of hp for a fortified one (FORTIFY, below). A wall never gains
# health on its own; only a Repair building (building_class.repair_*) heals what the horde
# took, back up to that full health. A wall is drawn thicker and darker the more it is
# fortified (width_level1 -> width_level5 at the top level, colors.wall -> colors.wall_full). With no tool
# armed, rest the cursor near a wall to see its health (its weakest part's), out of its full
# health; a stretch worn below weak_glow_below of its full health also glows (the weak_glow_*
# keys below).
cost                    = 0.75   # money per 2 m (one grid cell's width) of a safe zone's outline, straight-line length, walled or not (over water and buildings too) -- the bigger share of a zone's price: a 200 x 200 m square's walls are $500 to its land's $100 -- balance.ini overrides this
start_fee               = 25.0   # money every new standalone wall (Z) costs the moment it is laid, on top of its length at cost (refunded with it; 0 = none). A safe zone's own fee is safe_zone.start_fee
max_standalone_length   = 300.0  # world meters: the most standalone wall (the K tool) one board may hold on a campaign's level 1 (and in a single scenario), every standalone wall's straight-line length summed (safe-zone walls don't count); a wall drawn past it is cut at the cap; 0 = no cap
max_standalone_length_per_level = 100.0  # world meters: what each campaign level after the first adds to max_standalone_length (level 3: 300 + 2 x 100 = 500 m)
hp                      = 1200.0   # a level-1 wall's full health per part: every wall starts each battle here and never heals past it; fortified levels hold 3x / 6x / 12x / 24x (/ 48x / 96x up to max_level 7) this (derived, never keys of their own)
width_level1            = 1.0    # world meters: how thick a level-1 wall is drawn (one grid cell is 2 m)
width_level5            = 5.0    # world meters: how thick a wall at the TOP fortify level (max_level) is drawn (the levels between shade evenly; the key keeps its old name)
decay_per_zombie_second = 1.0    # HP a cell loses per second per adjacent zombie
# HORDE PRESSURE. Zombies keep a personal space (zombie.spacing), so only a single row of
# them can touch a wall, however big the horde behind it. So that a big horde still breaks a
# wall faster than a small one, the crowd behind the front row pushes it into the wall: a
# zombie leaning on a wall bites pressure_per_zombie_second HP a second harder for every
# other zombie within pressure_radius of it, counting at most pressure_max_zombies of them
# (on top of decay_per_zombie_second). At 3 m spacing a packed crowd puts ~40 zombies within
# 16 m of a front-row zombie, so it bites ~23 HP/s instead of 3. New York stage 2's 200 m
# zone (tools/clumpdump) fell at 3:30 with this off, 1:52 at 0.25, 1:22 at 0.5, 1:04 at 1
# (1:19 with the spacing off and no pressure). 0 = off. Hot-reloads.
pressure_per_zombie_second = 0.05 # extra HP/s a wall-leaning zombie bites per other zombie near it; 0 = off
pressure_radius         = 16.0   # world meters: zombies this close to a wall-leaning zombie push it
pressure_max_zombies    = 60     # the most pushing zombies one wall-leaning zombie counts
passive_decay           = 0.0    # HP a cell loses per second regardless of zombies (0 = only zombies break walls; raise for weathering)
breach_radius           = 3.0    # world-unit radius of the hole a failed cell opens (~3 zombie-widths across)
build_seconds           = 3.0    # construction time (sim seconds) for a wall placed during the live outbreak; 0 = instant
# RETRY drops a red marker flag on each spot the horde chewed through a wall in the run just
# ended, so you can see where to reinforce. To keep them readable: at most one flag per
# flag_merge_radius meters (a general area -- a long wall failing along its length gets a few
# spread-out flags, never a dense row), and each flag's opacity tells you WHEN that spot
# broke: the run's first breach is fully opaque, and breaches later in the run fade toward
# flag_min_alpha over flag_fade_seconds, so the solid flags mark where the wall first gave way.
flag_merge_radius       = 40.0   # world meters: no two broken-wall marker flags land closer than this
flag_fade_seconds       = 90.0   # sim seconds after the first breach at which a later breach's flag reaches flag_min_alpha
flag_min_alpha          = 0.25   # 0..1 opacity floor for the latest breaches' flags (0 = the last ones are invisible; the first is always fully opaque)
# WEAK-WALL GLOW. A wall's health shows on the map: wherever a stretch of wall has worn below
# weak_glow_below of its full health, a soft halo in colors.wall_weak_glow pulses over that
# stretch's weakest part (one glow per 10 cells of a long worn stretch), drawn over every
# building so it is never hidden. The more that part has worn past the line, the bigger and
# brighter the glow: from the _min radius / opacity just under the line to the _max at 0 HP.
# The radius is in screen pixels, so a glow reads the same at any zoom (never smaller than a
# cell). Once a safe zone is breached its walls glow no more: a bright red ring
# (colors.wall_breach_marker) circles each of that zone's first breach_markers_per_zone breaches
# instead -- a wall hole, or a levelled building on its edge -- for the rest of the battle.
# Drawing only; hot-reloads.
weak_glow_below         = 0.40   # 0..1 share of a wall's full health below which a worn stretch glows (0 = never)
weak_glow_radius_min_px = 14.0   # screen pixels: a glow's radius just under the line
weak_glow_radius_max_px = 34.0   # screen pixels: its radius as the part's health reaches 0
weak_glow_alpha_min     = 0.50   # 0..1 the glow's opacity at its middle just under the line
weak_glow_alpha_max     = 0.95   # 0..1 its opacity as the part's health reaches 0
weak_glow_pulse_seconds = 1.2    # real seconds per breath of the pulse (it keeps pulsing while paused); 0 = steady
weak_glow_pulse         = 0.35   # 0..1 how hard the pulse breathes: the radius swings this share (half either side), the opacity dips by it
breach_markers_per_zone = 3      # how many of a safe zone's breaches in a battle get a red circle; later ones get none (0 = no circles)
breach_marker_merge_radius = 25.0 # world meters: a hole this near a circled breach on the same zone is part of that breach, not a new one
breach_marker_radius_px = 30.0   # screen pixels: a breach circle's radius, zoomed in to breach_marker_min_zoom or closer (never smaller than one grid cell)
breach_marker_min_zoom  = 0.40   # camera zoom (pixels per world unit, as [camera] zoom_min) at and past which a breach circle stops growing on the ground: zoomed out farther, it shrinks with the map (its ring width stays); 0 = the same on-screen size at every zoom
breach_marker_width_px  = 2.0    # screen pixels: the thickness of its ring, at any zoom
# FORTIFY (planning F, or the selection panel's UPGRADE on a selected wall): steps one wall
# segment -- a safe zone's edge -- up a level (max_level levels). No level has a key of its own: a
# fortified wall's full health is hp times the game's fixed level multiple (sim.LEVEL_MULT,
# src/sim/units.odin): 3x at level 2, 6x at level 3, 12x at level 4, 24x at level 5, 48x at
# level 6, 96x at level 7. Its WHOLE price per 2 m of the edge is cost, plus
# upgrade_cost_multiplier of what that same multiple adds over level 1 (at 0.5, level 3 is
# 1 + (6 - 1) x 0.5 = 3.5x cost). So hp and cost are the one levers for every level (stepping
# up pays the difference; deleting the zone refunds it).
max_level               = 4      # the top fortify level a wall can reach, 1 to 7 (4 = 12x hp, 7 = 96x hp). A saved plan's walls above it play at it. Hot-reloads
upgrade_cost_multiplier = 0.9    # share of each fortify level's full price step that is charged: 1 = the level multiple's whole price (level 4 = 12x cost per 2 m), 0.9 = 90% of each step (level 4 = 10.9x), 0 = fortifying is free; refunds give back the same. Jordan's call: a multiplier on purpose

[gate]
# GATES (planning G, or the BUILD group's GATE button): a click on a safe zone's wall puts a
# gate in it there (select a gate and press X, or its stats panel's Refund, to take it out
# again, refunded). A wall holds civilians
# and officers too -- they cross it only at a gate: a civilian steps through a gate into the
# zone behind it (never out of the safe area), and a panicked one outside near a gate runs
# for it; an officer walks through one either way. To the horde a gate is wall: it holds
# them and they chew it down like the rest, with its own wall's health and no more. The APC still drives through any
# wall. Drawn as a stretch of the wall in colors.gate, band_extra thicker than the wall, with a plain square post at each end. Hot-reloads (a changed width or lure
# radius re-marks every gate in planning).
cost                    = 50.0  # price of one gate
width                   = 20.0   # world meters: the stretch of wall a gate takes, centred on the click and slid along the wall to fit; a stretch of wall shorter than this takes no gate
band_extra              = 0.75   # world meters: how much thicker than its wall's band a gate is drawn, on EACH side, so a gate stands out of the wall it sits in (drawing and the click pick only; the gate's cells block and pass exactly like the wall's)
post_extra              = 1.5    # world meters: how far a gate's two end posts (plain squares, centred on the gate's ends, in colors.gate) reach past the gate's band on EACH side; a post is as long along the wall as it is thick (drawing only)
post_height             = 5.0    # meters a gate's end posts stand in the 3D view (view3d.wall_height is the wall's); they sink with the wear of the gate cell they stand on, like the wall (drawing only)
lure_radius             = 80.0   # world meters: a panicked civilian outside every zone this near a standing gate, with the zone behind it unbreached, runs for the gate and through it instead of straight away from the zombies (0 = never)

[evac]
# Civilian evac zones (Stage 12). Purchase with E (corridor) or C (hold circle),
# then click-drag to paint. Zones STEER the crowd (they don't block it) from the moment
# they are placed (a planned one from the first tick of the outbreak). A corridor is a
# gold rectangle + arrow: civilians inside it hurry toward the arrow end at their flee
# speed (corridor_flee_percent), which is below the zombies'. A hold circle is a gold
# ring: calm civilians nearby are pulled in and kept inside; a civilian that panics
# ignores both and can leave. A placed zone shows only its outline; the translucent
# gold fill appears while you drag one out, when the mouse is over it, and while it is
# selected. Left-click a zone to select it (drag a box to select several), then X
# deletes it -- refunded during planning, no refund once the outbreak is live. Only a
# zone's two drag points (corridor tail + tip, hold centre + edge) must sit inside the
# play area; the shape between them may cross the boundary. Each zone's price is
# corridor_cost / hold_cost. All hot-reload.
corridor_cost       = 0.4     # evac corridor (E) price per world unit of length
hold_cost           = 0.8     # hold circle (Q) price per world unit of radius
corridor_width      = 150.0   # full width of the funnel rectangle, world units
funnel_strength     = 0.7     # how strongly a corridor bends a civilian toward the arrow (0..~2)
corridor_flee_percent = 100   # % of its own flee speed (the panicked run, about half of zombie.speed) a calm civilian walks down a corridor at; never slower than its own walk (0 = its usual walk)
hold_speed          = 1.0     # civilian speed multiplier while held inside a hold circle (>= 1 = faster)
hold_radius_max     = 200.0   # largest hold-circle radius you can paint, world units
hold_attract_factor = 4.0     # attraction reaches this multiple of the circle radius
attract_strength    = 0.7     # how strongly a hold circle pulls a calm civilian toward its centre

# ======================================================================================
# PLANNING PLACEMENTS (bought with money), in hotkey order -- each block holds the unit's price, its stats and its upgrades
# ======================================================================================

[paint_brush]
# The paint brush of the GARRISON, every MORTAR tool (mortar, gas, fire, howitzer, MLRS) and
# the UPGRADE tool, used while the planning bar's PLACE MODE is PAINT (in CLICK a press takes
# only what it is on, and a drag adds nothing): hold the left button and drag, and each
# building (or, for UPGRADE, each of your units) the brush circle touches is painted -- not
# just the one under the cursor. The press itself takes only what it is on, so a click stays
# exact; the brush wakes once the cursor has moved start_px from the press. Its ring shows
# round the cursor, at its size on the ground, whenever one of those tools is armed in PAINT. Each building is tried once a stroke, at its normal price. (The mine, spike strip
# and oil slick brushes have their own brush_radius keys.) All hot-reload.
radius   = 12.5    # the brush's radius, world meters (about half a city block's width); 0 = no brush, a drag takes only what the cursor passes over
start_px = 6.0     # screen pixels the cursor must move from the press before the brush paints, so a click's jitter paints nothing round it

[garrison]
# Press 1, then click a building to GARRISON it: a crew holds the whole building and
# auto-fires at the nearest zombie in a full CIRCLE around it (no cone, nothing to aim).
# Click it again to STACK it up a level (4 levels). No level has a key of its own: a level
# raises only the stats level_up names, 3x/6x/12x their level-1 key (the game's fixed
# sim.LEVEL_MULT) -- as shipped its magazine, at the same fire_cooldown, reload_seconds,
# damage and reach -- and each level adds level_price_percent of the
# building's price (50: 1.5x/2x/2.5x in all) --
# stepping up pays the difference, X refunds the whole level. All
# on one hotspot, and the level-1 keys below move every level. The bigger the building, the further it reaches -- and the more each crew costs. A building's size here is its WIDTH: the side of a square with
# the same footprint area (the square root of the area), so a long block counts the same
# as a square one of the same floor space. Reach = range_base + range_per_meter x width, at
# most range_max. While the tool is armed every building shows its price on it ("LV2 $50"
# on a garrisoned one: the price of its next level). Its reach is drawn as a translucent disc;
# selecting the garrison (click its building) outlines the building and the circle. All
# hot-reload live.
# PRICE: garrisoning a building (1) costs cost_base + cost_per_meter x its width, at most
# cost_max, rounded to whole money. A building has one price; the bar's garrison button
# shows the cheapest one still open ("$17+"), and each building shows its own while the
# tool is armed.
cost_base               = 15.0   # garrison price before the building's width adds on -- balance.ini overrides this
cost_per_meter          = 2.25   # money per meter of building width (a 20 m wide building: 15 + 45 = $60) -- balance.ini overrides this
cost_max                = 225.0  # the most garrisoning any building costs (0 = no cap) -- balance.ini overrides this
cost_increase           = 0      # money each garrisoned building already on the board adds to the next one's price (0 = a flat price; see [economy])
level_price_percent     = 50     # % of the building's level-1 garrison price each stack level adds to its whole price (50: levels 2/3/4 cost 1.5x/2x/2.5x in all). Stepping up pays the difference
price_label_radius      = 260    # PRICE LABELS: while the tool is armed, only buildings whose price label sits within this many UI pixels of the cursor show it (the hovered one always does; 0 = the whole screen). Labels never overlap: where two would, the hovered building's wins, then one the money covers, then the bigger label, then the bigger building
level_up                = magazine  # STACK LEVELS: the stats each level raises 3x/6x/12x, any of fire_rate, reload, magazine, damage, range (range: its reach times the square root, so 3x/6x/12x the ground), comma-separated; none = levels raise nothing. Left out or unreadable: magazine. Not a mod setting
range_base      = 30.0   # meters of reach before the building's width adds on -- balance.ini overrides this
range_per_meter = 2.625  # meters of reach per meter of building width (a 20 m wide building: 30 + 52.5 = 82.5 m) -- balance.ini overrides this
range_max       = 262.5  # the longest reach any building gives, in meters (0 = no cap) -- balance.ini overrides this
fire_cooldown  = 0.05    # seconds between shots (5 a second, 2.5x the officer rate) -- balance.ini overrides this
first_shot_spread = 1.0  # seconds: each garrison's FIRST shot of a battle comes a random 0..this later than usual (one fire_cooldown after READY), so the garrisons don't all open fire, and reload, in step. Only the first shot moves. 0 = all fire together. Read at READY
damage         = 5.0     # health a hit takes off a zombie (zombie.hp starts at 1 and grows: one hit kills until it passes this)
accuracy       = 1.0     # 0..1 chance a shot connects
# RELOAD: a garrison fires `magazine` rounds, then holds fire for reload_seconds (sim time)
# while a grey bar fills over it, then fires again -- so it keeps up magazine /
# ((magazine - 1) x fire_cooldown + reload_seconds) rounds a second in a long fight. A partly
# spent magazine is not topped up between fights.
magazine       = 180      # rounds fired before a reload (0 = never reloads) -- balance.ini overrides this
reload_seconds = 6.0     # sim seconds a reload holds fire for -- balance.ini overrides this
max_reloads    = 10      # OUT OF AMMO: a garrison standing outside every safe zone at READY gets this many reloads (this many magazines and one more), then stops firing for the rest of the battle and its building dims (colors.out_of_ammo_dim). One inside a zone never runs out. -1 = no limit
upgrade_rate_percent      = 15   # GARRISON FASTER ATTACK SPEED: % added to the fire rate a level (every stack level)
upgrade_rate_cost         = 1    # SP for its first level
upgrade_magazine_percent  = 25   # GARRISON BIGGER MAGAZINE: % added to the rounds before a reload a level (every magazine)
upgrade_magazine_cost     = 1    # SP for its first level
upgrade_reload_percent    = 20   # GARRISON FASTER RELOAD: % added to the reload speed a level
upgrade_reload_cost       = 1    # SP for its first level
upgrade_reach_percent     = 10   # GARRISON LONGER REACH: % added to every garrison's reach a level (past garrison.range_max too)
upgrade_reach_cost        = 2    # SP for its first level

[sniper]
# Press 2, then click-drag on a building roof to place a sniper aiming along the
# drag. It cannot move. It fires only at zombies inside a fixed cone (cone_angle
# wide). The cone's length comes from the roof's HEIGHT: range
# on a roof of unknown height, plus range_per_roof_meter for every meter the roof is tall
# (at most height_cap meters count) -- 186 m from a 12 m roof (a typical New York one),
# 224 m from 20 m, 511 m from 81 m, 835 m from 150 m, 2,212 m from a 443 m tower, 2,245 m
# from a 450 m one or taller. Even a roof of unknown height (130 m) reaches twice an
# average garrison (about 65 m: New York's buildings' mean, garrison.range_base +
# range_per_meter x width). The cone is a BAND, like the mortar's ring: it can't shoot a
# zombie closer than min_range (plus min_range_per_roof_meter a meter of roof) -- 62 m from
# a 12 m roof, 131 m from 81 m, 493 m from a 443 m tower -- so a tall roof sees far but
# leaves a wider dead zone at its foot. Shift+right-click a selected sniper to
# re-aim it toward the click over reaim_seconds -- during which its cone shows only
# as a purple outline and it holds fire, then fills back in. All hot-reload live.
cost                = 50.0   # price of one sniper (2)
cost_increase       = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
# STACKING: press on one of your snipers with the tool armed to step it up a level (4 levels).
# Like the garrison's, no level has a key of its own: a level-2/3/4 sniper costs 3x/6x/12x
# cost in all (stepping up pays the difference; X refunds it all) and raises the stats
# level_up names -- as shipped its range: its cone covers 3x/6x/12x the ground, its reach
# (range + its roof's bonus) times the square root, 1.7x/2.4x/3.5x, with the same dead zone,
# fire_cooldown, reload_seconds, magazine and damage. So cost and range move every level.
level_up            = range  # STACK LEVELS: the stats each level raises (the list [garrison] level_up describes). Not a mod setting
range          = 400.0   # cone length / firing reach on a roof of unknown height, world units (a taller roof adds range_per_roof_meter a meter): the shortest any sniper reaches, twice an average garrison's (about 65 m). Measured from its building's edge, like min_range: the building's reach past its stand point (to its farthest corner) is added to both
fire_cooldown  = 0.40    # seconds between shots (1.25 a second)
damage         = 80.0    # health a hit takes off a zombie (4x the garrison's: a slow, heavy round)
accuracy       = 1.0     # 0..1 chance a shot connects
# RELOAD, like the garrison's: `magazine` rounds, then reload_seconds of holding fire under a
# grey bar, so it keeps up magazine / ((magazine - 1) x fire_cooldown + reload_seconds) rounds a
# second in a long fight -- 20 / (19 x 0.8 + 1.5) = 1.2 a second as shipped, 96% of its 1.25
# (every stack level fires at this same pace).
magazine       = 20      # rounds fired before a reload (0 = never reloads)
reload_seconds = 5     # sim seconds a reload holds fire for
max_reloads    = 10       # OUT OF AMMO: a sniper outside every safe zone at READY gets this many reloads, then stops firing and its building dims, like garrison.max_reloads. -1 = no limit
cone_angle     = 30.0    # full width of the firing cone, in degrees
reaim_seconds  = 7.0     # time to swing the cone to a new Shift+right-click aim (outline only, no fire)
range_per_roof_meter = 4.7   # extra cone length (world meters) per meter of height of the roof the sniper stands on, up to height_cap (an 81 m roof reaches 130 + 4.7 x 81 = 511 m, a 443 m tower 2,212 m); 0 = no height bonus
height_cap     = 450.0   # meters: the most roof height that adds to a sniper's reach and dead zone (a taller building counts as this tall). The sniper's own: [building] height_cap is the mortars'
min_range      = 50.0    # the cone's dead zone on a roof of unknown height, world meters: never fires at a zombie closer than this (a taller roof adds min_range_per_roof_meter a meter). Always kept under the cone's length
min_range_per_roof_meter = 1.0  # how many meters the dead zone grows per meter of roof (same height cap as range_per_roof_meter). The reach grows range_per_roof_meter / min_range_per_roof_meter (4.7 / 1 = 4.7x) as fast as the dead zone, so a taller roof still wins; tune that ratio by editing these two keys. 0 = the dead zone stays min_range
first_shot_spread = 0.5  # seconds: each sniper's FIRST shot of a battle comes a random 0..this later than usual (one fire_cooldown after READY), so the snipers don't all fire on the same tick and then stay in step. Only the first shot moves: every gap after it is still fire_cooldown. The sim fires only on its 1/30 s (0.033 s) ticks, so a spread of under a few ticks still puts most first shots on the same one. 0 = all fire together. Read at READY
upgrade_rate_percent      = 15   # SNIPER FASTER ATTACK SPEED
upgrade_rate_cost         = 1    # SP for its first level
upgrade_magazine_percent  = 100  # SNIPER BIGGER MAGAZINE: % added to this sniper's rounds before a reload a level (every magazine)
upgrade_magazine_cost     = 1    # SP for its first level
upgrade_reload_percent    = 80   # SNIPER FASTER RELOAD: % added to this sniper's reload speed a level
upgrade_reload_cost       = 1    # SP for its first level
upgrade_range_percent     = 35   # SNIPER LONGER RANGE: % added to this sniper's reach (sniper.range and the roof bonus) a level
upgrade_range_cost        = 1    # SP for its first level

[mortar]
# Press 3, then click a building roof to place a mortar squad. Like a sniper it
# cannot move and auto-fires at zombies, but it covers a large RING rather than a cone:
# it can hit anywhere out to `range` except inside `min_range` around itself, a dead zone
# too close to lob a shell into. It fires very slowly (fire_cooldown),
# and instead of a hitscan shot it LOBS a shell that arcs up into the air and, when it
# lands, explodes -- every zombie within blast_radius takes `damage`, and every civilian
# there dies. It aims at
# the densest pack of zombies in its circle (the spot where the blast catches the
# most), leads a pack on the move by the flight time, and skips a pack another shell
# is already falling on. A mortar shell never kills your own units: officers, snipers,
# garrisons, Turrets and mortars in the blast are untouched. It does wear down what it lands
# among: its `damage` (the same it does a zombie, at its level) off every building in the
# blast, times the share of the building the blast covers (a building worn to [building] hp is levelled, and any garrison, sniper
# or mortar on it falls with it). It leaves walls whole: only a blast the player aims wears
# a wall. All hot-reload live.
cost                = 75.0   # price of one mortar squad (3)
cost_increase       = 1      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
# STACKING: click one of your mortars with the tool armed to step it up a level (4 levels),
# priced like the sniper's (3x/6x/12x cost). A level raises the stats level_up names -- as
# shipped only the shells' damage, 3x/6x/12x `damage` (to each zombie, building and bridge
# in the blast): its fire_cooldown, reload_seconds,
# magazine and reach are level 1's at every level. No keys of their own (the game's fixed
# sim.LEVEL_MULT). The howitzer and MLRS take this level_up unless their block sets its own;
# a gas or fire mortar, which blasts nothing, sets its own (magazine).
level_up            = damage  # STACK LEVELS: the stats each level raises (the list [garrison] level_up describes). Not a mod setting
range          = 600.0   # outer firing reach: a mortar aims at the zombies this close, and its shell always lands inside this circle. Measured from its building's edge (the building's reach past its stand point is added), like min_range; the howitzer's, MLRS's, gas and fire mortar's too
min_range      = 160.0   # inner dead zone: a mortar never aims at a zombie this close, and its shell never lands inside this circle (0 = no dead zone)
fire_cooldown  = 12.0    # seconds between shots (very slow)
first_shot_spread = 6.0  # seconds: each mortar's FIRST shot of a battle comes a random 0..this later than usual (one fire_cooldown after READY), so the mortars don't all fire on the same tick and then stay in step. Covers every mortar (gas, fire, howitzer, MLRS too). Only the first shot moves: every gap after it is still fire_cooldown. 0 = all fire together. Read at READY
blast_radius   = 40.0    # radius of the explosion where the shell lands, world units (small)
damage         = 10.0    # health the blast takes off each zombie in it (two garrison hits) -- and off each building in it (all of it for a building the blast covers whole, a share for one it covers in part) and each bridge span it touches; the civilians in it die
# RELOAD and OUT OF AMMO, exactly like the garrison's: `magazine` shells, then reload_seconds of
# holding fire under a grey bar, and outside every safe zone max_reloads reloads in all.
magazine       = 4       # shells fired before a reload (0 = never reloads)
reload_seconds = 20.0    # sim seconds a reload holds fire for
max_reloads    = 3       # OUT OF AMMO: a mortar outside every safe zone at READY gets this many reloads (this many magazines and one more: 16 shells at every level), then stops firing and its building dims, like garrison.max_reloads. -1 = no limit
flight_seconds = 0.8     # how long the shell is in the air from launch to impact
range_per_roof_meter = 2.0   # extra firing reach (world meters) per meter of height of the roof the mortar stands on (see [building] height_cap); 0 = no height bonus
upgrade_rate_percent      = 15   # MORTAR FASTER ATTACK SPEED
upgrade_rate_cost         = 2    # SP for its first level
upgrade_blast_percent     = 10   # MORTAR BIGGER BLAST: % added to mortar.blast_radius a level
upgrade_blast_cost        = 2    # SP for its first level

[gas_mortar]
# The gas mortar: a mortar (place it the same way, on a roof) whose shells lay a stun-gas
# cloud where they land instead of blasting -- the stun gas's own cloud ([gas_bomb]): every
# unit inside it, zombies, civilians and your own officers alike, stands still (no
# movement, no bites, no gunfire) until it clears. Nothing is killed. It is the mortar's
# gun, stacked and upgraded like it, and it aims the same way, at the pack the cloud would
# catch the most of, skipping zombies already gassed. How the cloud is drawn: [particles]
# gas_*. All hot-reload.
cost     = 90.0    # price of one gas mortar
cost_increase = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
radius   = 50.0    # each shell's cloud radius, world units
level_up = magazine  # STACK LEVELS: the stats each level raises (the list [garrison] level_up describes); left out, [mortar]'s. Not a mod setting
duration = 6.0     # how long each shell's cloud lasts, seconds
# ITS GUN: any of these keys set here is the gas mortar's own; each one left out (commented,
# as shipped) is [mortar]'s, and follows it live. Same meanings as there.
# range                = 600.0   # outer firing reach, world units
# min_range            = 160.0   # inner dead zone, world units (0 = none)
# range_per_roof_meter = 2.0     # extra reach per meter of roof height
# fire_cooldown        = 12.0    # seconds between shots
# magazine             = 4       # shells fired before a reload (0 = never reloads)
# reload_seconds       = 20.0    # sim seconds a reload holds fire for
# max_reloads          = 3       # reloads outside every safe zone (-1 = no limit)
# flight_seconds       = 0.8     # seconds a shell is in the air

[fire_mortar]
# The fire mortar: a mortar (place it the same way, on a roof) whose shells lay a burning
# patch where they land instead of blasting -- the fire bomb's own fire ([fire_bomb]): any
# unit that stands in it burns ([fire]), zombie, civilian or your own officer or Turret
# alike, until it burns out, and it spreads over any greenspace it lands on. Buildings and
# walls are untouched. Its kills (the greenspace it lit included) are the fire mortar's on
# the battle stats. It is a mortar's gun, stacked and upgraded like it, and it aims the same
# way, at the pack the patch would catch the most of, skipping zombies already burning. How
# a patch is drawn: [particles] fire_*. All hot-reload.
cost         = 120.0   # price of one fire mortar
cost_increase = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
radius       = 20.0    # each shell's burning patch radius, world units
level_up = magazine  # STACK LEVELS: the stats each level raises (the list [garrison] level_up describes); left out, [mortar]'s. Not a mod setting
burn_seconds = 8.0     # how long each shell's patch burns, seconds
# ITS GUN: any of these keys set here is the fire mortar's own; each one left out (commented,
# as shipped) is [mortar]'s, and follows it live. Same meanings as there.
# range                = 600.0   # outer firing reach, world units
# min_range            = 160.0   # inner dead zone, world units (0 = none)
# range_per_roof_meter = 2.0     # extra reach per meter of roof height
# fire_cooldown        = 12.0    # seconds between shots
# magazine             = 4       # shells fired before a reload (0 = never reloads)
# reload_seconds       = 20.0    # sim seconds a reload holds fire for
# max_reloads          = 3       # reloads outside every safe zone (-1 = no limit)
# flight_seconds       = 0.8     # seconds a shell is in the air

[howitzer]
# The howitzer battery: a mortar (place it the same way, on a roof) with a gun of its own --
# a huge reach past a huge dead zone, very slow fire and a long flight, so one howitzer in a
# corner covers most of a stage. Its shell blasts like a mortar's (it spares your own units
# and wears its own damage off the buildings it lands among, leaving walls
# whole) at its own blast_radius and damage. Its kills are its own on the battle stats.
# Stacked and upgraded like the mortar. All hot-reload.
cost           = 400.0   # price of one howitzer
cost_increase  = 200     # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
blast_radius   = 140.0    # radius of a shell's blast, world units
damage         = 50.0    # health the blast takes off each zombie in it; the civilians in it die
# ITS GUN: each key set here is the howitzer's own; one left out (commented) is [mortar]'s,
# and follows it live. Same meanings as there.
range                = 6500.0  # outer firing reach, world units
min_range            = 500.0   # inner dead zone, world units (0 = none)
range_per_roof_meter = 0.0     # extra reach per meter of roof height (0: its reach is already huge)
fire_cooldown        = 15.0    # seconds between shots
magazine             = 2       # shells fired before a reload (0 = never reloads)
reload_seconds       = 30.0    # sim seconds a reload holds fire for
max_reloads          = 3       # reloads outside every safe zone (-1 = no limit)
flight_seconds       = 4.0     # seconds a shell is in the air (the aim leads a moving pack by this)

[mlrs]
# The MLRS (rocket artillery): a mortar (place it the same way, on a roof) that fires a quick
# ripple of a whole magazine of rockets across a pack, then reloads for a minute. Each rocket
# is aimed around the ones already falling, so the ripple spreads over the pack, and lands up
# to `scatter` off its aim. A rocket blasts like a mortar's shell (sparing your own units,
# wearing what it lands among) at its own blast_radius and damage. Its kills are its own on
# the battle stats. Stacked and upgraded like the mortar. All hot-reload.
cost           = 200.0   # price of one MLRS
cost_increase  = 0     # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
blast_radius   = 22.0    # radius of a rocket's blast, world units
damage         = 10.0    # health the blast takes off each zombie in it; the civilians in it die
scatter        = 18.0    # world units: the most a rocket lands off its aim (0 = dead on)
# ITS GUN: each key set here is the MLRS's own; one left out (commented) is [mortar]'s, and
# follows it live. Same meanings as there.
range                = 900.0   # outer firing reach, world units
min_range            = 200.0   # inner dead zone, world units (0 = none)
# range_per_roof_meter = 2.0   # extra reach per meter of roof height
fire_cooldown        = 0.25    # seconds between rockets in a ripple
magazine             = 12      # rockets in a ripple, fired before a reload
reload_seconds       = 60.0    # sim seconds a reload holds fire for
max_reloads          = 2       # reloads outside every safe zone (-1 = no limit)
flight_seconds       = 1.5     # seconds a rocket is in the air

[turret]
# The Turret (a machine-gun nest). Press 4, then click a BUILDING to put one in it: like
# a sniper or mortar it holds the whole building (one unit to a building), and the
# building, tinted in the Turret's colour, is the unit. It cannot move and has nothing to
# aim: like the garrison it fires at the nearest zombie in a full CIRCLE of `range` around
# the building's stand point, at a very high rate of fire but a short reach. It falls with
# its building. Its range does not grow with the roof's height. All hot-reload live.
cost                = 90.0   # price of one Turret (4)
cost_increase       = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
# STACKING: click one of your Turrets with the tool armed to step it up a level (4 levels),
# priced like the sniper's (3x/6x/12x cost), raising the stats level_up names 3x/6x/12x (no
# keys of their own) -- as shipped its magazine, at level 1's fire rate and reload. The
# railgun takes this level_up unless its block sets its own.
level_up            = magazine  # STACK LEVELS: the stats each level raises (the list [garrison] level_up describes). With fire_rate, level 4 fires 1,200 a second: the sim's cap is 1,920. Not a mod setting
range          = 75.0    # firing reach, a full circle (5/8 of officer.range), measured from its building's edge: the building's own reach past its stand point (to its farthest corner) is added
fire_cooldown  = 0.01    # seconds between shots (100 a second; officers fire twice a second) -- balance.ini overrides this
first_shot_spread = 1.0  # seconds: each Turret's FIRST shot of a battle comes a random 0..this later than usual (one fire_cooldown after READY), so the Turrets don't all open fire, and reload, in step. Covers the railgun too. Only the first shot moves. 0 = all fire together. Read at READY
damage         = 4.0    # HP removed per hit (one hit kills a zombie at its starting zombie.hp of 1; more as its health grows)
accuracy       = 1.0     # 0..1 chance a shot connects
# NO RELOAD, by design: max_reloads = 0, so a plain Turret gets ONE magazine of `magazine`
# rounds for the whole battle and nothing resupplies it (a Supply building does nothing for
# it). It has no FASTER RELOAD upgrade.
magazine       = 1000     # rounds in its one magazine for the battle -- balance.ini overrides this
reload_seconds = 4.0     # never used by the plain Turret (it never reloads); only the railgun's fallback when [railgun] leaves out its own reload_seconds -- balance.ini overrides this
max_reloads    = 0       # reloads a plain Turret gets in a battle: 0 = none, one magazine and it is out of ammo (it is never resupplied; -1 = no limit)
upgrade_rate_percent      = 15   # TURRET FASTER ATTACK SPEED
upgrade_rate_cost         = 1    # SP for its first level
upgrade_magazine_percent  = 25   # TURRET BIGGER MAGAZINE
upgrade_magazine_cost     = 1    # SP for its first level
upgrade_range_percent     = 10   # TURRET LONGER RANGE: % added to turret.range a level
upgrade_range_cost        = 1    # SP for its first level

[railgun]
# The railgun: a Turret held in a building, but AIMED like the sniper: press on a building,
# then drag the way it should face (a plain click faces it from the building toward the
# click; Shift+right-click a selected one in planning to turn it). It fires only at zombies
# inside a narrow cone (cone_angle wide) round that heading, from GROUND LEVEL:
# its round leaves its building where the line toward its target crosses the building's
# outline and flies on along the ground, through every zombie on its line (within line_width
# of it), until it STRIKES A BUILDING or leaves the map -- `range` is only how far its cone
# reaches to find something to aim at, not how far the round goes. It aims only along a line
# no building blocks (open ground, water, walls, gates and rubble do not stop it), at about
# the nearest such zombie in its cone. Its PAINT place mode is off: each one is aimed. Its kills are its own on the battle stats. Stacked and upgraded like
# the Turret. Its round is drawn as a beam ([projectiles] railgun_*, [colors] railgun_beam*).
# All hot-reload.
cost           = 100.0   # price of one railgun
cost_increase  = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
pierce         = 0       # zombies one round hits, nearest first (0 = every zombie on its line)
line_width     = 5.0     # world units: how wide the strip a round hits in is
round_speed    = 3000.0  # world units/sec the round flies: a zombie it hits drops when the round reaches it
retarget_seconds = 0.25  # seconds a railgun with no zombie in reach on an open line waits before it looks again (rarer looks, less work per tick)
cone_angle     = 10.0    # full width of its aim cone round the way it faces, in degrees (0 or 360 = all round)
# ITS GUN: each key set here is the railgun's own; one left out (commented) is [turret]'s,
# and follows it live. Same meanings as there.
range          = 420.0   # how far its aim cone reaches to find a zombie (its round flies on past this)
fire_cooldown  = 1.0     # seconds between rounds (one round a magazine: the reload paces it)
damage         = 10.0    # HP removed from each zombie a round hits, and from the building it strikes (one damage for both)
accuracy       = 1.0     # 0..1 chance a round connects (a miss hits nothing)
magazine       = 1       # rounds fired before a reload
reload_seconds = 12.0    # sim seconds a reload holds fire for
max_reloads    = 10      # reloads it gets in a battle (a Turret is never resupplied; -1 = no limit)
# Its SP upgrades are the Turret's ([turret] upgrade_*), plus a FASTER RELOAD of its own (a
# plain Turret never reloads, so it has none):
upgrade_reload_percent    = 20   # RAILGUN FASTER RELOAD: % added to its reload speed a level
upgrade_reload_cost       = 1    # SP for its first level

[mine]
# Proximity mine. Press 5 during PLANNING, then click open GROUND (a street -- never a
# roof, water, or a wall) to plant one, or HOLD the left button to paint with a brush, like a
# tree brush: after paint_delay, paint_rate mines a second scatter at random spots inside
# brush_radius of the cursor (spots on a roof, water, a wall or off-limits ground are
# skipped and not charged, and so is any spot closer than paint_spacing to a mine already
# down, so holding still fills the circle and then stops), each paid for as it lands, until
# the money runs out. A mine never moves and never fires: it lies there
# doing nothing until a zombie comes within trigger_radius, which starts a fuse of
# fuse_seconds that nothing can stop -- not killing that zombie, not stun gas. When the
# fuse runs out the charge kills EVERYTHING inside its blast, zombies, civilians and your
# own units alike (full friendly fire, like an airstrike -- unlike a mortar shell, which
# spares your own units), and the mine is spent. It also wears its `damage` off the
# buildings in its blast, like a mortar shell, and leaves walls whole.
# No other blast touches a mine -- another mine's, a shell, a bomb, C4, a fuel building --
# so mines never chain: each one waits for a zombie of its own.
# The always-on amber disc under the mine shows exactly what its blast would take out.
# Mines are a planning placement (mine.cost) and cannot be planted once the
# outbreak runs. All hot-reload live.
cost                = 15.0   # price of one proximity mine (5); a painted line pays this per mine
cost_increase       = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
trigger_radius = 3.0     # a zombie this close arms the fuse (= zombie.infection_touch_radius: close enough to bite it)
fuse_seconds   = 3.0     # simulated seconds from arming to the blast
blast_radius   = 65.0    # radius of the blast, world units (meters on an OSM map; a mortar shell's is 40)
damage         = 40.0    # health the blast takes off each zombie in it (4x a mortar shell's) -- and off each building and bridge span in it, like a mortar shell; everyone else in it dies
paint_spacing  = 20.0    # the least gap, world units, the paint brush leaves between a mine it lays and any mine already down (a single click ignores it)
brush_radius   = 40.0    # the paint brush's radius, world units: brush mines land at random spots inside this circle around the cursor
paint_rate     = 6.0     # brush mines tried per real second while the button is held (a spot too close to a mine is retried a few times, then given up for that try)
paint_delay    = 0.2     # real seconds the button must be held before the brush starts, so a quick click lays only its one mine

[c4]
# C4 demolition charge: the proximity mine's opposite number, with a far bigger, world-
# wrecking blast. Press 6 during PLANNING, then click open GROUND (a street -- never a
# roof, water, or a wall) to plant one, the same rule the mine and the Turret
# follow. It has NO trigger and NO fuse: it lies inert for the whole battle, whatever
# walks over it, until YOU fire it. During the outbreak the command bar grows a DETONATE
# button (key 7) as soon as a charge is planted; arm it and click anywhere inside a
# charge's own blast radius and that charge -- the single NEAREST one to the click, never
# the whole line -- goes off at once. The detonator STAYS armed after a shot, so a row of
# charges can be fired one at a time as the horde walks the street; Esc or right-click
# puts it away.
# The blast hits EVERYTHING inside it -- each zombie takes `damage`, and civilians and your
# own units die (full friendly fire, like the mine), and -- UNLIKE the mine -- it also
# LEVELS every building inside the blast, exactly as an airstrike does, and wears the same
# `damage` off every bridge span (see [bridge]) and every part of your walls and gates inside
# it (one worn to 0 breaches). A charge caught in someone else's blast is destroyed instead of
# chaining. The always-on orange disc under each charge shows exactly what it would take
# out. Charges are a planning placement (c4.cost) and cannot be planted once the
# outbreak runs. blast_radius hot-reloads live.
cost                = 500.0   # price of one C4 demolition charge (6) -- dearer than a mine: you choose the moment
cost_increase       = 0     # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
blast_radius    = 160.0  # kill + demolish radius of one charge, world units (meters on an OSM map)
damage          = 200.0   # health the blast takes off each zombie in it (6x a mortar shell's) -- and off each bridge span it touches and each wall / gate cell inside it (walls.hp 1200 is a level-1 cell's); everyone else in it dies

[chemical_mine]
# The chemical mine: a proximity mine (place it and paint it the same way, on open ground)
# whose fuse lays a stun-gas cloud where it stands instead of blasting: every unit inside the
# cloud, zombies, civilians and your own officers alike, stands still (no movement, no bites,
# no gunfire) until it clears, and a gassed zombie wears no wall down. Nothing is killed.
# Like the mine, only a zombie reaching it sets it off ([mine] trigger_radius and
# fuse_seconds): no blast does. The always-on disc under it shows its cloud. A planning
# placement; all hot-reload.
cost          = 10.0    # price of one chemical mine; a painted field pays this per mine
cost_increase = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
gas_radius    = 45.0    # its cloud's radius, world units
gas_seconds   = 8.0     # how long the cloud lasts, seconds
paint_spacing = 20.0    # the least gap the mine brush leaves between two chemical mines, world units (its reach and pace are [mine]'s)

[spike_strip]
# The spike strip (caltrops): PAINTED ground. Hold the button on open ground and the brush
# paints every 4 m cell within brush_radius of the cursor, dragging paints a band, and Shift
# held at the press erases instead (refunding). A zombie on the strip walks at speed_percent
# of its own speed; civilians and your officers aren't slowed. It never runs out and nothing
# wears it away (fire and blasts leave it be). A planning placement; all hot-reload.
cost          = 1.0     # price of one painted 4 m cell (16 m^2)
brush_radius  = 12.0    # the brush's radius, world units
speed_percent = 40.0    # a zombie's walking speed on the strip, % of its own

[oil_slick]
# The oil slick: PAINTED ground, with the same brush as the spike strip (hold to paint, drag
# for a band, Shift to erase, with its own erase_radius). It does nothing until a blast (a mine, a shell, C4, a bomb, a
# fuel building, an exploding zombie) or a fire (a fire bomb's, a fire mortar's, napalm's,
# burning greenspace) reaches it: then it catches, and the fire runs across the whole slick
# at spread_speed, burning each part of it for burn_seconds with the fire that hurts any
# unit standing in it, zombie, civilian or your own officer alike. Greenspace the burning
# slick touches catches too. Its kills are the oil slick's on the battle stats. A planning
# placement; all hot-reload.
cost          = 1.0     # price of one painted 4 m cell (16 m^2)
brush_radius  = 12.0    # the brush's radius, world units
erase_radius  = 24.0    # the eraser's radius (Shift held at the press), world units
burn_seconds  = 12.0    # how long each part of a lit slick burns, seconds
spread_speed  = 100.0   # how fast the fire runs across the slick, world units a second

[napalm_drum]
# The napalm drum: a C4 charge (plant it the same way, on open ground) that the DETONATE tool
# fires like one, but that lays a burning patch `radius` across for burn_seconds where it
# stands instead of blasting: the fire kills any unit that stands in it, zombie, civilian or
# your own officer alike, and lights any fuel building and oil slick it reaches. Buildings,
# walls and bridges are untouched. Its kills are the napalm drum's on the battle stats. The
# always-on disc under it shows its fire. A planning placement; all hot-reload.
cost          = 100.0   # price of one napalm drum
cost_increase = 0      # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
radius        = 40.0    # its burning patch's radius, world units
burn_seconds  = 20.0    # how long the patch burns, seconds

[battleship]
# Press 7 during planning, then click open water to moor a battleship. It only goes where
# the water holds its whole hull -- `length` x `beam`, every 2 m cell under it river, lake
# or sea: not a bridge, not ground outside the play area, not another battleship. The hull
# turns itself to fit the water under the cursor (lined up with a river or canal where it
# can be), and a click where no heading fits is refused (BATTLESHIP MUST BE PLACED FULLY ON WATER).
# It carries `guns` guns that each work like a mortar moored on that spot: each gun lobs a
# shell, on its own fire_cooldown, at the densest zombie pack in the ring around the middle
# of the ship (out to `range`, never inside `min_range`), each aimed around the shells
# already falling, so a volley spreads over different packs, and a gun with nothing in reach
# stays loaded and fires as soon as a pack walks in. A shell kills every zombie and civilian
# within blast_radius -- a wider blast than a mortar shell's -- and none of your own
# units, like a mortar shell; like one, it wears its `damage` off the buildings in its
# blast and leaves walls whole. The ship never moves, and
# an airstrike bomb, a fire patch, a mine, a C4 charge or a fuel building going up that
# reaches the middle of the ship sinks it. Its shells draw like the mortar's
# (projectiles.shell_size / shell_apex_scale). A plan may moor any number of battleships, but
# each one on the board makes the next cost `cost_increase` more. All
# hot-reload; length and beam are
# checked when a ship is placed, so a change fits the next one.
cost                = 750.0   # price of one battleship (T)
cost_increase       = 550    # money each one already on the board adds to the next one's price (0 = a flat price; see [economy])
range          = 1400.0   # outer firing reach from the middle of the ship: a gun aims at the zombies this close, and its shell always lands inside this circle
min_range      = 200.0   # inner dead zone: a gun never aims at a zombie this close, and its shell never lands inside this circle (0 = no dead zone)
fire_cooldown  = 0.5     # seconds between one gun's shells
first_shot_spread = 3.0  # seconds: each battleship's FIRST shell of a battle comes a random 0..this later than usual (one fire_cooldown after READY), so the ships don't all fire together and then stay in step. Only the first shell moves. 0 = all fire together. Read at READY
blast_radius   = 50.0    # radius of the explosion where a shell lands, world units (a mortar shell's is 40)
damage         = 10.0    # health the blast takes off each zombie in it; the civilians in it die
flight_seconds = 0.8     # how long a shell is in the air from launch to impact
magazine       = 12      # RELOAD: shells the ship fires before it reloads (0 = never reloads)
reload_seconds = 10.0     # sim seconds a reload holds its fire (it takes the place of the gap after the shell that emptied it)
max_reloads    = -1      # OUT OF AMMO: a battleship outside every safe zone at READY gets this many reloads (this many magazines and one more), then stops firing and dims, like garrison.max_reloads. -1 = no limit
length         = 150.0   # hull length in meters: the water must hold the whole hull, a volley's shells leave from along it, and art.battleship_sprite's ship is drawn this long
beam           = 18.0    # hull width in meters: the ship in art.battleship_sprite drawn `length` long is 17.2 m wide (1535 x 176 px), so the water checked holds all of it
upgrade_reload_percent    = 80   # BATTLESHIP FASTER RELOAD: % added to this one ship's reload speed (its reload_seconds divided by it) a level, bought per ship
upgrade_reload_cost       = 2    # SP for its first level
upgrade_blast_percent     = 35   # BATTLESHIP BIGGER BLAST: % added to this ship's shells' blast radius (battleship.blast_radius) a level
upgrade_blast_cost        = 2    # SP for its first level

# ======================================================================================
# BATTLE DEPLOYABLES (bought with skill points on the loadout screen) -- each block holds the item's SP cost and level cap, its unlock time and its stats
# ======================================================================================
# The loadout screen (the LOADOUT button on the planning command bar, or U) spends SKILL
# POINTS (SP) -- a currency of its own, separate from money -- on the BATTLE ABILITIES. An
# item's first level (its sp_cost SP) puts it on the battle bar; each level after it (the same
# price again) adds its charges_per_level more charges; `max` caps the level (0 = no cap: only
# SP limit it). As shipped no ability RECHARGES (cooldown_seconds = 0): the battle starts with
# charges_per_level charges of it per level (1; CONTROLLED DEMOLITION and CRUISE MISSILE 3; the paratroopers: one
# charge of paratroopers.squad_size officers per level), usable
# once its unlock_seconds have run, and a spent charge is gone. An ability given a
# cooldown_seconds above 0 recharges instead: it starts with one charge, every charge spent
# comes back after that cooldown, and each level after the first makes it recharge faster
# ([skill_points] level_recharge_percent); its `charges` is how many it banks: 1 = its
# recharge starts only once it is used; more = it keeps recharging up to that many while it
# waits. SP come with the stage's crowd ([skill_points]). Levels are remembered
# per map in plans/<map>.prep and carried through a campaign. All hot-reload.

[aircraft]
# Fly-in shared by all three aircraft: the bomber airstrike (A), the paratrooper
# transport (P click-drag during the outbreak), and the called-in helicopter (H).
# Each enters from just off the current screen edge; flyin_seconds is how many
# simulated seconds it takes to fly that off-screen lead in to the aim point -- a
# FIXED arrival time at any zoom (the plane's fly-in speed is set from it), and the
# "0:34"-style ETA shown by the cursor while you aim. Hot-reloads.
# ARRIVAL TIMES: every battle ability's block can also set arrival_seconds, the sim seconds
# from the click (or a spray's release) until it arrives -- the first bomb lands, the first
# jumper touches down, the gunship is over the spot, the rally takes hold. Longer than its
# fly-in, the aircraft waits off the map first and then flies in at its usual speed; left
# out or 0, it arrives in its own travel time. The cruise missile's is its flight_seconds and
# the nuke's its delay_seconds. Its unlock_seconds is the other timer: how long after READY
# before it can be used at all.
flyin_seconds = 5.0     # seconds an aircraft takes to arrive from off-screen (0 = near-instant)

[officer]
# The police officers the battle brings in: airdropped paratroopers ([paratroopers]) and
# civilians enlisted by Call to Arms ([call_to_arms]). They land on Seek & Destroy: they
# advance on the horde by themselves and auto-fire at the nearest zombie in range. Officers
# walk straight through your own walls; civilians and zombies still can't. A zombie that
# reaches an officer bites it and turns it into a zombie just like a civilian (freezes it
# for zombie.infection_pause_seconds, then it turns). None is placed in planning. All
# hot-reload live.
# FIRE RATE (every gun's fire_cooldown -- officer, sniper, mortar, garrison, Turret, APC):
# any decimal fires at exactly 1 / fire_cooldown rounds a second, including values shorter
# than the 1/60 s sim tick, which fire several rounds in one tick. The cap is 16 rounds a
# tick (960 a second): a fire_cooldown under 0.00104 fires at that cap, and the game prints
# and flashes a warning naming the key when it loads one.
range            = 120.0   # an officer auto-fires at the nearest zombie this close
fire_cooldown    = 1.0     # seconds between an officer's shots (2 a second)
damage           = 5.0     # health a hit takes off a zombie, like the garrison's
accuracy         = 1.0     # 0..1 chance a shot connects
speed            = 40.0    # world units/sec an officer moves under an order or when hunting
kite_distance    = 45.0    # world units: a hunting officer with a zombie nearer than this backs straight away from it, still firing, and stands again once it is farther (0 = it stands its ground and fires); officer.speed is above zombie.speed, so one with room behind it keeps its distance
fire_lookahead   = 6.0     # world units: a hunting or patrolling officer checks the ground this far ahead and turns up to 135 degrees away from fire there, stands while every way ahead burns, and walks out of fire it is standing in by the nearest clear way (0 = officers walk through fire)

[paratroopers]
# Press 1 during the outbreak (officers are never placed in planning, where 1 is the
# garrison) then HOLD the left button: officers are sprayed in like a paint can -- one
# lands at a random spot inside spray_radius of the cursor every 1/spray_rate seconds for
# as long as you hold (move the mouse to spread them; spots on buildings, water, or
# off-limits ground are skipped and not charged). The spots are queued while you hold
# and, on release, a transport plane flies in from off the current screen edge (a "0:34"
# arrival ETA shows by the cursor while you spray) along one straight line over them and
# drops a parachute abeam each spot; each jumper drifts onto its own spot while it
# descends. Each lands as an officer ([officer]). All hot-reload live.
sp_cost       = 1    # SP per level of PARATROOPERS: the first level puts it on the battle bar, each one after adds a squad to every charge (with a cooldown_seconds above 0, its recharge stays that at every level)
max           = 0      # highest PARATROOPERS level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds a squad to the charge); above 0 (e.g. 45), the sim seconds (real seconds at 1x) one charge takes to come back, once the first-use lock (unlock_seconds) has run out; the same at every level -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
squad_size       = 20      # officers in one battle paratrooper squad: one charge of PARATROOPERS holds this many per loadout level (level 3: 60)
spray_radius     = 3.0    # spray tool: officers land at random inside this radius (world units) around the cursor
spray_rate       = 10.0    # spray tool: officers laid per real second while the button is held (the first lands at once), times the PARATROOPERS level, so every level's bigger charge lands in the same time
spray_rate_per_officer = 0.15 # spray tool: extra officers per real second for each officer still in stock (rate = (spray_rate + this x stock per level) x level; level 1, 20 in stock: 33/s; level 3, 60: 99/s; eases back as it drains; 0 = flat)
spray_rate_max   = 100.0   # spray tool: the most officers per real second the spray ever lays, whatever the stock and level (Sandbox Mode's unlimited stock would otherwise lay thousands a second); 0 = no cap
unlock_seconds   = 0.0     # battle unlock: real seconds at 1x (real time) after the outbreak starts before paratroopers can be dropped
arrival_seconds  = 8.0     # arrival: sim seconds from the release until the first officer touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off

[call_to_arms]
# Call to Arms (a battle-only deployable: press Z during the outbreak, then drag a circle
# over a crowd like the evac hold zone). On release, a share of the civilians inside the
# circle are turned into police at once -- no persistent zone is placed. The circle shows
# a single ring while you drag it. Each enlisted civilian fights as an officer
# ([officer]). All hot-reload.
sp_cost       = 2    # SP per level of CALL TO ARMS: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest CALL TO ARMS level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 80), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
fraction   = 0.05   # 0..1 share of the civilians in the circle enlisted as police (0.05 = 5%)
radius_max = 150.0  # largest circle radius you can drag, world units
unlock_seconds  = 0.0  # battle unlock: real seconds at 1x (real time) after the outbreak starts before a Call to Arms can be used
arrival_seconds = 0.0  # arrival: sim seconds from the release until the civilians are armed (0 = at once); longer, it waits before it takes hold

[airstrike]
# Press A during the outbreak, then click-drag a target strip: a plane flies in from
# off the current screen edge (a "0:34" arrival ETA shows by the cursor while you draw
# the strip) along it (start -> end, the direction you drew) and drops bomb_count bombs, spaced
# evenly across the strip. Each bomb detonates as a white flash of radius
# blast_radius; everything inside dies -- zombies, civilians, AND your own police /
# vehicles -- and any building the flash covers by more than building_destroy_fraction
# of its footprint is destroyed: it is removed entirely -- its footprint stops drawing
# and its cells become walkable, so nothing is left where it stood. Every part of your walls
# and gates inside the flash is flattened too: the wall breaches there. Each run
# spends a charge, which recharges (cooldown_seconds), and none can be called before
# unlock_seconds real seconds of a 1x (real time) outbreak have passed (the button shows the countdown).
# All hot-reload.
sp_cost       = 2    # SP per level of AIRSTRIKE: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest AIRSTRIKE level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 120), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds            = 45.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a strike can be called; separate from aircraft.flyin_seconds
arrival_seconds           = 15.0   # arrival: sim seconds from the click until the first bomb lands (0 = the plane's own fly-in and fall); longer, it waits before it sets off
bomb_count                = 6      # bombs dropped per strike (spread evenly along the strip)
blast_radius              = 140.0   # kill + white-flash radius of each bomb, world units
damage                    = 200.0   # health each bomb takes off each zombie in its blast -- and off each bridge span it touches (see [bridge]); everyone else in it dies
plane_speed               = 640.0  # fly-in / strafe speed, world units/sec
fall_seconds              = 0.75   # a released bomb falls this long before it hits (0 = detonate at once); the plane lets each go as it passes over its point, so the blasts go off one by one behind it at its speed, this long after it
building_destroy_fraction = 0.30   # blast must cover this fraction of a building to level it

[fire]
# Fire, whatever laid it: a fire bomb, a fire mortar's shell, or the greenspace it spread to.
# Standing in it BURNS rather than kills on the spot: a zombie loses damage_per_second of its
# health every second it stands in fire ([zombie] hp: 1 at the start, growing as the battle
# goes on), and anyone else -- a civilian, an officer, a Turret, a mine -- dies once it has
# taken unit_health of fire, adding up across every fire it walks through. Units keep moving
# while they burn. The shielded zombie's shield does not stop it.
# Fire SPREADS over greenspace on any map: the parks, lawns and woods drawn on it. A fire that
# touches greenspace lights it, and the fire then creeps across the green on its own, 8 m at a
# time, at spread_speed, each patch burning spread_burn_seconds, until it runs out of green.
# A wall you placed and water are firebreaks; roads and buildings stop it where the green
# stops. Each patch of greenspace burns once a battle, and what burned is drawn grey
# (colors.burnt_ground) until a RETRY grows it back. All hot-reload (a change to spread_*
# reaches the fires lit after it).
damage_per_second   = 2.0    # zombie health a second in fire takes (garrison.damage is one hit's 5): 0 = fire never hurts a zombie
unit_health         = 10.0   # fire damage a civilian, officer or placed unit takes before it dies (10 at damage_per_second 1 = ten seconds in fire); 0 = dies the moment it steps in
spread_speed        = 5.5    # meters a second fire creeps over greenspace (0 = it never spreads, though greenspace a fire lands on still burns)
spread_burn_seconds = 60.0   # how long each 8 m patch of greenspace burns once lit, seconds (0 = greenspace never burns); twice a fire bomb patch's 40
spread_jitter       = 0.5    # 0..1: how ragged the spreading edge runs (each 8 m step's wait varies by up to this share either way; 0 = an even diamond)

[fire_bomb]
# Press F during the outbreak and aim exactly like the A strike. The plane drops
# `count` bombs, each a fire patch `radius` world units across, scattered sideways off the
# strip's centreline by up to `scatter` world units so they land as a ragged swath rather
# than a neat line. These are ABSOLUTE values, independent of the [airstrike] keys -- editing
# the standard airstrike never changes the fire bomb. A bomb does NOT blast: it lays a
# patch of burning ground that glows orange/red and burns any unit that stands in it
# ([fire]) -- zombie, civilian, or your own police -- for burn_seconds, and spreads over
# any greenspace it lands on. Buildings are untouched.
# How a patch is drawn (its flames, sparks and smoke): [particles] fire_* and [art]
# fire_sprite / fire_smoke_sprite. All hot-reload.
sp_cost       = 1    # SP per level of FIRE BOMB: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest FIRE BOMB level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 60), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds = 30.0    # battle unlock: real seconds at 1x (real time) after the outbreak starts before a fire bomb can be called
arrival_seconds = 12.0   # arrival: sim seconds from the click until the first fire bomb lands (0 = the plane's own fly-in and fall); longer, it waits before it sets off
count          = 30      # bombs dropped per strike
damage         = 10      # bridge health each fire bomb takes off every span its patch touches (see [bridge]); its fire burns zombies by [fire]'s keys, not this
radius         = 48.0    # each fire patch's radius, world units
scatter        = 21.0    # sideways landing spread off the centreline, world units
burn_seconds   = 40      # how long each patch burns

[cluster_bomb]
# A battle deployable: arm it during the outbreak and drag a target strip exactly like the
# airstrike. The plane drops `count` small bombs, scattered sideways off the strip's centreline
# by up to `scatter` world units (and a little along it) so they land as a ragged cluster, like
# the fire bomb's. Each one is a small white flash of radius `radius` that kills everything
# inside -- zombies (minus `damage` health), civilians AND your own police / vehicles -- like an
# airstrike bomb, but it is too small to hurt a building: it is left standing, and a fuel
# building it hits doesn't go up. It does wear its `damage` off each part of a wall or gate in
# its blast (and off each bridge span it touches), so a run across a wall breaches it where several bombs land. These are ABSOLUTE values, independent of the [airstrike] keys. Each run
# spends a charge, which recharges (cooldown_seconds). All hot-reload.
sp_cost        = 2      # SP per level of CLUSTER BOMB: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest CLUSTER BOMB level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 90), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds = 45.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a cluster bomb can be called
arrival_seconds = 12.0  # arrival: sim seconds from the click until the first bomblet lands (0 = the plane's own fly-in and fall); longer, it waits before it sets off
count          = 72     # bombs dropped per strike
radius         = 22.0   # kill + white-flash radius of each bomb, world units (the airstrike's is 140)
scatter        = 30.0   # sideways landing spread off the centreline, world units
damage         = 40.0   # health each bomb takes off each zombie in its blast -- and off each wall / gate cell in it (walls.hp is 1200) and each bridge span it touches (see [bridge]); everyone else in it dies

[ac130]
# The AC-130 gunship, a battle deployable: arm it during the outbreak and drag a target strip
# exactly like the airstrike. A big, slow gunship flies in along the strip at plane_speed and
# fires `count` missiles off it, one for each of `count` spots spaced evenly along the strip.
# Each missile, as it is fired, locks onto the thickest crowd of zombies within seek_radius of
# its spot (zombies already under a missile on its way don't count), or its spot if there are
# none. It fires each one fire_ahead world units short of its spot, so the missiles streak
# forward and down ahead of it for missile_seconds. Each missile is a white flash of radius `radius` that
# kills everything inside -- zombies (minus `damage` health), civilians AND your own police /
# vehicles -- and wears its `damage` off every building (a building worn out is levelled, like
# a mortar's), wall or gate cell and bridge span in it, and sets off a fuel building it hits.
# These are ABSOLUTE values, independent of the [airstrike] keys. All hot-reload.
# How it looks: [art] ac130_*, [colors] ac130 / ac130_missile.
sp_cost         = 3      # SP per level of AC-130: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max             = 0      # highest AC-130 level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 120), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges         = 1      # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds  = 45.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before an AC-130 can be called
arrival_seconds = 8.0   # arrival: sim seconds from the click until the first missile hits (0 = the gunship's own fly-in and the missile's flight); longer, it waits off the map before it sets off
count           = 30     # missiles fired per flyover
radius          = 35.0   # kill + white-flash radius of each missile, world units (the airstrike bomb's is 140, the cluster bomb's 22)
seek_radius     = 150.0  # how far round its spot on the strip each missile looks for the thickest crowd of zombies to hit, world units (0 = it hits its spot)
damage          = 60.0   # health each missile takes off each zombie in its blast (zombie.hp_max is 30) -- and off each building (building_hp), wall / gate cell (walls.hp is 1200) and bridge span it touches (see [bridge]); everyone else in it dies
plane_speed     = 220.0  # the gunship's speed, world units/sec (the airstrike bomber's is 640)
fire_ahead      = 450.0  # the gunship fires each missile this many world units short of its landing spot, along its flight, so they streak down ahead of its nose (0 = straight down as it passes over)
missile_seconds = 1.0    # a missile's flight from the gunship to the ground, seconds (0 = it hits the moment it is fired)

[gas_bomb]
# Press N during the outbreak, click the target (the drag only sets the plane's
# approach direction). One bomb lands on the click and lays a gas cloud `radius` across
# for `duration` seconds: every unit inside it -- police,
# civilians, and zombies alike -- is immobilized (no movement, no bites, no gunfire)
# until the cloud dissipates. Nothing is killed. How the cloud is drawn: [particles]
# gas_* and [art] gas_wisp_sprite. All hot-reload.
sp_cost       = 1    # SP per level of GAS BOMB: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest GAS BOMB level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 45), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds = 30.0    # battle unlock: real seconds at 1x (real time) after the outbreak starts before a gas bomb can be called
arrival_seconds = 10.0   # arrival: sim seconds from the click until the gas bomb lands (0 = the plane's own fly-in and fall); longer, it waits before it sets off
radius         = 350.0   # the cloud's radius, world units
duration       = 60      # how long the cloud lasts
damage         = 0      # bridge health the gas bomb takes off every span its cloud touches (see [bridge]); the gas stuns zombies, it takes no health off them

[cruise_missile]
# A battle deployable: arm it during the outbreak and click a spot. A missile flies in from
# off screen in a straight line and, flight_seconds later, blows up there: a white flash of
# radius blast_radius that kills everything inside -- zombies, civilians, AND your own police /
# vehicles -- levels any building it covers by more than building_destroy_fraction and
# flattens the walls and gates in it, just like one airstrike bomb. Far quicker than an airstrike (no plane, no fall), with a smaller
# blast (about 40% of the airstrike's). Each missile spends a charge; each level gives charges_per_level of them (3).
# Its image is [art] missile_sprite. All hot-reload.
sp_cost                   = 2      # SP per level of CRUISE MISSILE: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max                       = 0      # highest CRUISE MISSILE level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 60), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 3    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds            = 30.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a missile can be fired
flight_seconds            = 2.5    # arrival: seconds from the click until it hits (it is the missile's arrival time; it has no arrival_seconds)
speed                     = 800.0  # world units/sec it flies at; it starts speed x flight_seconds away, off screen
blast_radius              = 56.0   # kill + white-flash radius, world units
damage                    = 100.0  # health the blast takes off each zombie in it -- and off each bridge span it touches (see [bridge]); everyone else in it dies
building_destroy_fraction = 0.30   # blast must cover this fraction of a building to level it

[helicopter]
# The helicopter (Stage 11) is a called-in gunship run: press H, then click to
# designate its target -- it flies in from off the nearest screen edge (a "0:34"
# arrival ETA shows by the cursor while you aim) and brakes to a hover on it, then hunts
# on its own: it parks over the middle of the zombies inside the circle it was aimed with
# (leash_radius round the clicked point) and leaves that circle only while no zombie is in
# it, then hunting the zombies within leash_radius of itself, carving the horde with an aiming reticle until its
# ammo runs out, then flies off the map, rearms there for rearm_seconds and flies back. All hot-reload live. fire_rate is shots per second.
unlock_seconds      = 30.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a gunship can be called (stocked or not); separate from aircraft.flyin_seconds
arrival_seconds     = 10.0   # arrival: sim seconds from the click until the gunship is over the spot (0 = its own fly-in); longer, it waits before it sets off
sp_cost       = 2    # SP per level of HELICOPTER: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest HELICOPTER level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 90), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed               = 260.0  # cruise speed while hunting and leaving (it flies over everything); the fly-in leg uses its own speed, set by aircraft.flyin_seconds
hp                  = 40.0   # health against blasts; only a nuke's shockwave climbs high enough to hurt it, and one worn to 0 is shot down
turn_rate           = 1.6    # radians/sec its nose swings toward where it is heading; it gathers speed only as the nose comes round, so lower = slower, wider turns (a stopped heli turns on the spot)
accel               = 200.0  # world units/sec^2 its velocity may change by -- speeding up, braking, or changing course -- so it moves with momentum and coasts into a hover instead of stopping dead
fire_rate           = 50.0   # gatling rounds/sec while a zombie is under the reticle
magazine            = 200    # RELOAD: rounds the gatling fires before it reloads, like a garrison's magazine (0 = never reloads, and never runs out); the gunship keeps hunting while it reloads
max_reloads         = 3      # OUT OF AMMO: reloads it carries (this many magazines and one more), like garrison.max_reloads; once the last magazine is spent it flies off the map to rearm (rearm_seconds). -1 = no limit
reload_seconds      = 3.0    # sim seconds a reload holds its fire (it takes the place of the gap after the round that emptied it)
rearm_seconds       = 30.0   # sim seconds a dry gunship spends off the map rearming before it flies back to its circle with all its reloads, for as long as the battle lasts (0 = it never comes back: it despawns once off the map)
leash_radius        = 560.0  # how far the aiming reticle may roam from the helicopter, and the radius of the circle it was aimed with that it stays in while a zombie is there
reticle_radius      = 14.0   # the reticle's circle: each round hits every zombie inside (damage below), and any civilian inside dies at once
damage              = 10.0    # health each round takes off each zombie under the reticle (a shielded zombie's shield cuts each round): at 1 zombie health one round kills, at the 100 cap twenty do
reticle_speed       = 120.0  # reticle grind speed while firing into a group; it repositions between groups several times faster

[apc]
# The armored personnel carrier: a battle deployable (press 8 during the outbreak, then
# click open ground -- a street, never a roof or water). A transport flies in and drops it
# by parachute; it lands and hunts the horde on its own until its ammo runs out: it
# drives the streets to the biggest zombie pack it can reach (never one across water with
# no bridge, or inside a sealed pocket), and its four machine guns fire at the zombies
# within `range` of it, each gun at a different zombie. Its guns never reload in the field:
# once they have fired `ammo` rounds between them it is drawn dim, an "Out of ammo" label
# rises off it, and it drives to the nearest safe zone it can reach, stands there
# `rearm_seconds` and goes back to hunting with full ammo (with no zone to reach -- none
# placed, or every one breached -- it drives off the map instead). It is armored -- zombies can't
# bite it, stun gas and fire don't touch it -- but an airstrike bomb, a mine or a C4 charge
# that goes off over it destroys it, and a bridge sinking under it takes it into the river.
# Like the officers it drives through your own walls. All hot-reload.
unlock_seconds = 15.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before an APC can be dropped (stocked or not)
arrival_seconds = 10.0  # arrival: sim seconds from the click until it touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off
sp_cost       = 3    # SP per level of APC: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max           = 0      # highest APC level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 150), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed          = 45.0   # top driving speed, world units/sec (officer.speed is 40)
hp             = 40.0   # health against blasts: an airstrike bomb, a cruise missile, a mine, a C4 charge, a fuel blast or a nuke takes its zombie damage off it, and one worn to 0 is destroyed (40 = any one of them)
turn_rate      = 2.5    # radians/sec the hull turns; it slows while turning and pivots in place at a sharp corner
accel          = 60.0   # world units/sec^2 its speed ramps up and brakes down by
seek_radius    = 400.0  # how far around itself it looks for the pack to hunt, world units (a much longer look runs only when nothing it can reach is in here)
range          = 160.0  # each gun fires at the nearest zombie this close, world units
fire_cooldown  = 0.15   # seconds between one gun's rounds (four guns, each firing this fast)
damage         = 10.0   # health a hit takes off a zombie (2x the garrison's)
accuracy       = 0.9    # 0..1 chance a round connects
magazine       = 600    # RELOAD: rounds its four guns fire between them before it reloads, like a garrison's magazine (0 = never reloads, and never runs out); it keeps driving while it reloads
reload_seconds = 5.0    # sim seconds a reload holds all four guns' fire
max_reloads    = 3      # OUT OF AMMO: reloads it carries (this many magazines and one more), like garrison.max_reloads; once the last magazine is spent it drives to a safe zone to rearm. -1 = no limit
rearm_seconds  = 10.0   # seconds a dry APC stands in a safe zone before it has all its reloads again and hunts (sim seconds)

[rally]
# A battle deployable: arm it during the outbreak and click a spot. For `duration` seconds
# every gun standing inside a `radius` circle round it fires attack_speed_percent faster:
# officers and paratroopers, garrisons, snipers, mortars, Turrets, the battleship, the APC
# and the helicopter. It speeds up the rounds between reloads only (reloads take as long as
# ever) and comes on top of a gun's own fire rate, its stack level and its upgrades. The
# circle shows on the ground while it lasts; a gun counts while it stands inside it, so an
# officer walking in speeds up and one walking out slows down. Two rallies over the same gun
# don't add up: it takes the stronger. Each use spends a charge, which recharges,
# and a click with no gun in the circle spends nothing. All hot-reload.
sp_cost              = 2       # SP per level of RALLY: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max                  = 0      # highest RALLY level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 90), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds       = 20.0    # battle unlock: real seconds at 1x (real time) after the outbreak starts before a rally can be called
arrival_seconds      = 0.0     # arrival: sim seconds from the click until the rally takes hold (0 = at once); longer, it waits before it sets off
radius               = 200.0   # the circle's radius, world units (an airstrike bomb's blast is 140)
duration             = 10.0    # seconds it lasts (sim seconds: 4x speed burns it down four times as fast)
attack_speed_percent = 50.0    # +percent rounds a second for every gun inside (50 = one and a half times as many)
[bus]
# The Security Bus: a battle deployable (put it on a battle key in the LOADOUT, then during
# the outbreak click open ground -- a street, never a roof or water). A transport drops it
# by parachute like the APC, and it drives itself on the APC's routing: to the biggest crowd
# of civilians still outside the safe zones it can reach, then from one civilian there to
# the next. It has no guns. Every civilian within `pickup_radius` of it -- not one already
# sheltering in a calm safe zone, nor one across a wall or a building -- boards at once; a
# bitten one never boards. Once it holds `capacity` it drives them to the nearest safe zone
# no breach has opened, sets them all down inside it and drives back out for more. With no such zone (or failing to get into one
# in a minute plus three times the straight run there) it drives off the nearest map edge
# instead, its riders counted as saved. Armored like the APC: zombies can't bite it, but an
# airstrike bomb, a mine or a C4 charge over it destroys it (the riders aboard stay counted
# as saved). It drives through your own walls. Drawn with the APC's image (art.apc_sprite),
# tinted colors.bus, until it has art of its own. All hot-reload.
unlock_seconds = 15.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a bus can be dropped (stocked or not)
arrival_seconds = 10.0  # arrival: sim seconds from the click until it touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off
sp_cost        = 3      # SP per level of Security Bus: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest Security Bus level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 150), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed          = 40.0   # top driving speed, world units/sec (apc.speed is 45)
hp             = 40.0   # health against blasts, like apc.hp: one worn to 0 is destroyed (its riders stay counted as saved)
turn_rate      = 2.5    # radians/sec the hull turns; it slows while turning and pivots in place at a sharp corner
accel          = 50.0   # world units/sec^2 its speed ramps up and brakes down by
seek_radius    = 500.0  # how far around itself it looks for civilians outside the safe zones, world units (a much longer look runs only when nobody it can reach is in here)
pickup_radius  = 6.0    # a civilian this close to the bus boards it, world units (the bus is drawn 16 m long)
capacity       = 400    # civilians it carries before it drives them to a safe zone (0 = no limit: it never goes)

[medevac]
# The medevac chopper: a battle deployable (put it on a battle key in the LOADOUT, then during
# the outbreak click any spot -- a hot spot where civilians are caught in the open). A chopper
# flies in from off the nearest screen edge and hovers over the spot, taking on up to
# `capacity` civilians within `pickup_radius` of it, the nearest first (never one a zombie has
# bitten, nor one already sheltering in a safe zone). It keeps hovering, full or not, until you
# order it off: select it and press Leave Now on its stats panel. Then it flies them to
# the open ground inside a safe zone (one no breach has opened) nearest the spot, sets them
# down there and flies off the map. Should that part of the zone be breached by the time it
# gets there it looks once more; with no safe zone left anywhere it flies its riders off the
# map, where they count as saved. A civilian in the air counts as alive. It flies over
# everything and nothing can hurt it; it has no gun and never reloads. Drawn with the
# helicopter's image, tinted colors.medevac, until it has art of its own. All hot-reload.
unlock_seconds = 20.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a medevac can be called (stocked or not)
arrival_seconds = 10.0  # arrival: sim seconds from the click until it is over the hot spot (0 = its own fly-in); longer, it waits before it sets off
sp_cost        = 3      # SP per level of Medevac: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest Medevac level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 150), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed          = 180.0  # cruise speed, world units/sec (helicopter.speed is 260)
hp             = 40.0   # health against blasts; only a nuke's shockwave climbs high enough to hurt it, and one worn to 0 is shot down with its riders
accel          = 150.0  # world units/sec^2 its velocity may change by (it moves with momentum and coasts into a hover)
turn_rate      = 1.6    # radians/sec its nose swings toward where it is heading
capacity       = 200    # civilians it carries in one run (bus.capacity is 400); full, it hovers until ordered off
pickup_radius  = 40.0   # a civilian this close to the spot boards while it hovers, world units

[bulldozer]
# The bulldozer: a battle deployable (put it on a battle key in the LOADOUT, then during the
# outbreak click open ground where it lands -- a street, never a roof or water -- and click
# again where its route ends). A transport drops it by parachute like the APC. It drives its
# route in a straight line, killing every zombie within `crush_radius` of it (civilians it
# passes are left alone). A building no bigger than `max_building_area` in its way it pushes
# into, standing still while it wears `damage` a second off it, and levels it once it
# is worn to its health ([building] hp, by its height; as a blast levels one: a garrison on it falls) -- then drives on over
# the ground it opened. Anything it can't push (a bigger building, water, a sealed pocket)
# sends it round by the streets to the route's end instead. Once there it hunts the biggest
# zombie pack it can reach like the APC, crushing what it drives over. Armored like the APC:
# zombies can't bite it, but an airstrike bomb, a mine or a C4 charge over it destroys it. It
# drives through your own walls. Drawn with the APC's image (art.apc_sprite), tinted
# colors.bulldozer, until it has art of its own. All hot-reload.
unlock_seconds    = 20.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a bulldozer can be dropped (stocked or not)
arrival_seconds   = 10.0   # arrival: sim seconds from the click until it touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off
sp_cost           = 3      # SP per level of Bulldozer: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max               = 0      # highest Bulldozer level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 150), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed             = 30.0   # top driving speed, world units/sec (apc.speed is 45)
hp                = 40.0   # health against blasts, like apc.hp: one worn to 0 is destroyed
turn_rate         = 2.0    # radians/sec the hull turns; it slows while turning and pivots in place at a sharp corner
accel             = 40.0   # world units/sec^2 its speed ramps up and brakes down by
seek_radius       = 400.0  # once its route is done: how far around itself it looks for the pack to hunt, world units
crush_radius      = 5.0    # a zombie this close to its middle dies at once, world units (the bulldozer is drawn 16 m long)
damage            = 250.0  # building health a second it wears off a building it pushes into (a 9 m house, 960 health, in about 4 s)
max_building_area = 400.0  # the biggest building it can push down: its bounding box, square meters (a 20 x 20 m house)

[tank]
# The tank: a battle deployable (put it on a battle key in the LOADOUT, then during the outbreak
# click open ground -- a street, never a roof or water). A transport drops it by parachute like
# the APC, and it hunts the horde on its own the same way: it drives to the biggest zombie pack
# it can reach. Every `fire_cooldown` its gun fires a shell at the pack inside its ring
# (`min_range` to `range`) where the blast catches the most zombies, led over the shell's
# flight like the mortar's -- once its turret has turned to point there (`turret_turn_rate`;
# the hull turns on its own, the way it drives, at `turn_rate`). A shell splashes like a mortar shell: each zombie within
# `blast_radius` takes `damage`, each civilian there dies, and your own units are spared; it
# wears the buildings in its splash down by `damage` like a mortar shell, but never a wall. It never reloads: once it has fired `ammo` shells it is drawn
# dim and drives off the map, like the APC. A Rally around it speeds its gun up. Heavy
# armor: zombies can't bite it, and it has far more health (hp) against blasts than the APC;
# enough bombs, or a nuke, destroy it, and so does a bridge sinking under it. It drives
# through your own walls. Drawn with its own hull and turret images (art.tank_sprite,
# art.tank_turret_sprite). All hot-reload.
unlock_seconds = 30.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a tank can be dropped (stocked or not)
arrival_seconds = 10.0  # arrival: sim seconds from the click until it touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off
sp_cost        = 4      # SP per level of Tank: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest Tank level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 180), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
speed          = 30.0   # top driving speed, world units/sec (apc.speed is 45)
hp             = 250.0  # health against blasts, like apc.hp, but heavy armor: 250 shrugs off two airstrike bombs (100 each) and falls to the third, or to a nuke
turn_rate      = 1.8    # radians/sec the hull turns; it slows while turning and pivots in place at a sharp corner
accel          = 40.0   # world units/sec^2 its speed ramps up and brakes down by
seek_radius    = 400.0  # how far around itself it looks for the pack to hunt, world units
range          = 220.0  # farthest a shell lands, world units
min_range      = 30.0   # nearest a shell lands, world units (it won't shell a pack on top of itself)
fire_cooldown  = 2.5    # seconds between shells
blast_radius   = 30.0   # a shell's splash radius, world units (mortar.blast_radius is 40)
damage         = 60.0   # health a shell takes off each zombie in its splash
flight_seconds = 0.4    # seconds a shell flies before it lands
magazine       = 12     # RELOAD: shells it fires before it reloads, like a garrison's magazine (0 = never reloads, and never runs out)
reload_seconds = 8.0    # sim seconds a reload holds its fire (it takes the place of the gap after the shell that emptied it)
max_reloads    = 2      # OUT OF AMMO: reloads it carries (this many magazines and one more), like garrison.max_reloads; once the last magazine is spent it drives off the map. -1 = no limit
turret_turn_rate = 1.5  # radians/sec its turret turns (1.5 = about 86 degrees a second, a half turn in about 2 s); the gun fires only once the turret points at its aim, and the hull turns separately (turn_rate). 0 = the turret swings round at once

[cure]
# The Cure: a battle deployable. Arm it during the outbreak and click the zombies: a plane
# flies in and drops a canister there (the gas bomb's run: [airstrike] aircraft_flyin_seconds
# and fall_seconds), which bursts into a blue gas cloud (colors.cure_gas) `radius` across that
# lingers on the ground for `cloud_seconds`. Every zombie in the cloud is cured, and so is every
# one that walks into it while it lingers (the cloud looks again every `cloud_look_seconds`). A cured zombie turns dark green (colors.cure), darkens to black (colors.cure_dead) as
# its `duration` runs out and then dies; until then it still walks and bites like any other.
# The cure spreads: every `spread_seconds` a cured zombie looks at the zombies within
# `contact_radius` of it (in a crowd: a zombie alone in the open is out of reach) and each one
# catches the cure with `spread_chance`. The zombies the cloud cured are generation 0, the
# ones they pass it to generation 1, and so on; one at `max_generations` passes it on no
# further (0 = no limit). `contact_radius` is the main lever: a zombie stream is spaced wider
# than the zombies' touch, so at 1 m the cure stays in the pile it was dropped on and at 3-5 m
# it runs down the streams. Its cost grows with the cured zombies that still have uncured ones
# within contact_radius, times contact_radius squared; a pile cured through costs little.
# Each drop's cure wanes: a zombie that catches it `wane_seconds` after the landing or later
# dies on the spot, so the spread burns out. Each drop spends a charge, which recharges
# (cooldown_seconds). All hot-reload.
unlock_seconds  = 45.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before The Cure can be cast
arrival_seconds = 12.0   # arrival: sim seconds from the click until the canister lands (0 = the plane's own fly-in and fall); longer, it waits before it sets off
sp_cost         = 5     # SP per level of THE CURE: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max             = 0      # highest THE CURE level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 300), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
radius          = 20.0   # the gas cloud's radius, world units: every zombie inside is cured
cloud_seconds   = 10.0   # seconds the gas cloud lingers on the ground (it fades over its last fifth), curing every zombie in it and every one that walks in
cloud_look_seconds = 0.5 # seconds between the lingering cloud's looks for zombies that walked into it (each look checks every unit: lower costs more)
duration        = 15.0   # seconds a cured zombie lives before it dies
wane_seconds    = 60.0   # seconds after the landing until its cure is spent: a zombie catching it lives `duration` shrunk in a straight line to 0 over this time, so late carriers die at once and the spread stops (0 = never wanes)
spread_seconds  = 0.5    # seconds between a cured zombie's looks for zombies to pass it on to
spread_chance   = 1.0    # 0..1 chance each zombie in reach of a cured one catches the cure, per look
contact_radius  = 5.0    # world units: how near a zombie must be to a cured one to catch it
max_generations = 0      # hand-ons from the cast the cure spreads (0 = no limit)

[nuke]
# The nuke: a battle deployable. Arm it during the outbreak and click a spot: nothing flies in,
# but delay_seconds later it goes off there -- a mushroom cloud ([mushroom], drawn cloud_scale
# times its size) and a shockwave that rolls out from the spot at wave_speed until it has
# reached `radius`. In its last fall_seconds a shell (art.shell_sprite, the mortar's) drops
# straight down onto the spot from fall_height. Every unit the shockwave reaches dies, the player's own included (a mine
# aside), and so do the walls and the machines -- the APC and the tank (worn past their hp), and
# the helicopters and the medevacs overhead too; every bridge span it reaches sinks (whatever
# health it has). Each building it reaches takes damage, fading to damage_edge
# at `radius`, against its own health ([building] hp plus hp_per_m for each meter it
# stands): one worn to 0 is levelled and falls AWAY from the blast ([topple]; any other blast
# pulls a building toward it). Far out it levels only the low buildings and the towers stand,
# so the edge of the ruin is ragged. The greenspace it passes over is burnt off, as fire
# leaves it, with no fire; a pond or lake wholly inside `radius` dries up the moment it goes
# off (colors.dried_water; still water to the units: nobody walks its bed). After a nuke the
# battle's mosh pits start three times as often. The camera shakes when it goes off (shake_px). The shipped radius is three times the cloud's ground ring
# (mushroom.skirt_radius 220 m x cloud_scale 3 = 660 m), about 4 km across. Its target ring counts down in colors.nuke;
# the shockwave is a ring in colors.nuke_wave. Each nuke spends a charge, which recharges
# (cooldown_seconds). All hot-reload.
unlock_seconds  = 90.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before a nuke can be called
sp_cost         = 15     # SP per level of NUKE: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max             = 0      # highest NUKE level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 480), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
delay_seconds   = 45.0   # arrival: game seconds from the click until it goes off (its target ring counts them down); the longest arrival of any ability
radius          = 1980.0 # meters the shockwave reaches from the blast: everything inside dies or falls
wave_speed      = 800.0  # meters a second the shockwave rolls out (1980 m at 200 m/s: about ten seconds)
damage          = 40000.0 # health the shockwave takes off a building it reaches right at the blast (past the tallest's, 828 m: 33720); it levels it at 0 and pushes it over AWAY from the blast ([topple])
damage_edge     = 800.0 # ...fading to this at `radius`, as the square of the distance left (strong most of the way out, falling off at the end): under a house's health, so at the very edge only sheds fall
shake_px        = 6.0    # the screen shake when it goes off: how far (pixels on screen) the camera jolts at first; the ACCESSIBILITY tab's Screen shake turns it off
shake_seconds   = 1.2    # ...dying away over this many real seconds (0 = no shake)
cloud_scale     = 3.0    # its mushroom cloud is drawn this many times the [mushroom] cloud's size (3.0: about 1 km tall, its dust ring 660 m out)
fall_seconds    = 1.5    # game seconds the shell takes to drop onto the spot, at the end of delay_seconds (0 = no shell)
fall_height     = 1500.0 # meters up the shell starts its drop

[decoy]
# Press C during the outbreak, then HOLD the left button: exactly the paratrooper spray,
# but every puff queues an ordinary CIVILIAN that parachutes in on release -- bait that
# draws the horde toward it (they wander, panic, and get bitten like anyone else, and
# each one landed is added to the SAVED quota's head count, so losing them costs you).
# Battle phase only. spray_rate is deliberately far below paratroopers.spray_rate. Puffs on
# buildings, water, walls, or off-limits ground are skipped (a decoy can't be put where
# zombies can't reach it). Each decoy draws one head of decoy stock, which only the admin
# console's "give stock" hands out. All hot-reload.
spray_radius   = 40.0    # decoys land at random inside this radius (world units) around the cursor
spray_rate     = 3.0     # decoys laid per real second while the button is held (the first lands at once)
unlock_seconds  = 0.0    # battle unlock: real seconds at 1x (real time) after the outbreak starts before decoys can be dropped
arrival_seconds = 8.0    # arrival: sim seconds from the release until the first decoy touches down (0 = the transport's own fly-in and descent); longer, it waits before it sets off

# ======================================================================================
# THE PEOPLE -- zombies, civilians, and the fields the horde and the crowd steer by
# ======================================================================================

[zombie]
# A zombie: how tough and fast it is, how it bites, and how close it lets another stand.
# How it hunts is [flock], [scent] and [flow]; where the outbreak starts, [outbreak].
# (No civilian speed key here: a panicked civilian's flee speed is hard-coded at half of
# zombie.speed -- sim.FLEE_SPEED_OF_ZOMBIE in src/sim/units.odin -- reached at
# civilian.panic_threshold; calm civilians walk at civilian.calm_speed.)
hp               = 1.0     # a zombie's health when the battle starts (each hit takes its weapon's damage off; at 0 it dies)
hp_growth_per_minute = 3.0 # health EVERY zombie gains per sim minute of battle, a second's worth at a time (a wounded one keeps its wounds): with garrison.damage 5 and hp_growth_delay 60 a garrison kills in one hit for the first 2 min 20 s, two until 4 min, three until 5 min 40 s. 0 = never grows
hp_growth_delay  = 60.0    # sim seconds from READY before the health starts to grow at all: every zombie holds at hp until then. 0 = it grows from the first tick
hp_max           = 30.0    # the health the growth stops at (reached at 10 min 40 s with hp 1, hp_growth_per_minute 3 and hp_growth_delay 60)
mutated_hp_multiplier = 3.0 # a mutated zombie's health (explosive, shielded, swimmer; a giant has giant_zombie.hp_multiplier) is the horde's times this: it turns with that much and grows this many times as fast
speed                   = 26.0   # world units per second (random wander)
speed_jitter            = 12.0    # world units per second: each zombie walks at zombie.speed give or take up to this much, its own speed for the whole battle (rolled from the outbreak seed, so a RETRY of the same outbreak repeats it); 0 = every zombie alike
move_every              = 2      # a zombie moves once every this many 1/60 s steps, taking that many steps' worth of walk at once (1, 2 or 4; never more than most of a 2 m obstacle cell in one step, so no zombie can step over a one-cell wall). The sim ticks every 2 steps (30 a simulated second), so 1 and 2 both move a zombie every tick (30 times a simulated second) and 4 every other tick
lod_meters              = 250.0  # far-zombie detail level: a zombie with no civilian, officer or wall within about this many meters (straight line, on the hunt's coarse crowd cells) is a far zombie -- it moves only every lod_every ticks, by that many ticks' walk, keeps no personal space and runs no bite scan. The battle is the same on every machine either way (0 = off)
lod_every               = 4      # ticks between a far zombie's moves (2, 4 or 8; the sim ticks 30 times a simulated second); 1 = off
pile_rest_ticks         = 3      # a zombie deep in a pile (three or more zombies pressing on it, as in the block of horde before a wall it is chewing) that walked into the zombie ahead and got nowhere holds still this many of its moves before it tries again (any other that got nowhere: 3). Most of a siege's horde stands there, so a higher value makes a big siege cheaper to simulate (8: a late New York stage 11 siege tick 47 -> 37 ms on a 4-thread PC), but the pile then unpeels slower, rows at a time, when its target moves or its wall breaks -- it plays differently. 3 or less = off. The battle is the same on every machine either way
infection_touch_radius  = 3.0    # zombie this close to a civilian starts a bite
infection_pause_seconds = 0.1    # both freeze this long, then the civilian turns green
corpse_fade_seconds = 0.0  # a dead zombie is removed after this long (0 = never)
# The horde's personal space: zombies in a crowd keep about `spacing` meters apart, so a
# horde still gathers -- a crowd filling the street, a block of zombies in front of the wall it
# is chewing -- but never stacks on itself. Without it the flow field steers a whole horde down
# one line and a pile at a wall stands hundreds deep on one spot, which is what let one mortar
# shell kill thousands. After each step, a zombie that walked into one ahead of it is put back
# out of it, and two side by side much closer than the spacing are eased apart. A crowd packs
# to roughly one zombie per spacing x spacing square, so what one 40 m mortar blast can catch
# falls with the square of the spacing: on New York's second stage the fullest 40 m circle held
# up to ~4,400 zombies with 0, ~1,400 at 2 m, ~770 at 3 m (tools/clumpdump). It applies only
# where zombies crowd (7 or more in a 32 m square); a thin scatter moves as before. It also
# spreads a horde pressing on a wall along the wall, so fewer zombies chew each wall cell and
# walls hold longer: the same stage's 200 m safe zone fell at 1:52 with 0, 3:31 at 2 m, 4:02 at
# 3 m -- walls.pressure_per_zombie_second (the crowd behind the front row pushes it into
# the wall) makes up for it, so a big horde still breaks a wall fast.
# 0 = off: zombies stack freely, as before. Hot-reloads.
spacing                 = 1.0    # world units (meters on a city map); 0 = off

[explosive_zombie]
# The explosive zombie: a purple, glowing zombie that blows up the moment it reaches a wall.
# Zombies turn explosive only in a mosh pit ([mosh_pit]). It hunts like any zombie, but on
# leaning on a wall it dies in a small blast that takes wall_damage_percent of its full health
# off each wall cell (so it hurts a fortified wall as much as a plain one) and `damage` off
# each building inside blast_radius (times the share of a building it
# covers, like a mortar shell; [building] hp levels one). The blast harms no unit -- no
# civilian, zombie, officer or gun -- except the ones on a building it levels, so any number
# of explosive zombies at a wall each go off on their own, and never set each other off.
# Its health is zombie.mutated_hp_multiplier times the horde's.
# Hot-reloads.
blast_radius         = 9.0     # world units (meters on a city map): the blast's reach round where it stood -- 18 m across, three dots (dots.size 6) wide
damage               = 200.0   # damage to a building the blast covers whole (a share for one it covers in part); 0 = none
wall_damage_percent  = 10.0    # percent of a wall cell's full health (its fortify level's, walls.hp x the level multiple) the blast takes off each wall cell inside it, gates included: 10 = a tenth at every level; 0 = none
glow_radius_px       = 9.0     # screen pixels: the purple glow round its dot, the same size at every zoom (0 = no glow)
glow_alpha           = 0.7     # 0..1 the glow's opacity at its middle (it fades to nothing at its rim)

[shielded_zombie]
# The shielded zombie: a yellow zombie a mosh pit turns ([mosh_pit] shielded_weight). Its shield
# comes off every hit it takes, from a gun or a blast: with 4 health and a shield of 4, a hit
# of 5 takes 1 and leaves 3. A hit no bigger than the shield does nothing (at 3, a Turret's 4
# takes 1 and a garrison's 5 takes 2), so the heavy guns and blasts are what wear it down. It
# turns with zombie.mutated_hp_multiplier times the horde's health. Fire burns through the shield ([fire] damage_per_second, all of it), and the
# helicopter still kills it outright.
# Hot-reloads.
shield = 3.0   # health the shield takes off each hit it takes (0 = none)

[giant_zombie]
# The giant zombie: a mosh pit ([mosh_pit] giant_weight) merges every merge_count of its
# zombies into one, holding hp_multiplier times the horde's health (in place of
# zombie.mutated_hp_multiplier: with zombies at 30, a giant of 270), and the rest vanish; a remainder too few to merge goes back to hunting as it was. It is drawn
# as a wide disc under its dot; to the sim it is one zombie of the usual size and speed.
# Hot-reloads.
merge_count    = 10     # moshing zombies merged into each giant
hp_multiplier  = 9.0    # a giant's health is the horde's times this (zombie.hp grown so far): it turns with that much and grows this many times as fast; overrides zombie.mutated_hp_multiplier for giants
size           = 14.0   # world units: how wide a giant is drawn (a dot is dots.size 6)
min_pixel_size = 5.0    # screen pixels: the narrowest it is drawn, zoomed far out (a dot is at least dots.min_pixel_size)
max_pixel_size = 14.0   # screen pixels: the widest it is drawn, zoomed close in (a dot is at most dots.max_pixel_size 6)

[swimmer_zombie]
# The swimmer zombie: a hot-pink zombie a mosh pit turns ([mosh_pit] swimmer_weight) that crosses
# water, which holds every other zombie back. It hunts like any zombie while the walk to prey is
# short; where water cuts the prey off, or a swim saves more than shortcut_meters on the walk round
# by a bridge, it swims there by its own coarse field, and climbs out on any shore -- walls are
# never laid on water, so a safe zone's edge along a river or the sea is open to it. It turns with
# zombie.mutated_hp_multiplier times the horde's health. Cost: nothing until one turns; then its field's search runs again
# every field_seconds, spread over that long (a few hundred cells a tick on all of New York), and
# the field is a few MB, built at map install.
# Hot-reloads.
water_slow      = 0.4     # 0..1 the share of its speed it loses in water (0 = swims as fast as it walks)
shortcut_meters = 20.0    # world units (meters on a city map): it swims, rather than walks round, when that saves more than this
field_cell_size = 48.0    # world units: its coarse water-and-land field's cell edge; coarser is cheaper but cuts corners on land; 0 = no field (it never sets off into water)
field_seconds   = 10.0    # sim seconds between the field's searches for the prey (each spread over that long): how stale the way it swims can get

[mosh_pit]
# A mosh pit: zombies stop hunting, gather and churn round one spot, and when its time runs
# out every one of them turns the pit's type and goes back to hunting -- the player's chance
# to hit a packed crowd that holds still. A pit's type is rolled when it starts, by the four
# weights below: explosive ([explosive_zombie]), shielded ([shielded_zombie]), merged into
# giants ([giant_zombie]) or swimmer ([swimmer_zombie]). The first pit a player ever meets pauses the battle with a tip;
# every later one drops a toast that moves the camera to it when clicked.
# Every check_seconds of battle a pit
# starts with this stage's chance: none on a campaign's first buffer_stages stages (a standalone
# map is one stage), then rising in even steps to chance_percent_last_stage on its last stage,
# however many stages it has -- at 1 and 20: 5 / 10 / 15 / 20% on stages 2-5 of a five-stage
# campaign, 2 / 4 / ... / 20% on stages 2-11 of an eleven-stage one. The roll comes from the outbreak
# seed, so a RETRY of the same outbreak starts the same pits. A pit starts on a zombie outside
# every safe zone with no wall within wall_clearance, pulls in the max_zombies zombies nearest
# it within pull_radius, and they circle inside `radius`. A red marker ring and a countdown arc are
# drawn round it, over the buildings. Cost: nothing while no pit stands; a packed pit costs the personal space
# ([zombie] spacing) what the same zombies piled at a wall cost, which max_zombies bounds.
# Hot-reloads.
buffer_stages             = 1      # a campaign's first this many stages start no pit (0 = every stage can)
chance_percent_last_stage = 20.0   # % chance a pit starts at each check on a campaign's last stage; the stages after the buffer rise to it in even steps; 0 = never
check_seconds    = 15.0   # sim seconds of battle between the start checks
duration_seconds = 10.0   # sim seconds from a pit's start until its zombies turn its type (a cruise missile, 2.5 s, reaches it in time; an airstrike, 25 s, does not)
max_zombies      = 150    # the most zombies one pit pulls in (and so turns)
max_live         = 4      # the most pits standing at once; a check with this many up starts none
pull_radius      = 50.0   # world units: how far from its centre a pit pulls zombies in
radius           = 15.0   # world units: the disc its zombies circle in, each on its own lane
wall_clearance   = 80.0   # world units: no pit starts with a standing wall this close to its centre
ring_width_px    = 3.0    # screen pixels: the width of its red marker ring and of the countdown arc just outside it (0 = not drawn)
ring_alpha       = 0.9    # 0..1 the marker ring's opacity (the countdown arc is opaque)
marker_radius_px = 30.0   # screen pixels: the marker ring's radius, the same at any zoom so a pit shows from far away; drawn over the buildings, and never inside the pit's own disc when zoomed in close
marker_min_zoom  = 0.30   # camera zoom (pixels per world unit, as [camera] zoom_min) at and past which the marker ring stops growing on the ground: zoomed out farther, it shrinks with the map (its ring width stays); 0 = the same on-screen size at every zoom
toast_seconds    = 5.0    # real seconds the "zombies are mutating" toast stays up (held while the mouse is on it); clicking it moves the camera to the pit; 0 = no toast
explosive_weight = 2.0    # how often a pit turns its zombies explosive, against the other three weights (all four 0 = explosive)
shielded_weight  = 1.0    # how often it turns them shielded
giant_weight     = 0.0    # how often it merges them into giants
swimmer_weight   = 2.0    # how often it turns them swimmer

[civilian]
initial_count     = 200000       # white units spawned at reset (Backspace to reset)
# Hard cap on the naturally-seeded civilian crowd. The OSM per-building seeding and
# the procedural initial_count are both clamped to this (0 = no cap). Big real
# maps (e.g. ny_partial) would otherwise seed several million civilians and the
# per-tick movement pass -- the dominant sim cost -- crawls. The +/- stress keys are
# NOT capped (they are an explicit manual override). Applied on load/Backspace.
max_count         = 500000
# The crowd cap a campaign's own LAND allows, so only the biggest maps reach max_count: this
# many civilians per km^2 of the land inside the campaign's LAST stage (the same land the money
# and outbreak are read off -- stage_scale.odin), counted by the map editor when it saves the
# campaign (its `land_km2` line). Every stage of the campaign is capped at the lower of this
# and max_count, and its money and skill points follow the capped crowd. 3150 puts New York
# (159 km^2 of land) at 500k; a map with no land_km2 line has only max_count. 0 = off.
max_per_land_km2  = 3150
# Panic: each civilian carries a 0..1 panic level that rises in high-danger cells
# and fades in calm ones. Panic does NOT change a civilian's color; it scales how
# fast and how erratically they move -- a calm civilian walks at calm_speed and wanders
# gently; its speed climbs with its panic up to its flee speed -- hard-coded at half of
# zombie.speed -- at panic_threshold.
# Past panic_threshold it counts as panicked (HUD), RUNS AWAY FROM THE ZOMBIES (down the
# danger grid's zombie-only channel, flee_strength) -- turning along any building, water or
# wall in its way rather than pressing into it -- jitters, and spreads danger.
# Safe zones: a civilian inside a safe zone does not panic at all while the walls around
# its part of the zone stand; once the horde (or a bomb) breaches that part -- its stripes
# turn red -- its civilians panic like anyone else. A zone's walls are one-way for
# civilians: one outside every zone walks straight through a zone wall into the zone, one
# inside is held by it (zombies are held both ways, police pass both ways).
# All hot-reload live.
panic_danger          = 0.6   # cell danger at/above which panic rises
panic_rise_per_second = 2.5   # how fast panic climbs in a dangerous cell
panic_fade_per_second = 0.6   # how fast panic falls in a safe cell
panic_threshold       = 0.5   # panic level counted as "panicked" (HUD + flees + spreads danger); the civilian reaches its full flee speed (half of zombie.speed) here
calm_speed            = 3.0   # world units/sec: a calm civilian's walking speed (panic 0)
# Each civilian flees at its own speed, fixed for the battle (rolled from the outbreak seed), so a
# fleeing crowd strings out: between its flee speed (half of zombie.speed) minus flee_speed_below and
# plus flee_speed_above, with flee_fast_percent of civilians above the slowest zombie's speed
# (zombie.speed - zombie.speed_jitter) and the rest below it. Shipped: 85% at 12-14, 15% at 14-16.
flee_speed_below      = 1.0   # world units/sec the slowest civilian flees below the flee speed (0 and flee_speed_above 0 = every civilian alike)
flee_speed_above      = 3.0   # world units/sec the fastest civilian flees above the flee speed
flee_fast_percent     = 15.0  # % of civilians who flee faster than the slowest zombie (0 = none outruns any zombie); the rest flee slower than it
panic_wander          = 0.25  # extra reorient chance per 1/60 s at full panic (erratic fleeing)
flee_strength         = 0.8   # 0..1: share of a panicked civilian's heading that turns away from the zombies each time it re-aims (15 times a second); the rest is its panicked wander. 0 = no fleeing, the old erratic wander
calm_move_every       = 8     # a calm civilian (panic 0) moves once every this many 1/60 s steps, taking that many steps' worth of its walk at once, and looks at the danger around it only then -- so it starts to panic up to that many steps late (8 = 0.13 simulated s). A power of two up to 16; 1 or 2 = every tick (the sim ticks every 2 steps). Off while an evac zone is up
people_per_building_area = 0.02  # civilians seeded per world-unit^2 of a map's building footprint (hot-reloads; applied on load)

[danger]
# The "danger grid": a coarse grid over the map. Zombies, corpses, and panicked
# civilians raise the danger score of the cell they're in; scores blur into
# neighbors and fade. Civilians read their cell to decide when to panic (and, in a
# later phase, which way to flee). cell_size applies on launch/Backspace; the rest
# hot-reload live. A lone stationary zombie settles its cell at zombie_weight/decay.
cell_size        = 40.0    # grid cell edge in world units (~a third of a block)
update_hz        = 20      # grid updates per simulated second (0 = every tick); civilians still read it every tick
decay_per_second = 1.5     # fraction of a cell's danger that fades each second
spread           = 0.25    # 0..1 how strongly danger bleeds into neighbor cells
zombie_weight    = 1.0     # danger a zombie adds to its cell per second
corpse_weight    = 0.3     # danger a corpse adds to its cell per second
panic_weight     = 0.25    # danger a panicked civilian adds (so panic spreads)

[flock]
# Zombie hunting. Zombies start moving at random; as a session goes on they
# increasingly hunt, blending up to three signals into their wander (never
# replacing it -- the code always keeps at least 15% random wander, so hunting can
# never do worse than the old random movement, and a zombie that stays pinned on
# a wall for ~0.15s reverts to pure wander for 1.5s to free itself):
#   1. chase  -- steer straight at a civilian crowd within chase_radius (prey grid)
#   2. scent  -- climb the [scent] gradient toward crowds/occupied buildings far
#                beyond sight, routing around buildings and water (see [scent])
#   3. align  -- match nearby zombies' average heading (the traveling-pack look)
# Strength ramps 0 -> coordination_max between ramp_start and ramp_full seconds of
# simulated time. All hot-reload. Degrade live: scent.strength=0 leaves chase+packs;
# align=0 too leaves pure chase; coordination_max=0 restores pure random wander.
# See docs/zombie-movement-behaviors.md for the full menu of movement options.
cell_size               = 60.0   # flock-grid cell edge (world units); coarse, ~one per block
align                   = 0.3    # steering weight of matching the local average heading (0 = off)
cohesion                = 0.0    # steering weight of drifting toward denser ZOMBIE cells; off -- pulling zombies toward zombies fights infection spread (kept as a knob)
chase_radius            = 45.0   # a zombie steers toward a civilian crowd this close (world units; 0 = off)
chase                   = 2.0    # steering weight of that close-range pull (the lunge)
# Crowd dispersion: a tight pack that enters a big crowd should burst apart and chase
# individuals, not sail through as one clump. As the civilians within ~a block of a
# zombie reach crowd_disperse, its alignment (the pack-look glue) fades to 0 and a
# separation push -- away from denser ZOMBIE cells -- ramps to full, so the pack fans
# out onto the crowd. crowd_disperse = 0 disables both (old behavior).
separation              = 1.0    # steering weight pushing a zombie off its own kind while among civilians (0 = off)
crowd_disperse          = 12.0   # local civilian count at which a pack fully disperses (0 = disable dispersion)
momentum                = 0.5    # 0..0.95 how much of its current heading a hunting zombie keeps each tick; higher = smoother, more committed travel
momentum_jitter         = 0.1    # each zombie's own momentum is flock.momentum give or take up to this (kept within 0..0.95), fixed for the battle: some swing onto a new heading fast, others slowly, so a pack whose shared field direction changes turns in a ripple instead of all at once; 0 = every zombie alike
heading_jitter          = 12.0   # degrees: each zombie bends the hunt fields' pull (chase, scent, flow) by its own fixed angle up to this either way, so a pack fans out a little instead of marching in parallel lines (a bent pull that would aim into a wall falls back to the flow field's, as before); 0 = off
update_hz               = 15     # how often per simulated second the flock + chase (prey) fields are rebuilt (0 = every tick); a zombie re-reads them 15 times a second (every other 1/30 s tick), so rebuilding faster than that is wasted
far_steer_meters        = 480.0  # a hunting zombie farther than this (walking distance, the flow field's) from every civilian, or with none reachable, re-reads the hunt fields only every far_steer_every 1/60 s steps: out there its way is the flow field's, which changes slowly (0 = off)
far_steer_every         = 16     # 1/60 s steps between such a far zombie's re-reads (4 = as often as a near one, i.e. off; a power of two up to 64; the sim ticks every 2 steps)
coordination_ramp_start = 20.0   # simulated seconds of pure random wander before hunting begins
coordination_ramp_full  = 120.0  # simulated seconds at which hunting reaches full strength
coordination_max        = 0.75   # 0..1 cap on how field-driven the horde gets (code clamps to 0.85 so wander never fully vanishes)

[scent]
# The scent field zombies hunt by (active only while [flock] coordination > 0).
# Civilians on the street, and occupied buildings at their door, deposit "scent"
# into a coarse grid; it fades and bleeds into neighboring cells -- but only
# through WALKABLE cells (buildings and water block it), so the uphill direction
# always leads around obstacles, never into them. Zombies climb the gradient:
# hordes stream down streets, cross bridges, and pile up at sheltered survivors'
# doors. All hot-reload; strength = 0 turns the whole field off.
# The field advances update_hz times per simulated second (not every tick -- on a
# city-scale map it is millions of cells; zombies still read it every tick), each
# update running blur_passes blur sweeps. Reach in cells ~ sqrt(spread * blur_passes
# * update_hz / (2 * decay)): the defaults give the same ~4-cell reach the original
# every-tick (60 Hz, 1 pass, spread 0.35) field had, at a quarter of the cost.
cell_size       = 12.0   # grid cell edge (world units); ~a street width
update_hz       = 15     # field updates per simulated second (0 = every tick)
blur_passes     = 2      # blur sweeps per update
decay           = 0.6    # fraction of each cell's scent lost per second (higher = shorter reach)
spread          = 0.7    # 0..1 per-sweep bleed into open neighbor cells (higher = travels farther/faster)
civilian_weight = 1.0    # scent one street civilian deposits per second
strength        = 1.0    # steering weight of climbing the gradient (0 = off)
# This field is short-range (~4 cells of diffusion, ~50 m); the [flow] field below is
# what guides a horde whose neighborhood is eaten out.

[flow]
# The flow field -- the horde's long-range guide (active only while [flock]
# coordination > 0). Every cell of a street-width grid over the map holds the WALKING
# distance, along open ground, to the nearest civilian: a breadth-first search seeded
# from every civilian-occupied cell and grown only across cells that are actually
# connected on the obstacle grid (a cell split by a building sliver thinner than
# itself is searched as separate patches), so it never leads through a building or
# across water -- descending it is the next step of a real path to the nearest reachable
# crowd, however far away, over bridges and around rivers. (Its predecessor, a coarse
# diffusing "far scent" field, reached only a few hundred meters and leaked across
# narrow water, which sent hordes to shorelines and out onto the empty map edge --
# issue #100.) Its distance also tells the short-range chase / scent pulls whether the
# civilian they see is reachable at all, so prey across a canal can't pin the horde
# on the shore. The search is spread over rebuild_seconds in fixed per-tick slices,
# so its cost is flat whatever the crowd does; zombies read the last completed field
# every tick. All hot-reload; Shift+F9 in-game shows it.
cell_size       = 12.0   # grid cell edge (world units); ~a street width. 0 disables the field
rebuild_seconds = 2.0    # simulated seconds one rebuild is spread over (the field is at most this stale); 0 = rebuild in one tick
strength        = 1.0    # steering weight of descending the distance field (0 = off; also drops the reachability gates on chase + scent)
crowd_bias      = 1.0    # cells of head start per doubling of a cell's civilians (capped at 8): bigger crowds win a larger basin; 0 = nearest civilian wins
lean            = 2.0    # how hard each zombie keeps to its own side where the field offers two equally short ways on (a crossing toward a crowd ahead and to one side): every zombie leans left or right by its own fixed amount, and a neighbour street on its side counts 1 + lean x how far to that side it lies -- so a pack fans out over parallel side streets instead of funnelling into one; only in the open (where the field's own direction is clear of walls); 0 = every zombie takes the field's blended direction
react_delay     = 30.0    # seconds: when a rebuilt field swaps in and sends a hunting zombie another way than the old field did where it stands (its prey moved or died), it waits its own random delay, 0 to this, before it turns (keeping to the old field, or with no flow pull where the old field led nowhere), so a horde whose target moved turns over a few seconds instead of all at once; a rebuild that leads the same way is taken up at once; 0 = every zombie at once. Keeping the old field costs 2 bytes a flow node (about 12 MB on all of New York)

# ======================================================================================
# THE WORLD -- buildings, bridges, the play area
# ======================================================================================

[building]
# What the map data says about each building beyond its outline: its height, its roof
# shape, its use (residential, commercial, ...) and its type -- what the places in it are
# (a pharmacy, a police station, an auto parts store, a hospital ...; Overture's places).
# Most buildings have none of it (height is best in dense downtowns, types are on shops
# and public buildings); an unknown height gives no range bonus. The roof shape has no
# gameplay effect. Height matters only to snipers and mortars: a
# garrison's reach comes from its building's width, and it can hold any building. Resting
# the cursor on a building shows what is known; holding H (the HEIGHT view) colours every
# building by its height (colors.height_*). Types group into the classes of
# [building_class] below, which is where they matter in play.
# height_cap hot-reloads live; place_snap_m is read when a map is
# installed (the next map load, or a new stage). What the types DO is [building_class] below.
# Every building also has health, which grows with its height (hp + hp_per_m a meter): a
# mortar or battleship shell, a mine or a fuel building going up wears its damage (the same
# it does a zombie) off each building in its blast, and a nuke's shockwave its own, times the share of the building the blast
# covers, and a building worn to 0 is levelled -- gone,
# its ground open, any garrison, sniper or mortar on it dead -- as an airstrike levels one.
# The damage lasts the battle; a RETRY or the next stage starts every building whole. An
# airstrike bomb or a C4 charge still levels what it covers outright. The ground a levelled
# building leaves is rubble: anyone walking on it is slowed (rubble_speed_percent).
height_cap      = 150.0      # meters: the most roof height that counts toward a mortar's range bonus (a taller building counts as this tall); the sniper has its own, sniper.height_cap
type_priority   = police_station fire_station hospital pharmacy drugstore gun_and_ammo_store auto_parts_store hardware_store gas_station grocery_store convenience_store   # a building often holds several types (a tower: offices, a bank, a pharmacy); the hover box shows the first of these it holds, else the one with the most places. Each word matches any level of a category, so health_care would take any kind of health care. Display only; hot-reloads
place_snap_m    = 15.0       # meters: a place (shop, police station ...) outside every building footprint counts for the nearest footprint edge within this distance (the data often puts a shop's point on the pavement in front of it); farther, it counts for no building. 0 = only places inside a footprint
hp              = 100.0      # a building's health against blasts at no height (mortar.damage, battleship.damage, mine.damage, fuel_blast.damage, nuke.damage); 0 = blasts never wear buildings down. Hot-reloads
hp_per_m        = 20.0       # ...plus this much for each meter it stands (view3d.unknown_height for one with no height in the map): a 9 m house 960, a 100 m tower 4600, a 300 m skyscraper 12600. 0 = every building has hp. Hot-reloads
rubble_speed_percent = 70.0  # anyone walking on a collapsed building's ground (zombies, civilians, officers) walks at this % of their own speed; milder than spike_strip.speed_percent. Vehicles aren't slowed. 100 = no slow. Hot-reloads

[building_class]
# SPECIAL BUILDINGS (buildingclass.odin; the battle side sim/specials.odin). A building's
# TYPES put it in one of five categories, each list below naming the category levels it
# takes, matched at any level of a type's category the way building.type_priority is (`bank`
# takes every kind of bank; the full list of categories is the Overture places taxonomy). A
# building holding types of several takes the first in this order: fuel, armory, civic,
# airlift, evacuate, medic, trade (a gas station in a supermarket still explodes; an airport
# with a clinic is an airport). Each category has its own colour (colors.class_*); resting the
# cursor on a building names its category, ability and effect, and a click on it opens the
# stats panel, where an ARMORY, CIVIC or TRADE building's ability is picked (part of the
# plan: it carries between stages and comes back on RETRY and Ctrl+Z).
#   fuel    -- EXPLOSIVE: blows up when a blast touches it ([fuel_blast] below), anywhere
#   armory  -- SUPPLY (guns near it reload faster), SPEED or RANGE (the unit on it), or
#              COMMAND POST (every gun near it fires faster)
#   civic   -- POLICE (officers on patrol), MILITIA (its civilians arm on a breach),
#              BROADCAST (it calls the civilians outside the zones in) or RADIO TOWER
#              (the garrisons, snipers, mortars and Turrets near it reach 50% farther)
#   medic   -- RESCUE: MEDIC (officers near it survive their first bite)
#   airlift -- RESCUE: AIRLIFT (it flies the civilians near it out: they count as saved)
#   evacuate -- RESCUE: EVACUATE (a train, metro or bus station: Airlift on the ground, at its
#              own evacuate_* rates)
#   trade   -- MONEY (pays into the balance), REDUCED COST (the unit on it) or REPAIR (walls
#              near it heal)
# SPEED, RANGE and REDUCED COST work through the garrison, sniper or mortar holding the
# building, wherever it stands. Every other ability works only while the building's WHOLE
# footprint lies inside the safe zones (it may straddle overlapping ones; a zone round part
# of it, or a tiny one inside it, takes in nothing): READY lays them into the battle. The
# MONEY is paid into the balance when the zone closes (or the pick is made) -- a zone costs
# its outline less what its buildings pay -- and deleting the zone or moving the pick takes
# it back (into debt if need be). All hot-reload live (a battle's sites are laid at READY).
fuel    = gas_station truck_stop propane_supplier b2b_oil_and_gas chemical_plant fireworks_store b2b_mining demolition_service natural_gas_utility_provider b2b_power_plants_and_power_plant_service
armory  = gun_and_ammo_store hunting_and_fishing_store tactical_supply_store shooting_range wildlife_hunting_range firearm_training military_site pawn_shop sporting_goods_store
civic   = police_station courthouse jail_or_prison government_office town_hall civic_center community_center library fire_station radio_station television_station
medic   = hospital emergency_or_urgent_care_facility doctors_office primary_care_or_general_clinic pediatric_clinic
airlift = airport
evacuate = train_station metro_station light_rail_and_subway_station bus_station
trade   = hardware_store building_supply_store electrical_supply_store building_or_construction_service contractor manufacturer self_storage_facility b2b_storage machine_and_tool_rental wholesaler bank_or_credit_union hotel shopping_mall department_store superstore warehouse_club_store
# DENSITY: the map is cut into density_cell squares (in the map file's frame, so every stage
# and RETRY of a map keeps the same ones) and each keeps its density_max LARGEST special
# buildings by footprint (the easiest to see); the rest play as plain buildings.
# Keep density_cell at or under play_area.crop_margin so a stage's crop sees whole squares.
density_cell         = 1000.0  # DENSITY: meters, the side of the square special buildings are counted in
density_max          = 2      # DENSITY: most special buildings kept in one square, the largest first (0 = keep every one)
money_discount_percent = 20.0  # BUDGET: % off the price of every garrison, sniper, mortar, Turret, mine, C4 charge and battleship placed within money_radius of the building (a building unit judged by its building's centre point, every level of it and the UPGRADE tool's steps; the rising cost_increase steps are not cut), while the building stands wholly inside the safe zones; overlapping Budget buildings stack (money_discount_stack_percent). A unit's refund is its price where it stands now: drawing, moving or deleting a zone, or changing the pick, that puts a unit in or out of reach charges (or refunds) the difference at once, into debt if need be. Hot-reloads (an edit in planning reprices the units already placed without charging the difference)
# STAGE SIZE: every reach below (*_radius) is its reach on a small stage, and grows with the
# stage's land (the same land the safe zones' land cap counts) toward its *_radius_large on a
# big one: sliding in a straight line on the square root of the land from radius_small_km2 to
# radius_large_km2, rounded to whole meters, like safe_zone.max_land_percent's cap. The reach
# a building shows (its ring, its tooltip's "Reach") is the one on the stage being played.
radius_small_km2     = 1.0     # STAGE SIZE: km^2 of stage land at or under which a special building reaches its *_radius
radius_large_km2     = 159.0   # STAGE SIZE: km^2 of stage land at or over which it reaches its *_radius_large (NYC stage 11's land)
money_radius         = 300.0   # BUDGET: meters around the building (past its own size: the ring drawn when it is selected) within which a placed unit costs money_discount_percent less
money_radius_large   = 750.0  # BUDGET: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = money_radius on every stage)
money_discount_stack_percent = 10.0 # BUDGET: % more off for EACH FURTHER Budget building whose reach also holds the unit (the first gives money_discount_percent; 2 = 30%, 3 = 40% at 20 + 10; never past the whole price); 0 = they don't stack. Charges or refunds the difference like any change of reach
reduced_cost_percent = 60.0   # REDUCED COST: % off the price of a garrison, sniper or mortar placed on the building (every stack level)
range_percent        = 40.0   # RANGE: % added to the reach of the garrison, sniper or mortar on the building
speed_percent        = 60.0   # SPEED: % added to the fire rate of the garrison, sniper or mortar on the building
supply_radius        = 600.0  # SUPPLY: meters around the building within which a garrison, sniper, mortar or railgun reloads faster (a plain Turret never reloads)
supply_radius_large  = 1500.0 # SUPPLY: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = supply_radius on every stage)
supply_reload_percent = 30.0  # SUPPLY: % faster a gun in reach reloads: its reload's seconds are divided by 1 + this / 100 (30 = 1.3x as fast; on top of its level, upgrades and Armory pick). It still spends its magazines
supply_stack_percent = 15.0   # SUPPLY: % added for EACH FURTHER Supply building whose reach also holds the gun (the first gives supply_reload_percent; at 30 + 15, two = 45%: reload seconds over 1.45, three = 60%); 0 = they don't stack
repair_radius        = 200.0   # REPAIR: meters around the building within which wall cells heal
repair_radius_large  = 500.0  # REPAIR: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = repair_radius on every stage)
repair_hp_per_second = 40.0   # REPAIR: health each standing wall cell in reach heals a second, up to its wall's full health (walls.decay_per_zombie_second is one chewing zombie's)
repair_stack_hp_per_second = 20.0 # REPAIR: health a second added for EACH FURTHER Repair building whose reach also holds the wall cell (the first gives repair_hp_per_second; at 40 + 20, two = 60); 0 = they don't stack
medic_radius         = 400.0  # MEDIC: meters around the building within which an officer survives its first bite (the biting zombie dies instead); each officer once a battle
medic_radius_large   = 1000.0 # MEDIC: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = medic_radius on every stage)
airlift_radius       = 150.0  # AIRLIFT: meters around the airport the civilians are flown out from (nearest first; never one already bitten)
airlift_radius_large = 375.0  # AIRLIFT: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = airlift_radius on every stage)
airlift_seconds      = 6.0    # AIRLIFT: sim seconds between lifts (the first comes this long after READY)
airlift_count        = 5      # AIRLIFT: civilians one lift flies out
evacuate_radius      = 200.0  # EVACUATE: meters around a train, metro or bus station the civilians are taken out from (nearest first; never one already bitten)
evacuate_radius_large = 500.0  # EVACUATE: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = evacuate_radius on every stage)
evacuate_seconds     = 1.0   # EVACUATE: sim seconds between runs (the first comes this long after READY)
evacuate_count       = 5      # EVACUATE: civilians one run takes out -- they count as saved, like Airlift's
broadcast_radius     = 600.0  # BROADCAST: meters around the building within which a calm civilian outside every zone heads in (for a gate when one is in reach, else for the building)
broadcast_radius_large = 1500.0 # BROADCAST: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = broadcast_radius on every stage)
broadcast_strength   = 0.8    # BROADCAST: 0..1, how much of a called civilian's step heads in (the rest is its own wander)
broadcast_civilian_speed = 23.4 # BROADCAST: world units/sec any civilian outside every zone within broadcast_radius moves at, calm or panicked (reference: 90% of zombie.speed 26; a panicked civilian elsewhere runs at half of it); 0 = off
police_seconds       = 2.0   # POLICE: sim seconds between officers (the first comes this long after READY)
police_max           = 100    # POLICE: officers one building sends in a battle, counted from READY whether or not they still live (then it stops sending), 0 = no cap (one every police_seconds until the battle ends); they hold the zone, walk to where the horde chews a wall, and hunt once their part of it is breached
militia_radius       = 250.0   # MILITIA: meters around the building whose civilians take up arms when its part of the zone is breached (once a battle)
militia_radius_large = 625.0  # MILITIA: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = militia_radius on every stage)
militia_fraction     = 0.35   # MILITIA: 0..1, the share of those civilians that do
radio_radius         = 650.0  # RADIO TOWER: meters around the building within which every unit holding a building reaches farther
radio_radius_large   = 1625.0 # RADIO TOWER: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = radio_radius on every stage)
radio_range_percent  = 50.0   # RADIO TOWER: % added to the reach of every unit holding a building in reach -- garrisons, snipers, mortars, Turrets; not officers or vehicles (on top of its Range pick and upgrades)
radio_stack_percent  = 25.0   # RADIO TOWER: % added for EACH FURTHER tower whose reach also holds the unit (the first gives radio_range_percent; at 50 + 25, two = 75%); 0 = they don't stack
command_radius       = 650.0  # COMMAND POST: meters around the building within which every gun (officers, garrisons, snipers, mortars, Turrets, the battleship, the APC, the helicopter) fires faster
command_radius_large = 1625.0 # COMMAND POST: its reach on a big stage, radius_large_km2 of land or more (STAGE SIZE above; 0 = command_radius on every stage)
command_speed_percent = 25.0  # COMMAND POST: % added to the fire rate of a gun in reach (a Rally multiplies on top)
command_stack_percent = 12.5  # COMMAND POST: % added for EACH FURTHER post whose reach also holds the gun (the first gives command_speed_percent; at 25 + 12.5, two = 37.5%); 0 = they don't stack
# NO PICK YET: an ARMORY, CIVIC or TRADE building starts with no ability and does nothing
# until one is picked in its stats panel. While it stands wholly inside the safe zones in
# planning, a bright line with a soft halo (colors.unpicked_glow) pulses round its outline
# (on its roof with the buildings standing up, where its walls and roof are tinted with it
# too), until the pick is made.
unpicked_glow_width_px      = 22.0  # screen pixels: how far the halo fades out from the building's outline (0 = no glow)
unpicked_glow_core_px       = 3.0   # screen pixels: the bright line along the outline, inside the halo's width, held at the halo's full opacity
unpicked_glow_alpha_min     = 0.35  # 0..1 the glow's opacity at the outline at the low point of its pulse
unpicked_glow_alpha_max     = 1.00  # 0..1 its opacity at the outline at the top of its pulse
unpicked_glow_pulse_seconds = 1.2   # real seconds per breath of the pulse (it keeps pulsing while paused); 0 = steady at alpha_max
unpicked_glow_body_alpha_min = 0.15 # 0..1 with the buildings standing up: how strongly its walls and roof are tinted in the glow's colour at the low point of the pulse (0 = no tint)
unpicked_glow_body_alpha_max = 0.45 # 0..1 that tint at the top of the pulse

[fuel_blast]
# A FUEL building ([building_class] fuel) that a blast touches -- an airstrike bomb, a fire
# bomb, a mortar shell, a mine, a C4 charge, or another fuel building going up (not the
# stun-gas canister) -- explodes fuse_seconds later at its centre, killing EVERYTHING inside
# its radius (zombies, civilians and your own units -- an APC too -- like a bomb). The radius grows with the
# building's width (the side of a square of its footprint area): radius_base +
# radius_per_meter x width, at most radius_max -- a 12 m wide gas station blows 27 m, a 60 m
# wide depot 75 m. The building is levelled (a garrison in it dies with it) and its blast
# sets off every other fuel building it reaches, so a row of them goes up one by one. It
# wears its `damage` off the other buildings in its blast ([building] hp) and off the wall
# cells and bridge spans inside it. Each building goes up once per
# battle. The zombies it kills count for the weapon that started the chain. All hot-reload live.
radius_base      = 55.0   # meters of blast before the building's width adds on
radius_per_meter = 4.0    # meters of blast per meter of building width
radius_max       = 350.0  # the widest blast any building gives, in meters (0 = no cap)
fuse_seconds     = 0.5    # sim seconds from the touching blast to the building's own
damage           = 100.0  # health the blast takes off each zombie in it -- and off each other building, each wall cell and each bridge span in it; everyone else in it dies

[topple]
# A levelled building (by any blast, the bulldozer, or another building falling on it) at
# least min_height tall shears off at its foot and topples over sideways
# instead of sinking straight down -- if it is taller than `slenderness` times its depth the
# way it would fall (a squat block just sinks). It falls toward the explosion that brought it down, or
# away from a push (the bulldozer's blade, a building falling on it), strayed up to spread_degrees either way, or any
# way when nothing pushed it (a fuel building going up from inside), and lands fall_seconds
# later across a strip from the middle of its foot, as wide as the building and as long as
# it was tall. Everyone under the strip dies (a zombie takes `damage`, so a shielded one or
# a giant may live), every building it covers any part of takes the falling building's own full health
# ([building] hp + hp_per_m by its height, not what it had left) as damage (one worn to its
# health is levelled -- and may topple in turn), every
# wall cell under it takes its `damage`, and the ground it covers is left as rubble. A
# landing has fire_chance to start a fire: up to fire_patches burning patches of
# fire_radius along the strip, each burning fire_seconds (and spreading over any greenspace
# it lands on, as every fire does). The kills count for the weapon that brought the building down. Each roll
# is fixed by the outbreak: the same plan meets the same falls. All hot-reload.
min_height      = 12.0    # meters: a building shorter than this never topples (an unknown height counts as view3d.unknown_height)
slenderness     = 0.6     # a building topples only if its height is more than this times its depth along the fall (1 = only one taller than it is deep; 0 = any shape)
spread_degrees  = 25.0    # degrees either way a fall strays from straight toward the explosion (or away from the push)
fall_seconds    = 1.6     # sim seconds from the levelling to the landing
damage          = 100.0   # health the landing takes off each zombie and each wall cell under it (walls.hp is a level-1 cell's full health); everyone else under it dies
sound_full_height = 100.0 # meters: a fall this tall or taller lands at its full volume ([audio] explosion_bomb); a shorter one is quieter, in proportion to its height
sound_min_gain  = 0.2     # 0..1: the quietest a landing sounds (its share of the full volume), however short the building
fire_chance     = 0.35    # 0..1: the chance a landing starts a fire
fire_radius     = 14.0    # meters: each of the fire's patches' radius
fire_seconds    = 25.0    # seconds each patch burns
fire_patches    = 3       # most burning patches one landing lays, spread along its strip

[perks]
# The roguelike perks (perks.odin; *Perks* in docs/gameplay.md): up to three on the
# LOADOUT screen's green PERKS row, kept for the whole campaign (a picked one locks once a
# battle is fought with it, until the campaign is started over). Each comes with a campaign
# (the campaign_* keys at the end) and unlocks when that campaign is beaten. Each setting
# below acts only while its perk is in a slot. All hot-reload.
extra_safe_zones         = 3       # THREE MORE SAFE ZONES: safe zones added to [safe_zone] free_zones (the land cap still holds)
gas_fire_seconds         = 12.0    # STUN GAS IS FLAMMABLE: a fire reaching a stun-gas cloud burns the whole cloud (and any cloud touching it) away into fire lasting this long, seconds
fall_gas_seconds         = 10.0    # FALLING BUILDINGS LEAVE GAS: seconds the stun gas a falling building leaves lasts (one cloud over a building that sinks, a row of them along a toppled one's strip)
fall_gas_radius          = 12.0    # ...meters: each cloud's radius along a toppled building's strip; a building that sinks straight down leaves one cloud over its footprint, never smaller than this
officer_blast_radius     = 4.0     # EXPLODING OFFICERS: meters a bitten officer's blast reaches (it never turns); zombies and civilians in it die, your other units are spared
bridge_hp_percent        = 28.0    # WEAK BRIDGES: percent of the health its size gives it ([bridge] hp_*) every bridge span starts the battle with, 1-100; never under [bridge] hp_min
blast_gas_seconds        = 3.0     # EXPLOSIONS LEAVE GAS: seconds the stun-gas cloud every blast but the nuke's leaves lasts (as wide as the blast)
fire_damage_per_second   = 6.0     # HOTTER FIRE: zombie health a second in fire takes, in place of [fire] damage_per_second (6 = three times its 2)
fire_spread_speed        = 8.25    # HOTTER FIRE: meters a second fire creeps over greenspace, in place of [fire] spread_speed (8.25 = 1.5x its 5.5)
unlock_cut_percent       = 33.0    # QUICK DEPLOY: % cut from every battle ability's first-use lock (its unlock_seconds)
# The campaign each perk comes with: its campaigns/<name>.cmp file name, without .cmp. Every
# perk is locked until its campaign is beaten (its last stage won); while that campaign is
# played, its perk always fills the first PERKS slot, unlocked or not, and can't be
# taken out. Left empty, a perk comes with no campaign and stays locked. A campaign should
# come with one perk at most (with two, the first in this list is its own).
campaign_extra_zones     = Boston_MA        # EXTRA SAFE ZONES comes with this campaign
campaign_quick_deploy    = Miami_FL          # QUICK DEPLOY comes with this campaign
campaign_weak_bridges    = Venice_Italy     # WEAK BRIDGES comes with this campaign
campaign_hot_fire        = San_Francisco_CA # HOTTER FIRE comes with this campaign
campaign_fall_gas        = New_York_City    # COLLAPSE GAS comes with this campaign
campaign_blast_gas       = Detroit_MI       # GAS BLASTS comes with this campaign
campaign_officer_blast   = Capitol_Hill_Washington_DC # EXPLODING OFFICERS comes with this campaign
campaign_flammable_gas   = Seattle_WA       # FLAMMABLE GAS comes with this campaign

[coop]
# Two-player co-op's cursors and pings (coop_cursor.odin; *Co-op* in docs/gameplay.md): each
# player sees the other's cursor with their name, and a right-click on the map that does
# nothing else pings the spot on both screens. Drawing only: none of these touch the battle.
host_color     = 70 170 255     # the host's cursor dot, name label and pings (blue)
guest_color    = 255 140 40     # the guest's (orange): told apart from the host's under every colour-blind palette
ping_seconds   = 2.0            # how long a ping shows, seconds (its circle grows and fades over it)
ping_radius    = 90             # how wide a ping's ring grows, UI pixels (the same at any zoom)
cursor_send_hz = 15             # how many times a second a moving cursor goes to the partner (a still one sends nothing)

[daily]
# The DAILY CHALLENGE (daily.odin; *Daily challenge* in docs/gameplay.md): one board a day,
# the same for every player, rolled from the date (UTC) over all of the game's content, locked
# or not: a level of one of the game's campaigns, these many planning units and battle
# abilities, three perks and one built-in mutator. No mutator may set these keys.
plan_units               = 5       # planning units the challenge hands out (1-7: a key each)
battle_abilities         = 4       # battle abilities the challenge hands out (1-7: a key each)
min_civilians            = 60000   # the fewest civilians a level the challenge picks may seed (its campaign file's `civilians` line, which the map editor's save measures)
max_civilians            = 200000  # the most civilians a level the challenge picks may seed

[demolition]
# Controlled Demolition: a battle deployable. Arm it during the outbreak and every building
# that could topple (min_height tall, and [topple] slenderness times as tall as it is deep
# some way) is drawn in colors.demolition_target. Press on one, drag the way it should fall
# and let go: a charge goes off at its foot on that side and it topples straight that way,
# landing [topple] fall_seconds later across a strip as long as it was tall -- crushing,
# wearing down and maybe setting fire to what it lands on, as any toppling building does. A
# press on a building that can't topple spends nothing. Each use spends a charge; each level
# gives charges_per_level of them (3). Its kills are its own (DEMOLITION). All hot-reload.
sp_cost        = 1      # SP per level of CONTROLLED DEMOLITION: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest CONTROLLED DEMOLITION level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 30), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 3     # the most charges the battle banks: it starts with one and, past the lock, keeps recharging up to this many (1 = its recharge starts only once it is used)
charges_per_level = 3    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds = 20.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before one can be set off
arrival_seconds = 0.0   # arrival: sim seconds from the click until the charge goes off (0 = at once); longer, it waits before it sets off
min_height     = 60.0   # meters: the shortest building it can fell (an unknown height counts as view3d.unknown_height); a lower one lands mostly on its own footprint. Its own key: topple.min_height still sets which levelled buildings topple on their own

[seek_destroy]
# Seek & Destroy: a battle deployable. Arm it during the outbreak and every garrisoned
# building is drawn in colors.seek_destroy_target. Click one and its garrison turns out onto
# the street: the building is no longer garrisoned (its guns stop), and `police` officers
# stand up spaced round its outline, each on Seek & Destroy -- hunting the horde on their own,
# like a landed paratrooper. A stacked garrison turns out more: level N is `police` times the
# level multiplier (1, 3, 6, 12, 24). A click on a building with no garrison spends nothing.
# Each use spends a charge, which recharges (cooldown_seconds). Their kills are their own row on the
# stats popup. All hot-reload.
sp_cost        = 2      # SP per level of SEEK & DESTROY: the first level puts it on the battle bar, each one after adds charges_per_level more charges (one that recharges, cooldown_seconds above 0, recharges faster instead: [skill_points] level_recharge_percent)
max            = 0      # highest SEEK & DESTROY level (0 = no cap: only SP limit it)
cooldown_seconds = 0     # recharge: 0 = it doesn't recharge (a spent charge is gone, and each level adds charges_per_level); above 0 (e.g. 120), the sim seconds (real seconds at 1x) one charge takes to come back at level 1, once the first-use lock (unlock_seconds) has run out; each level after the first shortens it -- not below 5 in a mod
charges       = 1     # the most charges the battle banks: 1 = its recharge starts only once it is used; more = it keeps recharging past the lock up to this many to spend in a row
charges_per_level = 1    # charges the battle gets for each loadout level while it doesn't recharge (cooldown_seconds = 0): level 2 gives twice this many
unlock_seconds = 10.0   # battle unlock: real seconds at 1x (real time) after the outbreak starts before one can be used
arrival_seconds = 0.0   # arrival: sim seconds from the click until the garrison turns out (0 = at once); longer, it waits before it sets off
police         = 10     # officers a level-1 garrison turns out (each stack level multiplies it)

[bridge]
# When a strike sinks part of a bridge, the rest of that span doesn't drop all at once:
# the failure ripples outward from the blast, one cell-ring falling every this-many
# seconds, until the whole connected bridge is water. 0 = only the bombed patch sinks.
# Values below one sim tick (1/30 s ~= 0.033) collapse several rings per tick, so smaller
# keeps speeding it up toward near-instant; ~0.033 or more gives a visibly walking ripple.
collapse_seconds          = 0.005   # delay between successive bridge sections falling (sim seconds)
# Bridge health. A bridge span (one connected run of bridge road over water) stands until
# the bombs that land on it wear its health down to 0, and only then sinks (the blast that
# finished it drops its patch at once and the rest of the span collapses outward, see
# bridge.collapse_seconds). Every blast that touches a span takes the damage it does a
# zombie off that span once, however much of the span it covers (each block's damage; a
# stacked gun's shell at its level's): the airstrike's, a C4 charge's, the cruise missile's,
# the cluster bomb's, a fuel building's, and the mortar's, howitzer's, MLRS's, battleship's,
# tank's and mine's.
# The fire bomb and the gas bomb, which take no health off a zombie, take their own
# damage (fire_bomb.damage, gas_bomb.damage). Unlike walls (only the blasts you
# aim wear those), a bridge is worn by them all. Damage lasts the battle;
# RETRY and the next stage start every span whole. A span's health follows its size: a
# span is measured as the rectangle its deck cells make (its long axis is its length, its
# area over that its width), and it gets hp_per_length for each meter of length plus
# hp_per_width for each meter of width, held between hp_min and hp_max. A span is one
# connected deck, so a bridge cut by a sunk patch is two smaller spans, each with the health
# its own size gives it. Hot-reloads (a span already hit keeps the health it started with,
# less the damage it took).
hp_min        = 100     # the least health a span starts with: a short, skinny footbridge (a 2 m sliver over a canal edge too)
hp_max        = 2500    # the most health a span starts with (the longest bridges and causeways stop here)
hp_per_length = 2.0     # health for each meter of a span's length (a 100 m bridge: 200)
hp_per_width  = 15.0    # health for each meter of a span's width (a 20 m deck: 300)

[play_area]
# Scenarios play a saved map under set conditions (config overrides, chosen zombie
# spawn points, a playable-area polygon). Author them in the map builder (menu E on a
# scenario row, then C), pick one to play from the startup menu. A map with no .scn of
# its own gets a "(default)" scenario that plays it as-is. See docs/scenarios-design.md.
# fade_distance hot-reloads; it can also be a per-scenario [override] key.
fade_distance            = 550.0    # how far the outside-the-play-area fade eases to background, world units (smaller = a sharper edge; solid background beyond)
# The city stays fully shown for a ring around the play area before that fade starts: the
# ring is view_percent of the play area's size (the mean of its bounding box's width and
# height), split evenly between its two sides, so 75 shows a ring three-eighths of that size
# wide on every side. Where the map's data ends sooner, the fade starts there instead.
# Hot-reloads the fade; the ground kept loaded for it grows at the next install.
view_percent             = 75.0     # how much more city than the play area shows around it before the fade, percent of its size (0 = fade right at the boundary)
# That city is drawn drained of colour, so it reads as out of bounds: the map's ground,
# streets, water and buildings past the play area turn grey over outside_ramp meters
# (the crowd, the effects and the HUD keep their colours). Hot-reloads (the ramp with
# the fade).
outside_saturation       = 0.0      # how much of its colour the city past the play area keeps (0 = black and white, 1 = full colour)
outside_brightness       = 0.7      # how bright the city past the play area is drawn (1 = as bright as inside; lower = darker)
outside_ramp             = 20.0     # meters past the play-area boundary over which the city turns grey
# The hard edge of the play area is drawn as a dotted white line, but only the stretch
# near the mouse: dashes fade in as the cursor comes within edge_reveal_px screen pixels
# of the boundary and vanish again as it moves away. Hot-reloads.
edge_reveal_px           = 200.0    # how close (screen px) the cursor must be to the boundary for its dotted line to show
# A scenario loads only the part of its map near the play area: everything past the
# play area's bounding box plus crop_margin is cut away before the obstacle grid, the
# hunt fields, and the render batches are built, so a small stage on a city-scale map
# installs in a fraction of a second instead of building 100x more grid than it plays.
# It is raised at install to cover view_percent's ring plus fade_distance, so the shown
# ring has map to show (a big stage loads more than this). Keep it room for the
# helicopter to enter from out of view. Read at install (map pick, stage change, retry);
# can be a per-scenario [override] key.
crop_margin              = 800.0    # world units past the play area's bounding box that stay loaded

[city]
# Layout keys (blocks_x/y, block_size, street_width, building_density) apply on
# launch and on Backspace -- they regenerate the city. The rest hot-reload live.
blocks_x              = 24        # blocks across
blocks_y              = 24        # blocks down
block_size            = 120.0     # block edge in world units
street_width          = 30.0      # street/gap width between blocks
building_density       = 0.55     # 0..1 chance each building lot is filled

# ======================================================================================
# MAPS & MAP DATA -- folders, fetching real places, the map editor, custom maps
# ======================================================================================

[paths]
# The game's own map, scenario and campaign folders (the player's saves are under
# steam_cloud/). Read when the menu lists them.
maps_dir                 = maps     # directory of the game's maps (the startup menu lists these; with dev on, a map editor save writes here too)
scenarios_dir            = scenarios # directory for .scn scenario files (the startup menu lists these; with dev on, a one-stage map editor save writes here too)
campaigns_dir            = campaigns # directory for .cmp campaign files (Stage 14; also listed by the menu; with dev on, a map editor save of more stages writes here too)

[osm]
# Press O in-game, type a place name (e.g. "lower manhattan"), Enter -- the game
# geocodes it, fetches real buildings + roads from OpenStreetMap, and drops you
# into that city. The result is cached to <cache_dir>/<place>.map so the next load
# of the same place is instant and needs no network. bbox_km / timeout_seconds
# hot-reload; the rest are read when a load starts. The map editor's EXPAND MAP grows a
# map of a real place by bbox_km-sized squares read from custom.data_url.
bbox_km                  = 1.5      # side of the fetched square area (and of EXPAND MAP's squares), in km
timeout_seconds          = 30       # per-request network timeout (curl --max-time)
cache_dir                = cache    # directory for <place>.map network-cache files
overpass_endpoints       = https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
region                   =          # optional place to auto-load on launch (blank = none)

[map_editor]
# The map editor's EXPAND MAP queue: click "+" squares to queue any number; they are read
# from custom.data_url one at a time, back to back. A square that fails is retried after a
# backoff that doubles from fetch_retry_base_seconds up to fetch_retry_max_seconds, and is
# marked FAILED (drawn red, click to retry) after fetch_max_attempts tries. All hot-reload.
fetch_retry_base_seconds = 5.0      # wait before the first retry of a failed tile (doubles each time)
fetch_retry_max_seconds  = 120.0    # ceiling on that backoff
fetch_max_attempts       = 6        # give up on a tile (mark it FAILED) after this many tries
# Unreachable-area sealing (Stage 13). When you save a map in the builder, EVERY patch of
# open ground with no walkable path to the largest walkable region (an interior courtyard,
# a strip cut off by water, a bridgeless island) is baked into the .map as sealed off, so
# nothing spawns in the trap -- whatever its size. A bridge-connected area is part of the
# main region, so only genuinely unreachable ground is sealed. seal_erode_cells widens
# what counts as unreachable: 0 (default) seals only fully-disconnected areas; N >= 1 also
# seals a pocket reachable only through a neck thinner than ~(2N+1) cells (each cell is
# 2x2 world units), but can sever a genuinely narrow through-street, so raise it only if a
# specific map still leaks. Read when you press S to save; see the F9 debug overlay.
seal_erode_cells         = 0
# Auto-bridge. OSM rarely tags a short canal/river crossing bridge=*, so those roads would
# rasterize as impassable water and the land they lead to would be sealed off (a "blank spot").
# When you save a map, the builder flags any road that crosses a strip of water no wider than
# auto_bridge_max_span (world metres) as a bridge -- carved walkable at play, and kept part of
# the main region by the seal above -- exactly as if you'd marked it by hand with B. A road
# that runs alongside a canal, or dead-ends at the water, is left alone. Both hot-reload (read
# when you press S to save). Set auto_bridge = false to turn it off entirely.
auto_bridge              = true
auto_bridge_max_span     = 50     # widest water gap (m) an untagged road crossing is auto-bridged over
# The STAGES tool's CAMPAIGN TABLE (every stage's civilians, outbreak, money, SP and tick
# cost in one list) and the tick-cost estimate beside the stage's civilian count. The
# estimate is the sim's busiest tick on a stage: cost_base_ms plus cost_per_100k_ms for each
# 100,000 units it starts with (civilians + outbreak zombies), fitted by tools/crowdsweep.sh
# (it prints the fit) to all 72 shipped stages on a 4-core 2.1 GHz PC with 2 workers (2026-11-01:
# within 1.3 ms of the measured peak, 14% on average) -- rerun it on your own PC and paste its
# two numbers here to estimate for that one. The game ticks
# 30 times a simulated second, so a tick of 8.3 ms still runs 4x in real time, 16.7 ms 2x
# and 33.3 ms 1x (the drawing not counted). All hot-reload.
crowd_target             = 250000 # the TABLE flags (red, "!") a stage that seeds more civilians than this; its - / + step it while you work
cost_base_ms             = 0.58   # the estimate's fixed part, ms a tick
cost_per_100k_ms         = 4.84   # the estimate's ms a tick for each 100,000 units (civilians + outbreak zombies)
cost_light_ms            = 8.3    # an estimate up to this is LIGHT (green): 4x game speed holds
cost_heavy_ms            = 16.7   # an estimate past this is HEAVY (red): under 2x game speed; between the two, MEDIUM (orange)

[custom]
# Custom maps: the startup menu's CUSTOM MAP dialog turns a typed place name (a city, town or
# district, from the towns index) or postal code -- US or European -- plus, optionally, two
# cross streets, into a campaign on that place, saved as one of the player's own maps and opened in the map editor. The map
# data (buildings, roads, water, parks, and the postal-code areas) is baked by tools/geobake
# and downloaded from data_url; see tools/geobake/README.md. Every key is read when a map is
# made.

# where the baked data lives: https://<host>/<data version>, or a local directory / file:// URL of a bake. Blank = no maps of real places: the CUSTOM MAP dialog's CREATE says they aren't set up (its BLANK MAP still opens the map editor). v2 (Overture 2026-09-23.1) has the places that give buildings their types; v1 has none and stays hosted for older builds (tools/geobake/README.md, "Baking a new version")
data_url = https://server-hub-d2b2v.ondigitalocean.app/nombies-maps/v2
cache_dir            = cache/geo  # downloaded postal and place-name indexes and map tiles are kept here, per data version
maps_dir             = custom     # where the .map files of campaigns made before the dialog opened the map editor are rebuilt (their .cmp files are player saves in steam_cloud/custom/); new maps are the player's own, in steam_cloud/mymaps/
timeout_seconds      = 30         # per-download timeout
max_search_km        = 25.0       # the cross-street search reads map data no farther than this from the postal code's busiest spot
match_step           = 10.0       # the search list ranks places by how important they are (population, or their kind's floor) and how well they match what is typed: each looser kind of match (the whole name, its start, a later word's start, inside it, a typo) counts a place this many times less important. 10 = "Rom" lists Rome above a hamlet named Rom, and "York" lists York above New York. No country counts for more than another
# The generated campaign: nested round stages around the chosen center, the first one
# grown until it holds enough people, then rings out to a ring
# covering the whole postal area or place -- or, when that is bigger than max_radius (New
# York's final stage, 191 km^2, as a circle), a max_radius ring around the cross streets the
# player is asked for (a postal code) or around downtown or the district the player picks
# (a place). The map loads that ring plus the play area's crop margin, and the LAST stage
# is the whole of it: it has no boundary, so everything the map pulled in plays. Every stage
# plays stage_area_growth times the area of the one before, so a bigger map gets more
# stages rather than bigger jumps.
stage1_radius        = 800.0      # meters: the first stage's radius (2.0 km^2; New York's hand-made stage 1 is 0.88 km^2)
min_stage1_civilians = 2000       # grow the first stage until it seeds at least this many civilians
stage_area_growth    = 3.0        # each stage plays about this many times the area of the one before (3.0 = three times the land a stage, the ring about 1.7x as wide; New York's hand-made campaign averages 1.8). Sets how many stages there are: the steps of this ratio from the first stage to the whole map, rounded to the nearest, then evenly spaced so every step is the same. Floored at 1.39 so each ring holds the last (6 boundary points)
max_radius           = 7800.0     # meters: the biggest a stage may get
min_final_radius     = 1500.0     # meters: the smallest the last stage may be, however small the postal area (some European codes are a single street)
max_stages           = 20         # a backstop only: at 3.0, the biggest map (a max_radius ring) makes about 5 stages; a campaign that would need more steps takes bigger ones
boundary_points      = 6          # control points on each stage boundary but the last: exactly this many, evenly round a circle (the game draws a smooth closed curve through them, so 6 still reads as round, not a hexagon); 3 to 64
# The generated .cmp holds only the stages' boundaries: like every campaign, each stage's
# outbreak size and money are worked out from the land and crowd inside its boundary when it installs
# (outbreak.spawns / spawn_radius = 0, economy.money_base / money_grant_max / money_half_civilians).

# ======================================================================================
# PRESENTATION -- how things are drawn and heard (no effect on play)
# ======================================================================================

[dots]
# Every person on the map -- civilian, zombie, officer, corpse -- is a dot. All hot-reload.
# The settings screen's Unit size (ACCESSIBILITY tab) multiplies size, min_pixel_size and
# max_pixel_size alike, for the player's own copy.
size           = 6.0       # dot size in world units
min_pixel_size = 1.0       # floor on a dot's on-screen size (px); stops flicker when zoomed far out
max_pixel_size = 6.0       # ceiling on a dot's on-screen size (px); stops giant dots when zoomed in close; 0 = no cap
smooth         = true      # true: at 1x and 2x, people are drawn gliding between the sim's ticks instead of hopping at them (the sim ticks 30 times a simulated second, so at 1x a dot would otherwise move 15 times a real second). The dots are drawn one tick (1/30 simulated s) behind the battle, so the range circles and selection rings of moving units can sit a few pixels ahead of their dot. Drawing only: the battle is the same either way. false = draw each tick's positions as they are. 4x and 8x tick every frame and are never smoothed
round          = true      # true: people (civilians, zombies, troops, corpses) are drawn as round dots with a soft edge once a dot is 3 px or more across -- zoomed out, smaller dots stay square, which look the same at that size and draw cheaper; the mine and C4 charges always stay square. false: every dot is a square (the old look, and the cheapest)

[glow]
# Zombie glow -- like a night-time satellite photo of a city: a zombie with no other
# zombie near it stays a dark-green dot with barely any light, and the more zombies stand
# around one, the brighter and paler its light, until a packed horde shines at
# `core_color` and stops there -- a pale lime over the zombie dots, never white, so a
# horde can't be mistaken for the (white) civilians it is chasing. Brightness climbs on a
# log scale (like a camera's exposure of a city at night), so a horde of hundreds still
# reads brighter than a clump of ten instead of both topping out. "Around" means within
# halo_radius, measured in metres, so a bunched horde shines and a scattered one stays
# dark at every zoom. Each zombie's light is a dot-sized point in a full-resolution
# offscreen image, so a street lined with zombies is a sharp bright line (bunched gets
# brighter, not blurrier), with a faint halo around the brightest spots that is sized in
# world units and zooms with the map, and a bloom that spills light round the densest
# cores. Editing `enabled` turns it on/off live, and the
# admin console can toggle it (Ctrl+Space, "toggle glow") without the file snapping it
# back. Everything else hot-reloads.
enabled          = true
dot_color        = 45 150 55   # the zombie dot's own colour while the glow is on: a darker green than colors.zombie, so a lone zombie reads dark and only a crowd's light brightens it (with the glow off the dot is colors.zombie). Much darker than this and a lone zombie melts into the street and the park grass, and the CRT effect's stripes make it look see-through
color            = 40 200 60   # the light's colour when faint: a lone zombie's trace of light, a loose crowd, the halo's edge
hot_color        = 120 255 130 # the light's colour halfway up the crowd ramp: a busy crowd (about 12 neighbours at crowd_size 150)
core_color       = 180 255 90  # the light's colour at full brightness, and the MOST it ever adds; a packed horde shows as dot_color plus this (a pale lime). 255 255 255 is an over-exposed white, which looks like civilians
lone_brightness  = 0.25   # how bright (0..1 of full) a zombie shines with no other zombie within halo_radius; 0 = only its dark dot shows
crowd_size       = 150    # how many other zombies within halo_radius make a zombie shine at full brightness; fewer is dimmer along a log curve, so each doubling of the crowd adds the same step of brightness (1 neighbour is about 14% of the way, 12 halfway, 50 about 80%). One standing right beside it counts 1, one halfway out to halo_radius about half, one at halo_radius nothing
splat_scale      = 2.0    # each zombie's light point, as a multiple of its drawn dot (1 = the dot itself)
splat_min_pixels = 2.0    # floor on the point's on-screen diameter (px) so it still covers a pixel when zoomed far out
halo             = 0.04   # the halo's strength: the share of each zombie's light spread out over halo_radius around it, only noticeable around a big bright crowd (0 = no halo)
dense_halo       = 8.0    # how much the halo grows with density: the densest core (crowd_size neighbours) gets 1 + this times a lone zombie's halo, so a packed horde spills light past its edge while a loose crowd stays sharp (0 = the same halo everywhere)
bloom            = 1.5    # the bloom: how strongly the densest cores spill light out round them, like a camera over-exposing a city's brightest blocks; only a dense crowd emits (its density on the crowd_size log curve, squared), and the bloom fills in only where the zombies' own light is dim, so a core never passes core_color. 0 = no bloom, and its passes are skipped (it runs on the small crowd image, a fraction of the glow's cost)
bloom_levels     = 4      # how far the bloom reaches: each level is one more half-size blur step and doubles the reach (4 is about 6x halo_radius); 1..6. More levels add tiny passes, so cost barely moves
halo_radius      = 20.0   # in world units (metres on an OSM map): how close zombies must stand to count as bunched (see crowd_size), and how far the halo reaches; it shrinks and grows with the camera. 0 = every zombie shines at lone_brightness, with no halo
close_zoom_start = 1.0    # camera zoom (pixels per world unit, as [camera] zoom_min) past which zooming in dims the glow, so single zombies can be made out up close instead of drowning in the halo; 0 = never dims
close_zoom_full  = 3.0    # camera zoom at which that dimming is complete (camera.zoom_max is 8); between the two the glow fades evenly
close_brightness = 0.2    # 0..1: the glow at close_zoom_full and closer, as a share of the zoomed-out glow -- its light and its halo and bloom alike (the settings' Zombie glow slider still applies on top)

[projectiles]
# How rounds, shells and muzzle flashes are drawn in flight: every gun's round streaks
# (bullet_*), the sniper's and the helicopter's own round speeds, the mortar's and the
# battleship's shell dot, and the flash at the muzzle. Drawing only: a lethal shot's
# death is fixed when it is fired, whatever these say. All hot-reload.
bullet_speed     = 700.0   # how fast a fired round flies from shooter to target, world units/sec
bullet_length    = 2.0     # a flying round's streak length at 1/2x (half real time), world units (police, garrison, Turret, APC and helicopter rounds); a faster game speed draws it as many times longer: 1x = twice, 2x = 4 times, 4x = 8 times
bullet_width_px  = 2.0     # how thick a flying round's streak is drawn, screen pixels -- every gun's rounds, the sniper's too; the thinnest it is drawn at bullet_thin_zoom and closer in (zoomed in it grows with bullet_width_m)
bullet_width_m   = 0.6     # zoomed in, a round's streak is this many world meters wide when that is more than bullet_width_px (0.6 m = 4.8 px at camera.zoom_max 8), up to bullet_width_max_px
bullet_width_max_px = 5.0  # the widest a round's streak is ever drawn, screen pixels, however far zoomed in
bullet_min_length_px = 6.0 # the shortest a round's streak is drawn, screen pixels (stretched to it when its world length is shorter on screen, never behind the muzzle)
bullet_glow_alpha = 0.45   # a soft tracer-coloured glow, three times the streak's width, around each round; its opacity once the streak is bullet_width_max_px wide, fading to none as the streak thins to bullet_width_px (so zoomed out there is no glow). 0 = no glow
muzzle_flash_seconds = 0.08  # a gun's muzzle flash lasts this many real seconds (frozen while the game is paused; drawing only)
muzzle_flash_m        = 1.6  # radius of the muzzle flash at a garrison's / sniper's window, world meters
muzzle_flash_min_px   = 5.0  # ... never drawn smaller than this radius on screen, pixels
muzzle_flash_ground_m = 0.8  # radius of the muzzle flash of a gun on the ground (police, Turret, APC), world meters; 0 = none
muzzle_flash_ground_min_px = 2.5 # ... never drawn smaller than this radius on screen, pixels
bullet_thin_zoom = 0.45    # zoomed out past this camera zoom (screen pixels per world unit: the F11 HUD's ZOOM line), every round's streak is drawn thinner, shrinking steadily to nothing at bullet_hide_zoom -- far out a streak a few pixels wide would cover tens of meters. Under one pixel it is drawn one pixel wide and that much fainter
bullet_hide_zoom = 0.25     # at this camera zoom and farther out (fully zoomed out is camera.zoom_min, 0.05), rounds in flight are not drawn at all; 0 = never hidden
sniper_bullet_speed = 2400.0  # how fast a sniper round flies, world units/sec (vs projectiles.bullet_speed 700)
sniper_bullet_length = 4.0     # a sniper round's streak length at 1/2x (half real time), world units; a faster game speed draws it as many times longer, like projectiles.bullet_length
shell_size     = 1.0     # the in-flight shell dot's base on-screen size in pixels (before shell_apex_scale); lower = smaller shell
shell_apex_scale = 2.2     # the shell dot grows to this multiple of its size at the top of its arc, shrinking back as it lands
shell_arc_height = 0.3     # a mortar / battleship shell's arc tops out this many times the shot's ground distance up (0.3: a 400 m shot peaks 120 m up). Seen in the tilted and perspective views, where the shell and its trail are drawn up in the air; straight down and flat the path is a line. 0 = flat
shell_trail_seconds = 0.6 # a shell leaves a white trail: each point of it fades out this many game seconds after the shell passes, and the whole trail fades away this long after impact. 0 = no trail
shell_trail_width_px = 2.4 # the trail's hot core right behind the shell, screen pixels (the same at any zoom); it tapers to a third of this at the tail
shell_trail_glow_px = 10.8 # the soft glow round the trail right behind the shell, screen pixels; it tapers like the core
shell_trail_glow_alpha = 0.55 # the glow's opacity right behind the shell, fading with the trail (0 = no glow)
heli_bullet_speed   = 1400.0 # how fast the gatling rounds fly from heli to target, world units/sec (drawing only; 3x projectiles.bullet_speed's 700)
railgun_beam_width_m = 2.5     # world meters wide a railgun round's white-hot core is drawn; its orange glow spreads 3x as wide round it
railgun_beam_min_px = 5.0       # screen pixels: a railgun round is never drawn thinner than this, however far out the camera is (it is not hidden with the other rounds)
railgun_beam_seconds = 0.8      # seconds a railgun round's beam glows on, fading out, once its head reaches where it stops (a building or the map's edge)

[overlays]
# The aim preview of every tool with a radius -- the airstrike / fire bomb / stun gas
# footprints, the helicopter's kill and leash circles, Call to Arms, the paratrooper /
# decoy spray circle, the mortar / garrison / mine / C4 cursor rings and the DETONATE
# pick, the evac hold circle being dragged, plus the inbound-drop ghosts and battle-replay
# previews of those. All share these two keys. Hot-reloads.
ring_width_px   = 3.0   # thickness of every tool's radius ring, in screen pixels (the same at any zoom)
ring_fill_alpha = 0.12  # opacity (0-1) of the translucent fill inside each tool ring, times the ring's own opacity; 0 = no fill
demolition_width_px   = 2.0   # thickness of the outline of the strip an aimed Controlled Demolition would land across, in screen pixels (the same at any zoom)
demolition_fill_alpha = 0.35  # opacity (0-1) of that strip's fill (colors.demolition), times the colour's own opacity; 0 = no fill
# The always-on unit range fills (sniper cones, garrison / Turret discs, mortar rings, mine /
# C4 blasts) darken where they overlap; past this many on one spot, more add nothing, so
# a dense field of towers still reads as layers rather than one solid colour. The
# hovered / selected unit's fill is laid first, so it always shows. Hot-reloads.
range_fill_max_layers = 3 # overlapping range fills that darken one spot of ground (1-7; 0 = no cap)
# Markers drawn over the map:
crosshair_size          = 48.0   # on-screen pixels: the planning crosshair a dev scenario's fixed [spawns] point shows (constant at any zoom; min 8)
# Last-zombies markers: once fewer than last_zombies_below zombies are left on the map
# during the live game, every one of them is ringed by a green circle so the last
# stragglers can be found. Both hot-reload.
last_zombies_below      = 10     # ring every zombie while the zombie count is under this (0 = never)
last_zombies_ring_px    = 20     # the ring's radius in on-screen pixels (constant at any zoom)
# Out of ammo label: a red "Out of ammo" rises off each gun as it runs dry (colors.out_of_ammo_text).
out_of_ammo_text_seconds = 2.0   # seconds the label takes to rise and fade away (it holds while paused)
out_of_ammo_text_rise    = 48    # how far it rises over that time, in on-screen pixels
# Warning line: the one-line notice (a refused click, an empty key, a tool hint, INBOUND) on a
# black band centred just above the command bar.
warning_line_seconds     = 2.5   # seconds of real time it holds before fading out
warning_line_jump_seconds = 0.45 # seconds its hop takes each time an error is raised (again while up, too; 0 = no hop)
warning_line_jump_px     = 14    # how high that hop goes, in on-screen pixels

[particles]
# The burning patches (a fire bomb's, a fire mortar's, the greenspace a fire spread to) and
# the gas bomb's cloud ([gas_bomb]) are drawn with the artist's particle art ([art]
# fire_sprite, fire_smoke_sprite, gas_wisp_sprite). A patch: flames flickering over a
# scorched, glowing ground, each catching yellow (colors.flame_hot) and dying away red
# (colors.flame_cool) as it floats up and leans downwind, and smoke rising off it: each puff born small and
# light grey (colors.smoke_light), darkening (colors.smoke_dark), swelling and thinning to
# nothing as the wind carries it off, every puff the same way. Flames are drawn on the
# ground under the buildings, smoke over them. A cloud: drifting wisps over a faint ground
# haze. The counts are per patch / cloud, from its area; those out of view draw nothing, and
# a kind drawn smaller than 1.5 pixels (zoomed far out) is left out. Drawing only: nothing
# here touches the battle. All hot-reload.
fire_wind_angle     = 60      # degrees: the way the wind blows the flames and smoke, for every fire at once (0 = east, right on the flat north-up map; 90 = north, up)
fire_wind_speed     = 9.0     # meters a second the smoke drifts downwind
fire_flame_density  = 0.1     # flames burning at once per world-unit^2 of a patch (a 48 m fire bomb patch: 720; an 8 m cell of burning greenspace: 10)
fire_flame_size     = 3.0     # meters across a flame at its biggest (each varies +-40%)
fire_flame_life     = 0.8     # seconds a flame lives, catching and dying away (each varies +-40%); shorter = more flicker
fire_flame_rise     = 2.0     # meters a second a flame floats up the screen as it burns (leaning a little downwind)
fire_flame_additive = 0.6     # how additive a flame is (0 = blended, 1 = additive): overlapping flames brighten each other
fire_smoke_density  = 0.015   # puffs of smoke at once per world-unit^2 of a patch (a 48 m fire bomb patch: 110; an 8 m cell: 1.5). A big fire's puffs run together into one black cloud
fire_smoke_size     = 6.0     # meters across a puff of smoke at birth (each varies +-20%)
fire_smoke_size_end = 60.0    # meters across a puff of smoke as it dies away (each varies +-20%)
fire_smoke_life     = 12.0    # seconds a puff of smoke lives (each varies +-30%)
fire_smoke_alpha    = 0.8     # a puff's opacity at birth (0..1); it holds most of it through the first half of its life, then thins to nothing
fire_smoke_spread   = 1.5     # meters a second a puff wanders off the wind's line, at most (each its own way)
fire_smoke_rise     = 12.0    # meters a second a puff climbs into the air as it drifts (about 150 m over its life); it is born half its width up. The puffs are drawn far to near, so they layer right from any angle
fire_max_flames     = 6000    # cap on the flames drawn at once; past it every fire in view draws the same share of its own
fire_max_smoke      = 3000    # cap on the puffs of smoke drawn at once; past it every fire in view draws the same share of its own
fire_smoke_max_cover = 4.0    # at most this many layers of smoke over the ground in view, on average (big puffs drawn over each other cost the graphics card the most): past it every fire in view draws the same share of its own. 4 layers already read as solid black
gas_wisp_size  = 30.0    # meters across a wisp as it is born (each varies +-33%); it swells to 2.5x as it drifts
gas_wisp_density = 0.0003  # wisps per world-unit^2 per second (a 350 m cloud: about 350 at once)
gas_wisp_life  = 3.0     # seconds a wisp lives (mean; each varies +-30%)
gas_max_particles = 4000    # cap on the wisps drawn at once; past it every cloud in view draws the same share of its own
gas_haze_alpha = 0.01    # opacity of the cloud's ground haze disc (0 = invisible, 1 = solid)
gas_wisp_alpha = 0.16    # peak opacity of each wisp (0 = invisible, 1 = solid); a few overlap anywhere in the cloud

[kill_marks]
# Kill markers (src/killmarks.odin): while one gun is selected in battle (a garrison, sniper,
# mortar, Turret, battleship or officer), each zombie it kills flashes a hitmarker where it
# drops -- an X of four short strokes with a gap in the middle (colors.kill_mark) that pops in
# and fades. A fixed size on screen at any zoom. Drawing only: the battle plays out the same
# whatever is selected. All hot-reload.
enabled      = true    # show the markers (false = none, and the sim reports nothing)
seconds      = 0.45    # seconds a marker lasts, popping in and fading out
size_px      = 8       # screen pixels each of the X's four strokes runs
gap_px       = 4       # screen pixels from the kill's spot to where each stroke starts (the X's open middle)
thickness_px = 3       # screen pixels wide a stroke is
max_marks    = 128     # most markers shown at once (at most 1024); past it a new one replaces the oldest
max_per_tick = 24      # most markers one tick's kills start: a shell or volley that kills more shows this many, spread evenly over its victims

[kills_meter]
# The battle STATS panel's kills meter (src/battlestats.odin): a one-time deployment's row
# (airstrike, fire bomb, cluster bomb, stun gas, cruise missile, The Cure, nuke, demolition,
# mines, C4, napalm drums, oil slicks) shows the kills it just made as a bright piece at its
# bar's end (colors.recent_kills) with a +N beside its number, the way a game's health bar
# shows the health just lost. Real seconds, so it reads the same at any game speed. Drawing
# only. All hot-reload.
recent_hold_seconds   = 1.5   # seconds the bright piece and its +N hold after the row's last new kill (new kills meanwhile restart it and add to the same +N)
recent_max_hold_seconds = 4.0 # most seconds that hold lasts from the first of those kills, however long new ones keep coming (a strike's fires kill a few a second), so the piece still settles; later kills join the shrinking piece and its +N
recent_shrink_seconds = 1.0   # seconds the bright piece then takes to shrink into the bar, its +N fading out with it (0 = gone at once)

[fonts]
# Font files: every .ttf / .otf in fonts/ is listed on the settings screen's Font chooser
# after the six built-in bitmap fonts (src/fontfiles.odin). A font file is drawn as the font
# intends, each letter its own width; a line is still one 8x8 text cell tall. Hot-reloads.
line_height = 1.3          # a font file's line height (its ascent to descent) as a share of a text cell's height, 0.25 - 2: 1 fits the whole line in the cell, but a font's line holds room above its capitals and below its letters, so a little more reads bigger without touching the next line; too much and lines overlap

[art]
# Art for the machines: the helicopter, the bomber plane, the paratrooper transport,
# and a bomb in flight. Everything the player sees of them is emitted through one
# seam (src/art.odin), so swapping the built-in vector silhouettes for real images
# touches only that file -- see docs/art-assets.md for the step-by-step.
# *_scale multiplies the size (1.0 = as designed) and works now.
# *_sprite names a PNG image to draw instead of the built-in vector silhouette;
# blank = draw the vector art. Images are drawn nose-right (+X), centered, mapped
# onto a quad sized art_spec.length long with the image's own aspect (a square PNG
# stays square). The helicopter's rotor is a second image (heli_blades_sprite) drawn
# over the body and spun so the blades turn. All hot-reload.
heli_scale    = 6.0
bomber_scale  = 6.0
para_plane_scale = 6.0
ac130_scale   = 8.0   # the AC-130 gunship (ac130_sprite, or the bomber's vector silhouette), larger than the paratrooper transport
ac130_missile_scale = 0.8 # an AC-130 missile in flight: the cruise missile's image (missile_sprite) at this size times 12 m (nothing drawn without it; its smoke trail still shows)
bomb_scale    = 1.0
heli_sprite         = art/vehicles/helicopter-body.png
heli_blades_sprite  = art/vehicles/helicopter-blades.png
bomber_sprite       = art/vehicles/b2-bomber.png
para_plane_sprite   = art/vehicles/paratrooper-plane.png
ac130_sprite        = art/vehicles/ac-130.png # the AC-130 gunship, tinted colors.ac130
bomb_sprite    =
# The armored personnel carrier, nose right. Unlike the aircraft it is sized by the vehicle
# in the image, not the canvas around it (the transparent margin doesn't count): that is
# drawn apc_scale times 8 m long -- 16 m at 2.0, about 6 m wide with this image's
# proportions -- centred on the APC and turned with its hull, and never under 20 px long on
# screen. Blank (or a missing file) draws a plain marker instead: a disc in colors.apc with
# a short line toward its heading.
apc_scale      = 2.0
apc_sprite     = art/vehicles/APC.png
# The tank, nose right: its hull (tank_sprite) is sized like the APC's, by the vehicle in the
# image -- tank_scale times 8 m long (16 m at 2.0) -- centred on the tank and turned with its
# hull, the way it drives. Its turret and gun (tank_turret_sprite) is a second image on the same
# canvas as the hull's, laid over it and turned about the pixel tank_turret_pivot_x /
# tank_turret_pivot_y (from the image's top left) to the way the gun points (tank.turret_turn_rate).
# Blank tank_sprite = the APC's image tinted colors.tank; blank tank_turret_sprite = no turret.
tank_scale     = 2.0
tank_sprite    = art/vehicles/tank_body.png
tank_turret_sprite = art/vehicles/tank_top.png
tank_turret_pivot_x = 370
tank_turret_pivot_y = 400
# The cruise missile in flight is drawn missile_scale times 12 m long (the missile in the
# image, not its canvas) -- 30 m at 2.5 -- nose along its heading, and never under 48 px long
# on screen, with a white streak behind it. Blank missile_sprite = nothing is drawn in
# flight but the streak and the ring on its target.
missile_scale  = 2.5
missile_sprite = art/cruise-missile.png
# A mortar or battleship shell in flight is drawn shell_scale times 6 m long (the shell in
# the image) -- 12 m at 2.0, 40% of the cruise missile -- nose along its flight, rolled to face
# the camera, the same size in the world at every zoom, swelling toward the top of its arc
# (projectiles.shell_apex_scale).
# Blank shell_sprite = a plain dot in colors.mortar_shell (projectiles.shell_size).
shell_scale    = 2.0
shell_sprite   = art/mortar-shell.png
# The battleship, bow right, drawn as long as its hull (battleship.length), centred on it and
# turned with it -- sized, like the APC, by the ship in the image, not the canvas around it
# (battleship.png: a 1600 x 800 canvas, the ship 1535 x 176 px of it). Blank (or a missing
# file) draws a plain rectangle the size of the hull instead (the water it takes up), in
# colors.battleship.
battleship_sprite = art/vehicles/battleship.png
# The broken-wall marker flag (dropped by RETRY on each wall section that broke) is not a
# machine but draws through the same sprite pass: flag_sprite is its image (blank = a plain
# pole + ring) and flag_scale multiplies its on-screen size -- a flag is a marker, so it
# keeps one screen size at any zoom, like the planning crosshair. Both hot-reload.
flag_sprite    = art/red-flag.png
flag_scale     = 1.0
# The game's logo, drawn on the menus in place of the title text: the campaign globe (above the
# globe, fading as it zooms in), the startup menu, the pause menu, the loading screen, the
# credits and the playtest welcome. Each screen sizes it to its own space, and it is never drawn
# bigger than the image's own pixels. Blank (or a missing file) = the title as text, as before.
# Hot-reloads.
logo_sprite    = art/game-logo-horizontal.png # the artist's 2510 x 390 logo scaled to 1600 wide
# The lock on a campaign not open yet (src/campaignlock.odin): drawn on its row of the campaign
# list and its panel, globe.lock_px across. Blank (or a missing file) =
# no icon; the row still says LOCKED. Hot-reloads.
lock_sprite    = art/lock.png
# The Discord logo on the DISCORD buttons (src/discord.odin): the Early Access welcome's and the
# campaign globe's / startup menu's, drawn white left of the label, the label's height and a bit.
# Discord's own logo (its SVG rasterized white at 128 px). Blank (or a missing file) = the label
# alone. Hot-reloads.
discord_sprite = art/discord-logo.png
# The smoke particle: each puff of the dust a collapsing building throws up ([collapse]) is
# drawn with this image, tinted colors.collapse_smoke, turned square to the camera and a little
# each way, about the puff's size. Blank (or a missing file) draws each puff as a plain soft
# disc instead. Hot-reloads.
smoke_sprite   = art/particle-smoke.png
# The mushroom cloud's puff ([mushroom]): each is drawn with this image, tinted colors.mushroom_hot
# cooling to colors.mushroom_smoke, turned square to the camera. Blank (or a missing file) draws
# no cloud. Hot-reloads.
mushroom_sprite = art/particle-smoke.png
# A satellite orbiting the campaign globe ([globe] satellite_*): drawn with this image, nose
# along its path, satellite_px pixels long. Blank (or a missing file) = a plain dot. Hot-reloads.
satellite_sprite =
satellite_px    = 28.0
# The particle images of the fire bomb's burning patches and the gas bomb's cloud ([particles]
# has how many are drawn, how big and for how long). A blank or missing image leaves its
# particles out. Hot-reload.
fire_sprite    = art/flame.png            # a flame's image, tip up (white: tinted colors.flame_hot .. flame_cool)
fire_smoke_sprite = art/smoke.png         # a puff of smoke's image (white: tinted colors.smoke_light .. smoke_dark)
gas_wisp_sprite = art/particle-smoke.png   # a wisp's image (white: drawn in colors.gas); blank or missing = no wisps, just the haze disc

[collapse]
# A levelled building (an airstrike bomb, a C4 charge, a fuel building going up, or blasts that
# wore it down to nothing) doesn't vanish: it shakes, then sinks into the ground ever faster,
# tipping over a little, its shadow shrinking with it, while puffs of smoke ([art]
# smoke_sprite, tinted colors.collapse_smoke) billow out from its outline and drift up and
# away. In the flat view its footprint fades out instead of sinking. Drawing only:
# units walk over the ground it stood on from the moment it is levelled. Times are in game
# seconds, so pause freezes a collapse and 2x plays it faster (at 1/2x they take twice as long in
# real time). All hot-reload.
shake_seconds    = 0.4      # seconds a levelled building shakes before it starts to sink (it keeps shaking, less and less, as it sinks)
sink_seconds     = 1.4      # seconds a building 20 m tall or shorter takes to sink all the way into the ground
sink_seconds_tall = 0.6     # seconds a building 100 m tall or taller takes (a building in between: on the straight line between the two)
shake_meters     = 0.2      # how far, in meters, a collapsing building shakes side to side...
shake_min_px     = 1.0      # ...but never under this many pixels on screen, so the shake still shows zoomed out (never more than a tenth of the building's width either way)
lean_degrees     = 4.0      # degrees a collapsing building tips over, a random way, by the time it is gone (0 = straight down)
smoke_seconds    = 3.5      # seconds one puff of dust lives: it billows out and rises, then thins away
smoke_spacing    = 2.5      # meters of the building's outline per puff of dust (a 40 x 20 m building: 48 puffs); at least 4 and at most 60 a building
smoke_radius     = 7.0      # meters a puff of dust billows out to beside a building 10 m tall or shorter
smoke_radius_tall = 22.0    # meters a puff billows out to beside a building 100 m tall or taller (in between: on the straight line between the two)
smoke_max        = 2000     # most puffs of dust alive at once: a C4 blast levelling a whole block shares them out among its buildings (0 = no dust)

[mushroom]
# The mushroom cloud: a fireball that climbs on a stem of smoke and spreads into a cap -- a
# ring of smoke rolling up through its middle, out over its top and down its outside -- while
# a ring of dust rolls out along the ground under it. It is built from puffs of [art]
# mushroom_sprite, each turned square to the camera, so it reads the same flat or tilted;
# each puff starts white-hot (colors.mushroom_flash), turns orange-yellow (colors.mushroom_hot),
# then darkens to colors.mushroom_smoke -- the dust ring first, most of the cloud soon after,
# a share of it glowing on much longer. Every puff's place is worked out afresh each frame
# from these keys and the cloud's age, so an edit here reshapes the clouds already up.
# Drawing only (the NUKE's cloud, nuke.cloud_scale times this, and the globe nukes'): the
# admin console's "mushroom cloud" puts one at the cursor ("mushroom cloud repeat" keeps one
# going there).
# Times are in game seconds (pause freezes a cloud; during planning it runs on real time).
# All hot-reload.
duration            = 15.0     # seconds a cloud lasts from the blast until its last puff is gone
fade_seconds        = 8.0      # seconds at the end of its life over which it thins away to nothing, easing out so it thins visibly at once (duration - fade_seconds = when it starts: 7 s, as the cap all but tops out)
fade_swell          = 0.6      # how much bigger each puff grows as the cloud thins away, as a share of its size (0 = it only goes see-through), so it loosens and drifts apart instead of standing still
rise_seconds        = 10.0     # seconds the cap takes to climb to its full height and grow to its full size
start_height        = 15.0     # meters up the fireball starts
height              = 320.0    # meters up the middle of the cap ends
cap_start_radius    = 10.0     # meters from the middle to the cap's ring at the blast
cap_radius          = 120.0    # meters from the middle to the cap's ring at full size
cap_start_thickness = 12.0     # meters: the radius of the ring's tube at the blast
cap_thickness       = 55.0     # meters: the radius of the ring's tube at full size
cap_flatten         = 0.9      # how tall the tube is for its width (1 = round, under 1 = squashed flat)
cap_puffs           = 140      # puffs round the cap's ring
dome_puffs          = 90       # puffs in the cap's dome over the ring's hole
roll_speed          = 0.12     # turns a second the ring rolls: up the middle, out over the top, down the outside
puff_start_radius   = 12.0     # meters: a cap puff's size at the blast
puff_radius         = 38.0     # meters: a cap puff's size at full size
stem_puffs          = 70       # puffs in the stem
stem_radius         = 42.0     # meters: the stem's radius at the ground
stem_top_radius     = 22.4     # meters: the stem's radius where it meets the cap
stem_puff_radius    = 28.0     # meters: a stem puff's size
stem_speed          = 35.0     # meters a second the stem's puffs climb
skirt_puffs         = 140      # puffs the dust ring sends up off the ground over skirt_emit_seconds
skirt_radius        = 220.0    # meters out the dust ring drifts to
skirt_seconds       = 6.0      # seconds the dust ring takes to drift out from skirt_start_radius to skirt_radius
skirt_height        = 12.0     # meters up off the ground a dust ring puff starts, at most
skirt_puff_radius   = 18.0     # meters: a dust ring puff's size
jitter              = 0.35     # how far a puff strays from its place, as a share of its own size (0 = a neat shape)
puff_scale          = 0.5      # every puff's size times this, and every part's puff count times 1 / this squared, so the cloud keeps its shape and fill: 0.5 = puffs half the size, four times as many (more puffs cost more to lay out each frame); 0.25 .. 4
cool_seconds        = 3.0      # seconds a puff (not a glowing one, nor the dust ring's) takes to cool from colors.mushroom_hot to the dark colors.mushroom_smoke after its white-hot flash (each a little sooner or later)
flash_seconds       = 0.6      # seconds a puff takes to go from white-hot (colors.mushroom_flash) at the blast to colors.mushroom_hot
glow_share          = 0.35     # share of the cap, dome, collar and stem, about, that keeps glowing hot for glow_seconds while the rest darkens in cool_seconds, in clumps glow_clump_size across (0..1)
glow_seconds        = 12.0     # seconds a glowing puff takes to cool from colors.mushroom_hot to colors.mushroom_smoke (each a little sooner or later)
dome_height         = 90.0     # meters the cap's dome bulges up over its ring at full size, so the top is round, not flat
skirt_start_radius  = 120.0    # meters out the dust ring is at the blast: it is there at once and drifts out to skirt_radius over skirt_seconds
skirt_emit_seconds  = 4.0      # seconds over which the dust ring keeps sending up new puffs off the ground (a quarter of skirt_puffs go up at the blast)
skirt_rise_height   = 45.0     # meters a dust ring puff climbs over skirt_rise_seconds, so the ring rises and thickens upward
skirt_rise_seconds  = 6.0      # seconds a dust ring puff takes to climb skirt_rise_height (easing out), growing from 0.6 to 1.4 times its size as it goes
skirt_cool_seconds  = 1.5      # seconds the dust ring takes to cool from colors.mushroom_hot to colors.mushroom_smoke: much sooner than the mushroom
skirt_clump         = 0.8      # 0..0.95: how lumpy the dust ring is -- its puffs bunch into mounds (bigger, taller, thicker) with thin gaps between, and its edge wanders in and out (0 = an even ring)
glow_clump_size     = 70.0     # meters across the clumps the glowing puffs and the darker smoke come in (bigger = fewer, larger patches)
collar_puffs        = 70       # puffs in the collar: the ring of smoke rising round the column, under the cap
collar_start_height = 10.0     # meters up the collar is at the blast
collar_height       = 150.0    # meters up the collar rises to, over rise_seconds
collar_start_radius = 25.0     # meters from the middle to the collar's ring at the blast
collar_radius       = 85.0     # meters from the middle to the collar's ring at full size
collar_thickness    = 18.0     # meters: the radius of the collar's tube at full size
collar_puff_radius  = 24.0     # meters: a collar puff's size at full size
bloom_strength      = 0.10     # how strongly a hot puff glows: a bigger, faint copy of it in colors.mushroom_bloom whose light ADDS over the cloud (so where hot puffs crowd it builds toward white), this opaque at white-hot and fading as the puff cools (0 = no bloom)
bloom_size          = 1.5      # a puff's bloom's size, times the puff's (bigger spills a wider halo, but covers more of the screen)
shade_bottom        = 0.55     # brightness of the cap's underside, times its top's (1 = no shading)
spin                = 0.25     # radians a second, at most, a puff's image turns

[water]
# The water (rivers, lakes, sea) is painted like a topographic map with no contour lines:
# band_count flat shades, from shallow_color along every shore to deep_color. Its "depth"
# is the distance from the shore (climbing steeply, then flattening, to full shore_ramp
# meters out) blended with a smooth, swirled noise of lobed blobs (about noise_scale
# meters across) that holds noise_amount of the range -- so the water touching the shore
# is always the shallowest band, and past it the contours wander on their own, bunch and
# spread, and close into deep holes and shoals instead of running parallel to the shore.
# Out at sea -- more than 255 m from any land -- the water fades to deep_color over
# open_fade meters, so wide water is one deep basin instead of shoals far from shore;
# rivers and lakes narrower than about 510 m never reach it.
# With the camera tilted (or toward a perspective camera's edges) each band reads as a
# terrace terrace_depth meters below the one before, the deeper ones sliding away and
# each step's face showing darker: a sunken basin. Slow crossing ripples move the surface
# gently; they fade out when zoomed too far out to show. Drawing only, no gameplay
# effect. Everything hot-reloads (an edit to the four shape keys re-bakes the map's
# water, a short hitch).
shallow_color   = 58 116 150     # the shallowest band, along every shore
deep_color      = 20 46 88       # the deepest band
band_count      = 4      # how many shades from shallow_color to deep_color (2..16)
shore_ramp      = 250    # meters from the shore over which the shore's part of the depth climbs to full (1..255); bigger = gentler shallows
noise_scale     = 820    # the size of the noise's blobs, meters: bigger = broader, calmer shapes; smaller = busier
noise_amount    = 0.7    # the noise's share of the depth, 0..1: 0 = bands parallel to the shore; higher = contours wander more and the shore matters less
open_fade       = 300    # meters, beyond 255 m from the shore, over which the water fades to deep_color: smaller = deep sooner; 0 = no fade (shoals anywhere)
terrace_depth   = 8      # how far each band's terrace sinks below the one before, meters, for the tilted 3D look; 0 = a flat map at any tilt
wall_shade      = 0.7    # a terrace step's face, as seen tilted, as a multiple of its shade (1 = no darker)
ripple_strength = 0.03   # the ripples' brightness swing (0.03 = +-3%); 0 = a still surface
ripple_length   = 18     # the ripples' wavelength in meters
ripple_speed    = 1.5    # how fast the ripples drift, meters per second (real time)

[camera]
zoom_min   = 0.05            # pixels per world unit, fully zoomed out
zoom_max   = 8.0            # pixels per world unit, fully zoomed in
pan_speed  = 1.0
zoom_speed = 16.0           # wheel-zoom easing rate per second (higher = snappier; 0 = instant/no easing)
key_zoom_speed = 1.2        # steady zoom rate while Shift+W (in) / Shift+S (out) is held, in e-folds per second (higher = faster zoom)
key_zoom_ease  = 6.0        # how fast the held-key zoom ramps up on press and eases off on release (per-second; higher = snappier, lower = softer glide; 0 = instant)
glide_speed    = 3.0        # middle-click camera glide: how fast the view eases toward centering on the clicked point (per-second approach; higher = snappier; 0 = instant jump). Middle-drag still pans.
reveal_hold_seconds = 0.0   # campaign stage transition with the intro turned off (settings screen, or intro_seconds 0): how long the camera holds still on the just-won stage's view before it glides to the new stage (0 = glide immediately). The intro itself never holds
# The tilted 3D view: Alt+middle-drag tips the camera back (drag up / down) and turns it (drag
# left / right), like Google Maps.
# Tipped, the buildings stand up at their heights ([view3d]); the crowd and every unit stay
# flat dots. Every tool and click works tilted (a click lands on what is under the cursor).
tilt_max        = 60.0      # degrees: the most the camera tips off straight down (at most 80; with a perspective fov, kept low enough that the horizon stays off the screen). 0 = no tilting at all
fov             = 35.0       # degrees: the camera's vertical field of view. 0 = orthographic: no perspective, walls stay parallel, and looking straight down the buildings are flat (the game's original flat view). 20-50 = perspective like Google Maps, at every tilt: looking straight down the ground is drawn just as flat, but the buildings lean out from the middle of the screen, so panning shows their walls (a smaller fov leans them less); tilted, far things are smaller and buildings converge. Zoomed right in, the tallest towers can reach past the camera
fov_fade_zoom   = 0.35       # zoom (pixels per world unit, as zoom_min) under which zooming out eases the perspective off, to save drawing the 3D buildings -- only while looking straight down; a tilted camera keeps the whole fov: the fov shrinks in step with the zoom, from fov here to 0 at fov_flat_zoom. 0 = never
fov_flat_zoom   = 0.25      # zoom at and under which the fov is 0 (orthographic): looking straight down, the buildings lie flat as their footprints, with no walls -- far cheaper to draw (a tilted camera still stands them up, in full perspective)
tilt_drag_speed = 0.25      # degrees of tilt per pixel of vertical Alt+drag (drag up = tip further back)
turn_drag_speed = 0.3       # degrees of turn per pixel of horizontal Alt+drag (drag right = turn the camera right); negative turns the other way
tilt_ease       = 8.0       # how fast the admin console's tilt commands ease the camera (per-second approach rate; higher = snappier; 0 = instant)
# The new-scenario intro: when a scenario or campaign stage is loaded (not on a RETRY), the
# camera tips down low, sweeps a little way round the stage, then tips back up and turns
# back to the flat north-up view. After a campaign stage is won it starts on the old
# stage's view and blends into those moves, so the camera never jumps. Any key or mouse
# press skips it to the end; the player can turn it off on the settings screen. Drawing
# only: the planning board is usable once it settles (or is skipped).
intro_seconds   = 8.0       # seconds the intro takes from its first frame to settling top-down (lower = faster; 0 = no intro)
intro_tilt      = 60.0      # degrees the camera tips down to, off straight down (held to tilt_max)
intro_turn      = 25.0      # degrees the camera sweeps round the stage while tipped down, before turning back north-up (negative = the other way round)
intro_zoom      = 1.8       # the zoom while tipped down, as a multiple of the stage's framing: above 1 fills more of the screen (1 = no zoom). The camera zooms in as it tips and back out as it comes flat

[view3d]
# How the buildings (and, at the end, the machines) look standing up in 3D -- tilted
# ([camera] tilt_max), or with a perspective camera ([camera] fov > 0) at any tilt. Each
# building stands at its height from the map data, as its roof (its footprint, in its usual
# colour) on walls shaded by which way they face the sun, and casts a shadow on the ground
# away from the sun (in the flat view too). Drawing only: a sniper's range bonus still comes
# from the map's height alone (building.height_cap). All hot-reload.
unknown_height  = 9.0       # meters a building with no height in the map data stands in the 3D view (about three floors)
wall_shade_lit  = 0.9       # brightness of a wall facing the sun, as a multiple of the building's colour (1 = as bright as its roof)
wall_shade_dark = 0.55      # brightness of a wall facing directly away from the sun (walls in between shade smoothly)
sun_from        = 225.0     # compass bearing, degrees, the sun shines from: 0 = north, 90 = east, 180 = south, 270 = west (225 = south-west, so shadows fall to the north-east). Lights the walls and casts the shadows
sun_elevation   = 40.0      # degrees the sun stands above the horizon (5-89): a shadow is a building's height / tan(this) long -- 45 = as long as the building is tall, lower = longer
shadows         = true      # the buildings cast shadows on the ground (false = no shadows; they cost one more pass over the buildings in view)
shadow_strength = 0.3       # a shadow's opacity, 0-1: how much it darkens the ground under it (overlapping shadows don't darken further). The crowd and the units are never darkened
shadow_fade_zoom = 0.4      # zoom (pixels per world unit, as [camera] zoom_min) under which zooming out fades the shadows: their opacity falls in step with the zoom, from shadow_strength here to nothing at shadow_off_zoom. 0 = never
shadow_off_zoom  = 0.3     # zoom at and under which there are no shadows at all (the shadow pass -- one more draw of every building in view -- is skipped)
lod_px          = 1.0       # pixels: a building's walls, and its shadow, are skipped while they would show smaller than this on screen -- zoomed out, a shed's wall or shadow is under a pixel while a tower's still shows (0 = always draw everything)
wall_height      = 3.0      # meters a safe-zone wall stands in the 3D view; a worn part of it sinks toward a quarter of that as the horde chews it (in the flat view walls stay flat bands)
plane_altitude  = 300.0     # meters up the airstrike planes and the paratrooper transport fly in the 3D view, over the tallest typical roofs (a parachute comes down from here); their shadow stays on the ground under them. Held under 60% of the camera's own height so a close-in camera never flies into them
heli_altitude   = 180.0     # meters up the helicopter hovers in the 3D view (same rules as plane_altitude); its kill circle stays on the ground
overlay_hidden_alpha = 0.3  # opacity, 0-1, of the part of a ground ring or tool preview (range rings, blast rings, aim cones' outlines) a building stands in front of in the 3D view: the rings lie on the ground, so a building hides them, and this much of them still shows through (0 = hidden)
water_depth     = 2.5       # meters the water lies below the land in the 3D view: each shore facing the camera shows a bank (colors.water_bank) from the ground down to the water (0 = level water, no banks)
# The machines drawn from images stand up too: each image is laid on top of sides that follow
# the outline of the machine in it, shaded by which way they face the sun like the buildings'
# walls (an aircraft's shadow stays its flat outline). 0 = drawn flat.
apc_height        = 3.0     # meters the APC stands (taller in step while it is drawn bigger zoomed out, so it never shows under 20 px long); a building in front hides it
tank_height       = 2.5     # meters the tank's hull stands; its turret image lies on top of it
battleship_height = 5.0     # meters the battleship stands up out of the water (which lies water_depth under the land); a building in front hides it
heli_thickness    = 6.0     # meters thick the helicopter's body is: its sides hang under its image, which stays at heli_altitude, its rotor turning on top
plane_thickness   = 6.0     # meters thick the airstrike plane and the paratrooper transport are: their sides hang under their image, which stays at plane_altitude

[crt]
# CRT post-process (adapted from Timothy Lottes' shader). The whole frame is drawn
# to an offscreen texture, then redrawn across the window with an RGB shadow-mask
# and slight curvature (darkened corners) -- at full sharpness, no scanlines. Editing
# `enabled` here turns the effect on/off live, and the admin console can also toggle
# it (Ctrl+Space, "toggle crt") without the file snapping it back. The rest hot-reload
# while it is on.
enabled        = false # off by default: a new player starts without the effect (their settings.ini choice wins once they toggle it)
warp           = 0.0   # screen curvature (0 = flat); applied ~1.3x stronger vertically
mask_dark      = 0.5     # shadow-mask darkest subpixel (0..1)
mask_light     = 1.5     # shadow-mask brightest subpixel (>= 1)
mask_size      = 1.0     # output pixels per shadow-mask cell (>= 1; larger = coarser mask)
brightness     = 1.2     # brightness boost to offset the mask/scanline dimming
flip_y         = true    # flip vertically if the picture comes out upside-down on your GPU

[low_fps_prompt]
# The one-time prompt on a slow frame rate (lowfps.odin): in planning or a battle, a frame rate
# held low asks whether to switch the Graphics quality to LOW, and says it can be changed any
# time on the settings screen's DISPLAY tab. Asked once ever, whatever the answer; never while
# LOW is already picked. Hot-reloads.
fps     = 25.0    # the frame rate (frames a second) a window's average must fall under to ask
seconds = 60.0    # the window's length, real seconds: its frames are averaged, then it starts again (at least 1)

[autosave]
# The planning board is saved on its own (autosave.odin) a while after it changes, the same way
# leaving to the menu saves it, so a crash or a killed game loses at most that much planning.
# Nothing is written while the board stands still. Hot-reloads.
planning_seconds = 30.0  # real seconds after a change to the board before it is saved (0 = off: saved only on leaving, READY or closing the window)

[graphics_low]
# The settings screen's Graphics quality: LOW (DISPLAY tab; graphics.odin) -- for a PC whose
# graphics can't hold the frame rate. Like a Colour vision palette, every line here is a whole
# config key, laid over config.ini (and balance.ini) while the player has picked Low; High
# reads config.ini as it is. Each value is its own absolute, not a share of the key it
# replaces. Drawing only: the battle plays out the same at either quality. The CRT screen
# effect is its own switch on the same tab. Hot-reloads.
glow.enabled = false                     # no zombie glow: its offscreen light pass and halo cost the most of any effect on a big horde
view3d.shadows = false                   # no building shadows: saves one more pass over every building in view
view3d.lod_px = 3.0                      # a building's walls are skipped while they would show under 3 px, so zoomed out far fewer walls are drawn
dots.round = false                       # every person is a square dot (the cheapest)
projectiles.bullet_glow_alpha = 0        # no glow round the rounds in flight
projectiles.shell_trail_glow_alpha = 0   # no glow round a shell's trail
particles.fire_max_flames = 1500         # at most this many flames drawn at once
particles.fire_max_smoke = 750           # at most this many puffs of smoke drawn at once
particles.fire_smoke_max_cover = 1.5     # at most this many layers of smoke over the ground in view, on average
particles.gas_max_particles = 1000       # at most this many stun-gas wisps drawn at once
collapse.smoke_max = 500                 # at most this many puffs of a levelled building's dust at once
kill_marks.max_marks = 32                # at most this many kill markers at once
kill_marks.max_per_tick = 8              # at most this many markers from one tick's kills

[sandbox]
# Sandbox Mode (FREE PLAY's SANDBOX MODE switch on the globe; src/sandbox.odin): every unit
# unlocked, unlimited money and battle stock, a SANDBOX panel on the HUD. No mod may set this.
unit_cap = 500000                        # the panel's SPAWN tool stops adding zombies / civilians once this many units are alive

[globe]
# The CAMPAIGN GLOBE (the home screen, src/globe.odin): the Earth drawn as white lines on a
# dark sphere between the campaign list and the selected campaign's panel, with a pin on every
# campaign that has a real place. Its
# borders come from maps/world.globe (tools/globebake). Colours are R G B A, 0..255. All
# hot-reload.
dive_seconds       = 2.4               # seconds: PLAY's dive from the globe down to the mission (the map loads meanwhile)
country_borders    = false             # draw the land borders between countries (and the disputed areas' dashed edges); the coasts are always drawn
reveal_seconds     = 0.7               # seconds: the planning view fading in out of the dive (0 = a cut)
select_seconds     = 0.8               # seconds: the globe turning to a campaign picked in the list (0 = a cut)
level_seconds      = 0.6               # seconds: the change between the HOME level (CAMPAIGN / FREE PLAY) and the LIST level -- the globe moving and scaling, the panels sliding in (0 = a cut)
spin_friction      = 2.5               # 1/second: how fast a globe flung by a drag slows once let go; its turn's speed falls by e^-friction each second (2.5 = to about 8% in a second; higher stops sooner; at least 0.1)
# With the DLC 5488850 owned, a left click on the globe (off the pins) sets off a small nuke
# there: the [mushroom] cloud, shaped by its keys, standing off the Earth (src/globenuke.odin).
nuke_height_km     = 500.0             # km tall a nuke's cloud stands on the Earth (the whole [mushroom] shape is scaled to it)...
nuke_min_px        = 40.0              # ...but never under this many pixels tall on screen, zoomed far out
nuke_max_px        = 260.0             # ...nor over this many, zoomed close in
nuke_sound_volume  = 0.8               # the click's explosion: the nuke's own takes (audio vol_explosion_nuke's sound), at this volume (a multiplier on the file as recorded)...
nuke_sound_hz      = 350.0             # ...through a low-pass at this many Hz, so it is heard from far off (lower = duller; 20 - 20000)
# With the same DLC, a satellite orbits the globe for every campaign beaten (every scenario
# won), trailing a line that fades out behind it ([art] satellite_sprite; a plain dot without).
satellite_low_km   = 800.0             # km over the Earth the lowest satellite orbit runs
satellite_high_km  = 3000.0            # km over the Earth the highest runs (each satellite's height is somewhere between, fixed per satellite)
satellite_orbit_seconds = 40.0         # seconds a satellite takes to go round the Earth (each a little faster or slower)
satellite_trail_seconds = 6.0          # seconds of its path a satellite's trail reaches back over, fading to nothing (0 = no trail)
satellite_dot_px   = 4.0               # pixels across a satellite's plain dot (drawn while [art] satellite_sprite is blank)
satellite          = 255 255 255 255   # a satellite's plain dot
satellite_trail    = 255 255 255 140   # a satellite's trail where it leaves the satellite (it fades to clear behind)
# Which of the game's own campaigns (CAMPAIGN tab, in campaigns/order.txt's order) can be
# started (src/campaignlock.odin): the first campaigns_open_start are open; beating the first
# opens campaigns_open_first_win more, each one beaten after that campaigns_open_per_win more.
# A campaign beaten or started is always open; player-made maps never lock.
campaigns_open_start     = 2           # campaigns open before any is beaten (at least 1)
campaigns_open_first_win = 2           # more the first campaign beaten opens (2: three unbeaten to pick from)
campaigns_open_per_win   = 1           # more each later campaign beaten opens (1: keeps three unbeaten open)
lock_px            = 20.0              # UI pixels across a locked campaign's lock icon ([art] lock_sprite)
# A campaign's SIZE (the campaign list's second line and its panel's SIZE: line) is read from
# the land inside its last stage (the .cmp's land_km2): under size_medium_km2 SMALL, then
# MEDIUM, LARGE from size_large_km2, EXTRA LARGE from size_extra_large_km2. A campaign whose
# land was never measured shows no size.
size_medium_km2      = 75              # km^2 of last-stage land: MEDIUM from here (Chicago 27 and Seattle 66 are SMALL)
size_large_km2       = 120             # km^2: LARGE from here (Miami, Venice, Boston, Capitol Hill are MEDIUM; San Francisco 123 LARGE)
size_extra_large_km2 = 200             # km^2: EXTRA LARGE from here (New York 159 is LARGE; Detroit 227 and Paris 271 EXTRA LARGE)
background         = 3 5 8 255         # the screen behind the globe
ocean              = 6 20 40 255       # the sphere under the borders: the sea
land               = 30 38 40 255      # the land: every country filled over the sea (the inland lines mix into it)
grid               = 140 190 215 60    # the latitude / longitude grid (lines draw opaque: the alpha mixes them into the ocean colour)
border             = 235 245 255 204   # country borders and coasts
state_border       = 235 245 255 82    # state / province borders, faded in as the camera comes down
disputed_border    = 235 245 255 166   # a disputed area's edges, drawn dashed (Natural Earth's breakaway / disputed areas)
pin_new            = 242 247 255 255   # a mission pin never played and still locked (src/campaignlock.odin)
pin_open           = 255 215 0 255     # a mission pin never played and open to start (gold)
pin_progress       = 255 176 0 255     # a mission pin started but not finished
pin_done           = 70 170 255 255    # a mission pin with every scenario won

[colors]
civilian   = 255 255 255
civilian_planning = 208 208 208  # civilian dot during the planning phase: a dimmer white so the standing crowd is a quiet backdrop while you set up (only the R G B are used)
zombie     = 80 200 80          # zombie dot while the zombie glow is off (glow.dot_color while it is on)
explosive_zombie = 175 80 255    # an explosive zombie's dot ([explosive_zombie]), glow on or off
explosive_zombie_glow = 150 50 255 # the soft glow round it (its opacity is explosive_zombie.glow_alpha)
shielded_zombie = 255 210 0  # a shielded zombie's dot ([shielded_zombie]): yellow
giant_zombie = 60 190 60         # a giant zombie's disc under its dot ([giant_zombie])
swimmer_zombie = 255 105 180     # a swimmer zombie's dot ([swimmer_zombie]): hot pink
mosh_pit = 255 40 40              # a mosh pit's marker ring and countdown arc, and its toast ([mosh_pit])
cure     = 0 110 20               # a cured zombie's dot the moment it is cured (dark green) ([cure])
cure_dead = 0 0 0                 # ... darkening to this as it nears death ([cure] duration): black
cure_gas = 70 140 255             # The Cure's gas cloud (the stun gas's wisps and haze in blue), its tool and aim ring ([cure])
nuke     = 255 90 40              # the nuke's tool and aim ring, and its target ring while it counts down ([nuke])
nuke_wave = 255 240 210 204       # the nuke's shockwave ring as it rolls out ([nuke])
demolition = 255 200 60           # the Controlled Demolition's tool, and the landing strip it is aimed with ([demolition])
demolition_target = 255 120 40    # a building it can fell, while its tool is armed: the rest stay the plain building colour ([demolition])
seek_destroy = 150 200 255        # the Seek & Destroy's tool, and the outline of the garrisoned building under the cursor ([seek_destroy])
seek_destroy_target = 70 150 255  # a garrisoned building it can turn out, while its tool is armed: the rest (snipers' and mortars' too) stay the plain building colour ([seek_destroy])
officer    = 80 120 255
corpse     = 120 120 120
sniper     = 158 79 219          # sniper cone fill + outline, its placement preview (purple)
mortar     = 232 62 168          # mortar range ring + its placement preview (magenta -- stands out from the tan buildings)
mortar_shell = 150 150 150       # the lobbed shell in flight (gray; art supplied later)
shell_trail_head = 255 255 255   # a shell's trail right behind the shell: plain white ([projectiles] shell_trail_*)
shell_trail_tail = 255 255 255   # ... blending to this toward its fading tail (the same white: no tint)
garrison   = 40 200 200          # garrison range circle (teal -- reads apart from police blue and sniper purple)
garrison_roof = 38 112 110       # a garrisoned building's footprint (a dark teal; the building is the unit, no dot)
garrison_roof_stacked = 46 150 145 # a building whose garrison is stacked to level 2 or more (a brighter teal)
out_of_ammo_text = 240 60 60      # the "Out of ammo" label that rises off a gun as it runs dry and fades away ([overlays] out_of_ammo_text_*)
out_of_ammo_dim = 0.3            # 0..1 brightness a gun's building keeps -- or a Turret's colour -- once it has run out of ammo (garrison.max_reloads): 0.3 = dimmed to under a third. 1 = no dimming
sniper_roof = 112 61 158         # a building a sniper holds -- the building is the sniper, no dot is drawn (a deep purple)
mortar_roof = 158 51 117         # a building a mortar holds -- likewise (a deep magenta)
gas_mortar = 170 220 100         # the gas mortar's tool, range ring and placement preview (a yellow-green, like the gas)
gas_mortar_roof = 120 150 50     # a building a gas mortar holds (a deep olive)
fire_mortar = 190 140 30         # the fire mortar's tool, range ring and placement preview (an ochre, apart from the mortar's magenta under every colour vision palette)
fire_mortar_roof = 180 30 10     # a building a fire mortar holds (a deep red)
howitzer = 141 161 255           # the howitzer's tool, range ring and placement preview (a periwinkle)
howitzer_roof = 52 156 183        # a building a howitzer holds (a steel blue)
mlrs = 245 163 191               # the MLRS's tool, range ring and placement preview (a pink)
mlrs_roof = 152 211 43            # a building an MLRS holds (a lime)
railgun = 248 219 160            # a railgun's dot, tool and range ring (a pale peach)
railgun_beam = 255 115 25        # a railgun round's hot glow, round its core (a hot orange; drawing only)
railgun_beam_core = 255 250 225  # a railgun round's white-hot core (drawing only)
turret_roof = 235 80 80          # a building a Turret holds (coral red, the Turret's own)
railgun_roof = 248 219 160       # a building a railgun holds (a pale peach)
kill_heat  = 255 30 30           # the battle STATS panel's kills-per-unit meter: hovering a row tints that type's units (a held building, an officer or Turret dot, a battleship) from their own colour (no kills) up to this (the most kills of that type)
kill_mark  = 90 170 255          # a selected gun's kill markers ([kill_marks]): bright blue, lighter than the walls
recent_kills = 120 200 255       # the STATS panel's kills meter: the bright piece at a one-time deployment's bar end and its +N, for the kills it just made ([kills_meter]); a sky blue, not the SP yellow
turret     = 235 80 80           # machine-gun nest dot + its range fill (coral red -- reads apart from every other unit)
mine       = 250 194 51          # proximity mine dot + its blast-radius fill (amber -- reads apart from the coral nest)
c4         = 255 115 13          # C4 charge dot + its blast-radius fill (deep orange -- between the mine's amber and the nest's coral)
chemical_mine = 155 232 65       # chemical mine dot + its cloud-radius fill (a yellow-green, like the gas)
spike_strip = 179 191 209         # spike strip section dot + the ground it slows (steel grey)
oil_slick  = 158 107 56           # oil slick puddle dot + its puddle (oily brown)
napalm_drum = 230 51 51           # napalm drum dot + its fire-radius fill (red)
background = 33 33 41            # matches street/ground so off-map area isn't a darker band
street     = 33 33 41            # road/ground under the grid
block      = 51 51 56            # block footprint between buildings
bridge     = 209 171 89          # bridge roads in the map builder, so bridges stand out from plain gray streets
building   = 150 140 120         # every plain building, whatever its roof, use or type, outside the CLASSES / HEIGHT views (a garrisoned one: garrison_roof)
# A special building of each [building_class] category, shown only while the CLASSES view is
# held (J, or the command bar's CLASSES button), every plain building dimmed to
# class_view_other; otherwise every building is drawn in `building` above.
class_fuel   = 207 81 61          # FUEL: gas stations, propane, oil & gas, chemical plants, fireworks (red)
class_armory = 216 145 214        # ARMORY: gun, hunting and army-surplus stores, ranges, military sites (orchid)
class_civic  = 71 118 194         # CIVIC: police and fire stations, courts, prisons, town halls, libraries, radio / TV (blue)
class_rescue = 92 236 194         # RESCUE: hospitals, clinics, airports (mint)
class_trade  = 230 202 76         # TRADE: banks, hotels, malls, superstores, hardware and building supply, storage (yellow)
class_view_other = 109 103 92     # a plain building while the CLASSES view is held: a dimmed tan, so the special ones stand out (set it to colors.building's value for no dimming)
class_view_unit_dim = 0.75        # 0..1 brightness its unit's tint (garrison_roof, sniper_roof, mortar_roof ...) keeps on a plain building a unit holds while the CLASSES view is held, so it doesn't vie with the special buildings. 1 = no dimming. A special building a unit holds shows its class colour
# The HEIGHT view (V, the HEIGHT button, or the sniper / mortar tool armed): a heat map of
# the buildings' heights on a log scale from height_ramp_floor to the map's tallest building,
# so a 10 m and a 30 m building differ as plainly as a 100 m and a 300 m tower. It runs from the plain building colour (the
# lowest) to blue (the tallest); the five stops are spread evenly along it, each blended into
# the next; keep neighbouring stops apart in lightness or saturation so the order still
# reads under colour blindness. The heights in brackets are where each stop falls on a map
# whose tallest building is 472 m (New York).
height_ramp_1  = 150 140 120      # the lowest buildings, height_ramp_floor and under (the plain building tan, the same value as colors.building)
height_ramp_2  = 128 134 148      # a greyish blue (about 11 m)
height_ramp_3  = 62 134 216       # sky blue (about 38 m)
height_ramp_4  = 40 68 202        # royal blue (about 130 m)
height_ramp_5  = 12 22 112        # the map's tallest building (navy)
height_ramp_floor = 3.0           # meters: where the log scale starts, about a storey; a building this tall or less is height_ramp_1
height_unknown = 72 72 78         # a building the map has no height for (dark grey)
water      = 41 87 133           # the map builder's flat water preview; the game's water is drawn by [water]
water_bank = 92 89 80            # the bank between the land and the water in the 3D view ([view3d] water_depth), shaded by which way it faces the sun like the buildings' walls
green_grass = 71 102 56          # parks, gardens, grass, meadows, pitches, cemeteries -- aesthetic ground fill from OpenStreetMap land use (no gameplay effect; units walk over it)
green_forest = 46 74 41          # woodland / forest (natural=wood, landuse=forest) -- a darker green than grass, same aesthetic-only fill
burnt_ground = 84 84 82          # greenspace that has burned this battle ([fire]): drawn over the green where the fire took it, so a park that burned reads as one that can't burn again; a RETRY grows it back
dried_water = 64 56 46           # the bed of a pond or lake a nuke's shockwave dried up ([nuke]): drawn over its water; a RETRY fills it again
dead_ground = 100 93 80          # dead ground: open-looking ground the sim treats as solid -- a gap between buildings too thin to hold a walkable 2 m cell (no unit passes, no wall can be laid). Sealed courtyards are NOT tinted (they stay street-colored). Drawn over the streets and walls and under the buildings so only that ground shows it; an R G B A alpha below 255 lets the street show through
tracer     = 255 242 153         # gunshot tracer line
muzzle_flash = 255 244 200       # the core of a gun's muzzle flash (it fades out to its edge)
selection  = 100 255 130         # selection box, selected-unit rings, order markers
cooldown_shade = 0 0 0 102  # a battle ability tile's clock-sweep shade while it counts down to its unlock, drawn over the whole tile, name included (only the countdown sits on top): it covers the share of the wait still to run and opens clockwise from 12 o'clock like a clock hand (R G B A; 102 = 40% opacity)
wall       = 70 170 235          # a level-1 wall (blue, to match the safe zones' glow); a fortified one shades toward wall_full, and it fades see-through where it is worn
wall_full      = 30 90 170       # a wall at the top fortify level, walls.max_level (a deeper blue than level 1's colors.wall)
wall_weak_glow = 255 40 40        # the pulsing glow over a worn-down stretch of wall (walls.weak_glow_*; its opacity comes from there)
wall_breach_marker = 255 20 20    # the ring round each of a safe zone's first breaches in a battle (walls.breach_marker_*)
unpicked_glow = 255 236 140       # the pulsing halo round a special building inside the safe zones with no ability picked yet (building_class.unpicked_glow_*; its opacity comes from there)
gate       = 255 200 60          # a gate's stretch of a wall ([gate]); it fades see-through where it is worn, like the wall (amber: the walls and the zones' glow are blue)
heli       = 217 191 90          # helicopter body + rotor
apc        = 150 190 220         # armored personnel carrier: its tool and its range ring (steel blue), and its marker when art.apc_sprite's image is missing
rally      = 255 150 200         # Rally: its tool, its aim ring and the ring on the ground while a rally lasts (pink)
bus        = 245 200 70          # Security Bus: its tool, the tint on its image (the APC's, art.apc_sprite, until it has its own) and its marker when that image is missing (school-bus yellow)
medevac    = 240 240 240         # medevac chopper: its tool, its pickup ring and the tint on its image (the helicopter's until it has its own)
bulldozer  = 237 153 38          # bulldozer: its tool, its route line and the tint on its image (the APC's until it has its own) (construction orange)
tank       = 115 140 77          # tank: its tool, its range ring, and the tint on the APC's image it is drawn with if art.tank_sprite is missing (olive drab)
battleship = 190 200 214         # battleship: its tool and its range ring (battleship gray), and the plain hull-sized rectangle it is drawn as while art.battleship_sprite has no image
bomber     = 230 235 247         # bomber plane body (Stage 11)
fire       = 255 120 30          # fire-bomb patches: ground glow, the F tool
flame_hot  = 255 220 76          # a flame as it catches (yellow); it turns flame_cool as it dies away ([particles] fire_flame_*)
flame_cool = 220 40 16           # a flame as it dies away (red)
smoke_light = 78 76 73           # a puff of the fire's smoke at birth (grey); it darkens to smoke_dark as it drifts off ([particles] fire_smoke_*)
smoke_dark = 10 10 9             # a puff of the fire's smoke as it dies away (near black)
gas        = 175 225 95          # stun-gas clouds: wisps, haze, the G tool
missile    = 255 225 70          # the cruise missile: its tool, its aim ring and the ring on the spot it will hit
ac130      = 255 255 255         # the AC-130 gunship: multiplies its image (art.ac130_sprite); 255 255 255 = the image as drawn
ac130_missile = 255 200 115      # the hot head of an AC-130 missile in flight (drawing only; its smoke trail is white)
collapse_smoke = 178 172 160 204 # the dust a collapsing building throws up ([collapse]); the alpha is a puff's opacity where it is thickest (its middle, early on)
mushroom_flash = 255 252 235 245 # a mushroom cloud's puff the moment it goes off, white-hot ([mushroom]); the alpha is its opacity then
mushroom_bloom = 255 224 153 255 # the light a hot mushroom cloud puff gives off, added over the cloud ([mushroom] bloom_strength); the alpha is its strongest
mushroom_hot   = 255 196 70 235  # a mushroom cloud's puff once its flash has passed: bright orange-yellow, glowing ([mushroom]); the alpha is its opacity then
mushroom_ember = 92 38 24 230    # a mushroom cloud's puff halfway cooled: brown-red embers on the way from hot to its smoke ([mushroom])
mushroom_smoke = 72 52 44 235   # a mushroom cloud's puff once cooled: dark charcoal-brown smoke (its clumps run from this to mushroom_smoke_dark); the alpha is its opacity then
mushroom_smoke_dark = 34 26 23 240 # the darkest a mushroom cloud's cooled smoke goes
mushroom_dust  = 92 90 87 235   # a mushroom cloud's ground dust ring once cooled: dark grey (its clumps run from this to mushroom_dust_dark)
mushroom_dust_dark = 58 57 55 240 # the darkest the ground dust ring's clumps go
rubble     = 14 14 16 255        # the ground a collapsed building leaves: rubble, which slows everyone walking on it (building.rubble_speed_percent); a flat dark grey fill, darker than the street; the alpha its opacity
evac       = 230 195 90          # evac zone fill/outline/arrow (gold, Stage 12)
safe_zone_stripe = 40 170 230 56 # a safe zone's tint ([safe_zone] stripe_*) (R G B A)
safe_zone_glow = 64 210 255      # the glowing outline along every safe zone's edges ([safe_zone] glow_*: its widths and opacities)
safe_zone_breached = 235 56 46 52 # a safe-zone region's tint and edge glow once a wall around it is breached, until the next planning phase (R G B A; the glow takes only the R G B)
safe_zone_edge = 90 220 255      # the safe-zone lasso's lines while it is drawn
flag       = 220 55 50           # broken-wall marker flag: the pole + ring drawn when art.flag_sprite is missing
tip_glow   = 70 160 255          # the restart tip's SHOW glow: the pulsing blue ring and halo on the spot a tip is about

# Colour vision palettes -- the settings screen's ACCESSIBILITY tab picks one (or none:
# Colour vision OFF). Each block lists whole config keys of [colors] and [glow]; the picked
# block is applied after everything else, so its values win over the ones above and a key
# it leaves out keeps the colour above. All hot-reload. Every pair of colours the game
# tells apart by colour (the people, a lone zombie and a packed horde's glow, the
# placements and their ranges, the roofs of held buildings, the walls, a breached zone's
# stripes, fire and gas, the building classes) is far enough apart as that kind of
# colour blindness sees it -- `odin test src` (test_color_vision_palettes) simulates each
# and fails on a pair that falls short, so re-run it after editing a colour here or above.
# Red-green (protanopia, deuteranopia): the zombies glow amber to bright yellow instead of
# green, the walls turn steel blue (and a gate pink-red), a breach turns its zone's stripes magenta. Blue-yellow
# (tritanopia): the zombies glow red, so they no longer match the blue officers, and a
# worn wall's glow turns cyan, so it doesn't match them.
[color_vision_protanopia]
colors.turret_roof = 170 20 60          # a building a Turret holds: a deep crimson, apart from the fire mortar's and the garrison's here
# red-blind: reds look dark, and red, orange and green all read as shades of yellow
colors.rally = 235 190 255          # the rally ring: lavender, apart from the teal garrison ring here
