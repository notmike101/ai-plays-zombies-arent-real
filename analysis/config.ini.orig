[audio]
# Sound effects (sfx.odin). Each sound is a folder in sounds/; every .wav in it is a take
# of that sound, and one is picked at random each time it plays. All hot-reload. The
# Master and SFX sliders in the settings screen scale everything below on top.
#
# In-world sounds are heard from the camera: louder near the middle of the screen,
# quieter and more muffled the farther away they are and the more you zoom out (zooming
# out lifts the camera above the map). Each fades from full volume at
# full_volume_distance to silence at its range_* key; the distance counts the camera's
# height as well as the distance across the map, so a sound right under the camera still
# fades as you zoom out.
#
# vol_* keys: each multiplies that sound's file as recorded (1 = as recorded, 0.5 = half,
# 0 = off). They were set from a loudness measurement of every file, so the mix runs,
# loudest first: explosions and the win / lose / READY stingers; a wall breaking; the
# sniper and the gatling; the helicopter, planes, falling bombs and canopies; gunfire,
# placing, wall pounding; the quieter UI clicks; the crowd beds underneath it all.
listener_height        = 0.8    # how strongly zooming out pushes every in-world sound away: the camera's height above the map as a multiple of the world distance from the screen center to its top edge (0 = zoom ignored, only the distance across the map counts)
full_volume_distance   = 150.0  # meters: a sound this close to the camera (across the map and up to the camera, together) plays at its full volume, unmuffled
falloff_exp            = 2.0    # shape of the fade from full_volume_distance to a sound's range: 1 = a straight line, 2 = drops quickly at first then trails off
muffle_distance        = 1400.0 # meters: how far away a sound is fully muffled (only its low rumble left); muffling starts at full_volume_distance
muffle_hz              = 700.0  # the muffle's strength: the highest pitch a fully muffled sound keeps, in Hz (lower = duller)
range_gunfire          = 1800.0 # meters of distance at which gunfire (police, garrison, Turret, the APC's guns) goes silent
range_sniper           = 2300.0 # meters at which a sniper's shot goes silent (a big rifle: heard across the whole screen at a mid zoom)
range_aircraft         = 2300.0 # meters at which the helicopter (rotor + gatling), a falling bomb's whistle and the paratroopers' canopies go silent
range_plane            = 4000.0 # meters at which a strike / transport plane's engine goes silent (a plane is heard coming from far off)
range_explosion        = 9000.0 # meters at which an explosion (airstrike, C4, mine, mortar, fire bomb) goes silent: far enough that at camera zoom 0.3 a blast anywhere on screen is still a muffled bass thump (the camera alone is ~2600 m up there on a Retina screen), long after gunfire is gone
range_wall_pound       = 800.0  # meters at which zombies pounding on a wall go silent
range_wall_breach      = 1600.0 # meters at which a wall breaking goes silent
range_crowd            = 1600.0 # how far you can zoom out before the crowd beds go silent: the camera height in meters (listener_height x the distance from the screen center to its top edge)
range_reload           = 900.0  # meters at which a garrison, Turret or APC gun reloading goes silent (a small sound, heard only up close)
range_mutation         = 2300.0 # meters at which a mosh pit starting (the mutation growl) goes silent. The nuke's blast uses range_explosion / floor_explosion
# floor_* keys: the least a sound fades to while it is on screen, however far you zoom out
# (0.04 = 4% of its vol_* volume; 0 = it fades to silence at its range_* key, as before).
# The floor holds across the whole screen and fades out just past its edge, so a sound
# far off screen stays silent; a floored sound is still muffled. Zoomed all the way out,
# the battle stays a faint, muffled mix -- loudest first: explosions, a wall breaking, the
# sniper and planes, aircraft and the crowd, gunfire, pounding.
floor_gunfire          = 0.04   # gunfire (police, garrison, Turret, the APC's guns)
floor_sniper           = 0.06   # a sniper's shot
floor_aircraft         = 0.05   # the helicopter (rotor + gatling), a falling bomb's whistle, the paratroopers' canopies
floor_plane            = 0.06   # a strike / transport plane's engine
floor_explosion        = 0.15   # an explosion (airstrike, C4, mine, mortar, fire bomb)
floor_wall_pound       = 0.02   # zombies pounding on a wall
floor_wall_breach      = 0.08   # a wall breaking
floor_crowd            = 0.05   # the crowd beds (still scaled by how many civilians / zombies are on screen)
floor_reload           = 0.0    # a gun reloading (a small sound: heard only up close)
floor_mutation         = 0.06   # a mosh pit starting
gunfire_interval       = 0.09   # seconds: the fastest the gunfire sound repeats, however many guns are firing (a big firefight is a steady crackle)
wall_pound_interval    = 0.45   # seconds between two thuds while zombies pound on a wall
interval_jitter        = 0.4    # each gap between two plays of a repeating sound (gunfire, pounding, blasts) is that sound's interval +- this fraction, at random, so it never settles into a beat
pitch_variation        = 0.1    # every play of a one-shot (all but the READY / win / loss stingers) is pitched up or down by up to this fraction at random (0.1 = +-10%), so a repeated sound doesn't sound copied
volume_variation       = 0.15   # ...and made louder or quieter by up to this fraction at random (0.15 = +-15%)
crowd_human_full       = 400.0  # civilians on screen for the civilian murmur at its full volume (it rises with the count: a few people are faint)
crowd_panic_full       = 200.0  # panicked civilians on screen for the panicked crowd's screams at their full volume (the calm murmur counts only the calm ones)
zombie_a_full          = 40.0   # zombies on screen for zombie bed A (the separate groans) at its full volume
zombie_b_start         = 80.0   # zombies on screen before zombie bed B (the horde's roar) starts to fade in on top of A
zombie_b_full          = 1500.0 # zombies on screen for bed B at its full volume
zombie_fade_below      = 100.0  # zombies left in the whole battle (not just on screen) below which both zombie beds fade with the count, to silence at none left
vol_tool_armed         = 0.55   # arming a tool (a key or a command-bar button)
vol_tool_cancel        = 1.1    # canceling an armed tool (Esc / right-click), or dropping a half-drawn safe zone
vol_unit_place         = 1.1    # a placement in planning, a battle deployment called in, garrison moved, a loadout level bought
vol_unit_refund        = 2.1    # a refund: X, REFUND ALL, a safe zone deleted, a loadout level refunded (the takes are quiet as recorded)
vol_wall_placing       = 0.45   # each corner of a safe zone, and its walls going up when it closes (the takes are loud as recorded)
vol_game_start         = 0.7    # READY: the outbreak begins
vol_game_victory       = 1.0    # a scenario won
vol_game_loss          = 0.8    # a scenario lost
vol_soldier_shot       = 1.3    # a police officer or garrison firing
vol_machine_gun        = 1.3    # the machine guns -- a Turret's or the APC's: a loop while one fires (the loop is recorded quieter than the single shots: any lower and it is lost under the officers' and garrisons' gunfire)
vol_reload             = 0.6    # a garrison, Turret or APC gun emptying its magazine and reloading
vol_sniper_shot        = 0.8    # a sniper firing
vol_heli_gatling       = 0.35   # the helicopter's gatling (a loop while it fires; loud as recorded)
vol_heli_loop          = 0.9    # the helicopter's rotor
vol_plane_loop         = 1.25   # a strike plane's or paratrooper transport's engine (well above the crowd beds, or the flyover is lost under them)
vol_bomb_drop          = 1.6    # a bomb falling from a strike plane: an airstrike's, or the stun-gas canister
vol_bomb_drop_firebomb = 0.8    # one of a fire bomb's thirty small bombs falling
vol_explosion_bomb     = 1.6    # an airstrike bomb hitting, or a fuel building going up (the large explosion takes; the loudest thing in the game: past full scale, the bus limiter ducks the rest of the mix under it)
vol_explosion_c4       = 1.6    # a C4 charge going off (the large explosion takes)
vol_explosion_mine     = 2.2    # a mine going off (the small explosion takes: mostly low rumble, so they need this much to cut through gunfire on laptop speakers)
vol_explosion_mortar   = 2.2    # a mortar or battleship shell landing (the small explosion takes, as the mine; well above a firefight's gunfire)
vol_explosion_firebomb = 1.0    # a fire bomb landing and lighting its patch (thirty of them roll across the strip)
vol_wall_pound         = 0.4    # zombies pounding on a wall
vol_wall_breach        = 0.75   # a wall breaking (to the horde or a bomb)
vol_parachute          = 1.0    # a paratrooper's canopy opening (one take per jumper)
vol_crowd_human        = 1.0    # the civilians' murmur, at full volume
vol_crowd_panic        = 0.35   # the panicked civilians' screams, at full volume (loud as recorded)
vol_crowd_zombie_a     = 0.45   # zombie bed A (a few zombies), at full volume
vol_crowd_zombie_b     = 0.36   # zombie bed B (the horde), at full volume
vol_ability_unlock     = 0.8    # the unlock popup's sting (a unit, ability, upgrade or perk unlocked)
vol_city_intro         = 1.0    # the new-scenario camera intro's cinematic sound (played as it starts moving; faded out if the intro is skipped)
vol_worldmap_select    = 1.0    # a campaign picked on the globe (its pin, its list row, or Up / Down)
vol_worldmap_whoosh    = 0.8    # PLAY's dive from the globe down to the map
vol_explosion_nuke     = 1.4    # a nuke going off (its own takes: as loud as recorded as the large explosion's, and seven seconds long)
vol_zombie_mutation    = 1.5    # a mosh pit starting: zombies gathering to mutate (once per pit, at its centre)

# ======================================================================================
# ENGINE & DEVELOPER -- feature flags, threads and frame pacing, the performance test
# ======================================================================================

[features]
# Feature flags: on/off toggles for optional or experimental behavior. All hot-reload.
cinematic_full_map = false # false (default): cinematic mode (the admin console's "cinematic mode" command) keeps the play-area fade veil, so only the play area is visible. true: cinematic mode skips that veil, so the whole map outside the play area shows -- for recording a clean overview of the entire city.
dev = false # true: the developer keys work -- Shift+F6 starts a session log, F7 finishes it (logs/<git>-<campaign>-<scenario>.jsonl, see docs/session-log.md), F8 opens the CRT tuning panel, F9 / F10 the obstacle-grid / walkable overlays, Shift+F9 the hunt-field overlay, F11 the diagnostics readout -- and the HUD shows its FPS line and the F11 performance breakdown. false (the default; build.sh package forces it in a shipped copy, unless given --dev): those keys do nothing and no FPS / timing text is drawn, the settings screen has no FPS / diagnostics toggle, and the expanded diagnostics HUD never shows. Hot-reloads. Also read at launch: true opens the game in a window and false fullscreen (until the player picks on the settings screen's Fullscreen toggle), and on Windows a true run of a non-Steam build started with no terminal to print to (double-clicked) opens a console window; a false run, or any Steam build, never shows one.
fps_meter = false # true: with dev on, the HUD's top-left shows its slim gray FPS line (and the game speed while a battle runs). false: that line is hidden, dev keys and all else unchanged -- the F11 breakdown still shows its own timings. Does nothing with dev off (no FPS text is drawn then anyway). Hot-reloads.
battle_replay = false # true: the next battle (a RETRY, or the next campaign stage) re-fires every paratrooper drop, airstrike, fire bomb, stun gas, helicopter, Call to Arms and C4 DETONATE of the last battle at the moment it went off, each shown with a countdown you can click to cancel. false (the default): nothing is re-fired -- every battle starts with no countdowns and the whole battle stock on the buttons. Either way the battle's deployments are still remembered (and saved with the plan), so switching this back to true re-fires the most recent battle's. Read when READY starts a battle, so a change made mid-battle applies from the next one.

[performance]
# Threads and frame pacing. None changes how a battle plays out: the sim is tick-
# deterministic at any of these.
sim_speed_steps         = 8      # hard cap on simulation ticks per rendered frame. The sim steps in half-ticks: a frame normally runs the game speed's worth (1/2x = half a tick every other 60 fps frame, i.e. half real time; 1x = half a tick = real time; 4x = 2 ticks, at the 1/30 s tick) plus at most ONE catch-up half-tick, so a slow tick makes the sim run slightly slower than real time instead of stuttering; this cap bounds that further.
worker_threads          = 0      # sim threads for the movement/infection passes (0 = auto: the hardware threads less two (less one on a CPU with 4 or fewer), or with hyper-threading the cores plus half the extra threads less one -- 14 on a 10-core / 20-thread CPU; 1 = single-threaded). Applied at launch.
own_thread              = true   # in a battle, the frame's last half-ticks (1/2x / 1x: its one half; 2x / 4x: its last tick) run on the sim's own thread while the frame is sent to the GPU and waits on the display, so they no longer add to the frame's time when they are shorter than that. The frame draws the state the previous frame's sim left. false = the sim runs before the frame is drawn, all of it, as before -- the A/B for F11's FPS. Hot-reloads.
frame_budget_ms         = 50.0   # the most milliseconds of sim one frame runs past its first tick: at 2x / 4x / 8x a frame starts a half-tick only while its sim would still fit this with it (with own_thread on, counting the half-ticks it leaves for the sim's thread). A frame only overlaps one tick with its drawing, so on a big stage, where a tick costs about as long as a frame takes to draw, the game's speed comes from the ticks a frame runs before it draws: a high cap favours game speed (the frame rate drops at 4x / 8x, to about 15-20 fps at this value), a low one the frame rate (12: 4x / 8x run no faster than about 2x once a tick costs over ~8 ms). 1/2x and 1x always run their own speed's worth (half a tick a frame at most). The battle is the same either way. 0 = no cap (sim_speed_steps alone). Hot-reloads.
raise_thread_priority   = true   # Windows only: the sim's worker threads, its own thread and the main (drawing) thread run at above-normal priority, so another program's threads wait for them instead of stalling a pass (a pass waits for its slowest worker) -- the main thread too, so the sim's own threads never starve the drawing. Applied at launch.

[perftest]
# The settings screen's PERFORMANCE TEST (perftest.odin): the New York City campaign's last
# scenario with a defense laid, the outbreak well under way and every battle deployable
# called in on a fixed schedule -- the same battle every run -- while the camera tours the
# whole stage, the city and a tilted street; then a summary of the frame rate (also written
# to logs/perftest-<date>-<time>.txt). The lengths hot-reload; the speed is set when a test starts.
warmup_seconds = 5.0     # simulated seconds it runs before measuring (the load's hitches are left out)
seconds        = 60.0    # simulated seconds it measures for; the camera spends a third of them on each view (at least 5)
speed          = 2       # the game speed it runs at: 1, 2, 4, 8 or 16, the buttons' 1/2x / 1x / 2x / 4x / 8x (16 = the dev-only 8x) (2 = real time, half a sim tick per frame)
